                        style="border-color: rgba(255, 59, 48, 0.3); color: var(--color-red); background: rgba(255, 59, 48, 0.1);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none"
