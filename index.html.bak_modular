                    { id: "ws-2", orderId: "#OT-000002", clientId: "cli-4", techDetails: "Mantenimiento preventivo general de chiller", spareParts: "Aceite POE, Limpiador serpentín", observations: "Próxima revisión en 6 meses", completedBy: "Carlos Gómez", date: "2026-06-29" }
                ];
                localStorage.setItem('electrofrio_worksheets', JSON.stringify(defaultWorksheets));
            }
            planillas = JSON.parse(localStorage.getItem('electrofrio_worksheets'));
        }

        // Ticking Clock
        function updateFichajeClock() {
            const now = getSyncedDate();
            if (fichajeClock) {
                fichajeClock.textContent = now.toLocaleTimeString('es-AR');
            }
            if (fichajeDate) {
                const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                fichajeDate.textContent = now.toLocaleDateString('es-AR', options);
            }
            // Actualizar cuenta regresiva de 5 minutos en el botón de fichaje del colaborador
            const btnUnico = document.getElementById('btnFicharUnico');
            if (btnUnico && btnUnico.dataset.cooldownTarget) {
                const targetTime = parseInt(btnUnico.dataset.cooldownTarget, 10);
                const diffMs = targetTime - now.getTime();
                if (diffMs > 0) {
                    const sec = Math.ceil(diffMs / 1000);
                    const m = Math.floor(sec / 60);
                    const s = sec % 60;
                    const timeStr = m > 0 ? `${m}m ${String(s).padStart(2, '0')}s` : `${s}s`;
                    const nextType = btnUnico.dataset.nextType || 'Fichar';
                    btnUnico.textContent = `Espera ${timeStr} para ${nextType}`;
                    btnUnico.disabled = true;
                } else {
                    delete btnUnico.dataset.cooldownTarget;
                    if (typeof updateDashboardStats === 'function') {
                        updateDashboardStats();
                    }
                }
            }
        }
        setInterval(updateFichajeClock, 1000);
        updateFichajeClock();

        // Cargar todo al iniciar (Offline-First Session)
        window.addEventListener('DOMContentLoaded', () => {
            initLocalStorage();
            
            // Si ya hay una sesión activa guardada, mostrar la app de inmediato
            if (localStorage.getItem('electrofrio_session') === 'true') {
                showApp();
                const lastModule = localStorage.getItem('electrofrio_active_module') || 'dashboard';
                switchTab(lastModule);
            } else {
                hideApp();
            }
        });

        // Observador de estado de autenticación de Firebase
        auth.onAuthStateChanged(async (user) => {
            if (user) {
                try {
                    const doc = await db.collection('usuarios').doc(user.uid).get();
                    if (doc.exists) {
                        const userData = doc.data();
                        localStorage.setItem('electrofrio_session', 'true');
                        localStorage.setItem('electrofrio_user', userData.username);
                        localStorage.setItem('electrofrio_role', userData.role);
                        localStorage.setItem('electrofrio_name', userData.name);
                        localStorage.setItem('electrofrio_uid', user.uid);
                        localStorage.setItem('electrofrio_premium', userData.premium ? 'true' : 'false');

                        showApp();
                        const lastModule = localStorage.getItem('electrofrio_active_module') || 'dashboard';
                        switchTab(lastModule);

                        if (userData.role === 'Administrador') {
                            setTimeout(() => {
                                if (typeof verificarAlertaBackupSemanal === 'function') {
                                    verificarAlertaBackupSemanal();
                                }
                            }, 2500);
                        }
                    }
                } catch (error) {
                    console.error("Error al obtener datos del usuario desde Firestore:", error);
                    // Si falla por red/cuota pero ya tenemos una sesión guardada localmente, mantenemos el acceso
                    if (localStorage.getItem('electrofrio_session') === 'true') {
                        showApp();
                    }
                }
            } else {
                localStorage.removeItem('electrofrio_session');
                localStorage.removeItem('electrofrio_active_module');
                localStorage.removeItem('electrofrio_user');
                localStorage.removeItem('electrofrio_role');
                localStorage.removeItem('electrofrio_name');
                localStorage.removeItem('electrofrio_uid');
                localStorage.removeItem('electrofrio_premium');
                hideApp();
            }
        });

        // Función para procesar el ingreso
        const executeLogin = async function (event) {
            if (event) event.preventDefault();

            // Cargar colaboradores frescos de localStorage
            colaboradores = JSON.parse(localStorage.getItem('electrofrio_collaborators')) || [];

            const usuarioIngresado = document.getElementById('username').value.trim().toLowerCase();
            const passwordIngresado = document.getElementById('password').value;

            if (!usuarioIngresado || !passwordIngresado) {
                mensaje.style.color = '#ff3b30';
                mensaje.textContent = 'Por favor, completa todos los campos.';
                return;
            }

            const email = formatEmail(usuarioIngresado);

            mensaje.style.color = '#8ab4f8';
            mensaje.textContent = 'Iniciando sesión...';

            try {
                // Intentar iniciar sesión con Firebase Auth
                const userCredential = await auth.signInWithEmailAndPassword(email, passwordIngresado);
                const user = userCredential.user;

                // Buscar datos en Firestore
                const doc = await db.collection('usuarios').doc(user.uid).get();
                if (doc.exists) {
                    const userData = doc.data();
                    localStorage.setItem('electrofrio_session', 'true');
                    localStorage.setItem('electrofrio_user', userData.username);
                    localStorage.setItem('electrofrio_role', userData.role);
                    localStorage.setItem('electrofrio_name', userData.name);
                    localStorage.setItem('electrofrio_uid', user.uid);
                    localStorage.setItem('electrofrio_premium', userData.premium ? 'true' : 'false');

                    mensaje.style.color = '#4cd964'; // Verde
                    mensaje.textContent = '¡Ingreso exitoso! Redirigiendo...';

                    setTimeout(() => {
                        showApp();
                        switchTab('dashboard');
                    }, 1000);
                } else {
                    // El usuario existe en Auth pero no tiene perfil en Firestore. Creamos uno por defecto.
                    const localMatch = colaboradores.find(c => c.username.toLowerCase() === usuarioIngresado);
                    const name = localMatch ? localMatch.name : usuarioIngresado;
                    const role = localMatch ? localMatch.role : 'Colaborador';
                    const hourlyRate = localMatch ? localMatch.hourlyRate : 0;
                    const schedule = localMatch ? localMatch.schedule : { in: "08:00", out: "17:00", tolerance: 10 };
                    const gps = localMatch ? localMatch.gps : { lat: "", lng: "", radius: 50 };

                    const newUserData = {
                        uid: user.uid,
                        name: name,
                        username: usuarioIngresado,
                        email: email,
                        role: role,
                        hourlyRate: hourlyRate,
                        schedule: schedule,
                        gps: gps,
                        status: 'offline'
                    };

                    await db.collection('usuarios').doc(user.uid).set(newUserData);

                    localStorage.setItem('electrofrio_session', 'true');
                    localStorage.setItem('electrofrio_user', newUserData.username);
                    localStorage.setItem('electrofrio_role', newUserData.role);
                    localStorage.setItem('electrofrio_name', newUserData.name);
                    localStorage.setItem('electrofrio_uid', user.uid);
                    localStorage.setItem('electrofrio_premium', newUserData.premium ? 'true' : 'false');

                    mensaje.style.color = '#4cd964';
                    mensaje.textContent = '¡Ingreso exitoso! Perfil creado.';

                    setTimeout(() => {
                        showApp();
                        switchTab('dashboard');
                    }, 1000);
                }
            } catch (authError) {
                console.warn("Auth error, checking local fallback credentials", authError);

                // Solo intentamos crear la cuenta si el usuario no existe en Firebase Auth y coincide con las locales por defecto (Bootstrap)
                const defaultMatch = colaboradores.find(c => c.username.toLowerCase() === usuarioIngresado && c.password === passwordIngresado);

                if ((authError.code === 'auth/user-not-found' || authError.code === 'auth/invalid-credential') && defaultMatch) {
                    mensaje.textContent = 'Inicializando cuenta en la nube...';
                    try {
                        const userCredential = await auth.createUserWithEmailAndPassword(email, passwordIngresado);
                        const user = userCredential.user;

                        const newUserData = {
                            uid: user.uid,
                            name: defaultMatch.name,
                            username: defaultMatch.username,
                            email: email,
                            role: defaultMatch.role,
                            hourlyRate: defaultMatch.hourlyRate,
                            schedule: defaultMatch.schedule,
                            gps: defaultMatch.gps,
                            status: 'online'
                        };

                        await db.collection('usuarios').doc(user.uid).set(newUserData);

                        localStorage.setItem('electrofrio_session', 'true');
                        localStorage.setItem('electrofrio_user', newUserData.username);
                        localStorage.setItem('electrofrio_role', newUserData.role);
                        localStorage.setItem('electrofrio_name', newUserData.name);
                        localStorage.setItem('electrofrio_uid', user.uid);
                        localStorage.setItem('electrofrio_premium', newUserData.premium ? 'true' : 'false');

                        mensaje.style.color = '#4cd964';
                        mensaje.textContent = '¡Cuenta inicializada e ingreso exitoso!';

                        setTimeout(() => {
                            showApp();
                            switchTab('dashboard');
                        }, 1000);
                    } catch (createError) {
                        console.error("Error al registrar usuario por defecto:", createError);
                        mensaje.style.color = '#ff3b30';
                        if (createError.code === 'auth/email-already-in-use') {
                            mensaje.textContent = 'Usuario o contraseña incorrectos.';
                        } else {
                            mensaje.textContent = 'Error al crear cuenta en la nube: ' + createError.message;
                        }
                    }
                } else {
                    mensaje.style.color = '#ff3b30';
                    if (authError.code === 'auth/wrong-password' || authError.code === 'auth/user-not-found' || authError.code === 'auth/invalid-credential') {
                        mensaje.textContent = 'Usuario o contraseña incorrectos.';
                    } else {
                        mensaje.textContent = 'Error al ingresar: ' + authError.message;
                    }
                }
            }
        };

        // Escuchar click en el botón de ingresar
        const btnLogin = document.getElementById('btnLogin');
        if (btnLogin) {
            btnLogin.addEventListener('click', executeLogin);
        }

        // Escuchar tecla Enter en campos de entrada de login
        const handleEnterKey = function (event) {
            if (event.key === 'Enter') {
                executeLogin(event);
            }
        };
        const usernameInput = document.getElementById('username');
        const passwordInput = document.getElementById('password');
        if (usernameInput) usernameInput.addEventListener('keydown', handleEnterKey);
        if (passwordInput) passwordInput.addEventListener('keydown', handleEnterKey);

        // Prevenir de forma absoluta el envío tradicional del formulario
        if (loginForm) {
            loginForm.addEventListener('submit', function (event) {
                event.preventDefault();
            });
        }

        // Evento de Logout (Cierre de Sesión)
        const logoutButtons = document.querySelectorAll('.logout-btn');
        logoutButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                auth.signOut().then(() => {
                    document.getElementById('username').value = '';
                    document.getElementById('password').value = '';
                    mensaje.textContent = '';
                }).catch(err => {
                    console.error("Error al cerrar sesión:", err);
                });
            });
        });

        // Configurar UI según Rol
        function configureRoleUI() {
            const role = localStorage.getItem('electrofrio_role') || 'Colaborador';
            const name = localStorage.getItem('electrofrio_name') || '';
            const isPremium = localStorage.getItem('electrofrio_premium') === 'true';

            // 1. Clases de Body para filtros CSS
            if (role === 'Administrador') {
                document.body.classList.remove('role-colaborador');
                document.body.classList.add('role-admin');
            } else {
                document.body.classList.remove('role-admin');
                document.body.classList.add('role-colaborador');
            }

            // 2. Control dinámico de la visibilidad y orden de los elementos del menú
            const sidebarNav = document.querySelector('.sidebar-nav');
            if (sidebarNav) {
                const itemDashboard = sidebarNav.querySelector('[data-module="dashboard"]');
                const itemOrdenes = sidebarNav.querySelector('[data-module="ordenes"]');
                const itemTareas = sidebarNav.querySelector('[data-module="tareas"]');
                const itemCalendario = sidebarNav.querySelector('[data-module="calendario"]');
                const itemMapa = sidebarNav.querySelector('[data-module="mapa"]');
                const itemFichajes = sidebarNav.querySelector('[data-module="fichajes"]');
                const itemJornales = sidebarNav.querySelector('[data-module="jornales"]');
                const itemDatabase = sidebarNav.querySelector('[data-module="database"]');
                const itemGroupDb = document.getElementById('btnGroupDatabase')?.closest('.nav-group');
                const itemGroupUtilidades = document.getElementById('btnGroupUtilidades')?.closest('.nav-group');
                const itemConfiguracion = sidebarNav.querySelector('[data-module="configuracion"]');

                const allItems = [
                    itemDashboard, itemOrdenes, itemTareas, itemCalendario, itemMapa,
                    itemFichajes, itemJornales, itemDatabase, itemGroupDb, itemGroupUtilidades, itemConfiguracion
                ];

                allItems.forEach(el => {
                    if (el) el.style.display = 'none';
                });

                let visibleAndOrdered = [];

                if (role === 'Administrador') {
                    visibleAndOrdered = [
                        itemDashboard,
                        itemOrdenes,
                          itemTareas,
                        itemCalendario,
                        itemMapa,
                        itemDatabase,
                        itemFichajes,
                        itemJornales,
                        itemGroupDb,
                        itemGroupUtilidades,
                        itemConfiguracion
                    ];
                } else if (isPremium) {
                    visibleAndOrdered = [
                        itemDashboard,
                        itemOrdenes,
                        itemTareas,
                        itemCalendario,
                        itemDatabase,
                        itemFichajes,
                        itemGroupUtilidades
                    ];
                } else {
                    visibleAndOrdered = [
                        itemDashboard,
                        itemOrdenes,
                        itemTareas,
                        itemCalendario,
                        itemDatabase,
                        itemFichajes
                    ];
                }

                visibleAndOrdered.forEach((el, index) => {
                    if (el) {
                        el.style.display = '';
                        el.style.order = index;
                    }
                });
            }

            // 3. Cabecera (Nombre e iniciales)
            const initials = name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
            document.getElementById('userAvatar').textContent = initials;
            document.getElementById('userDisplayName').textContent = name;
            document.getElementById('userDisplayRole').textContent = role + (isPremium && role === 'Colaborador' ? ' (Premium)' : '');

            // 4. Modificaciones en el título y subtítulo de colaboradores en el dashboard
            const displayNames = document.querySelectorAll('.collab-name-display');
            displayNames.forEach(d => {
                d.textContent = name.split(' ')[0]; // Muestra el primer nombre
            });

            // 5. Cargar tablas y paneles según rol
            updateTablesAndViews();

            // 6. Iniciar rastreo de ubicación si corresponde
            if (typeof window.startLocationTracking === 'function') {
                window.startLocationTracking(role);
            }
        }

        // Determinar si un colaborador está online en base al último fichaje de hoy
        function isCollabOnline(collabName) {
            const now = getSyncedDate();
            const yyyy = now.getFullYear();
            const mm = String(now.getMonth() + 1).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const todayISO = `${yyyy}-${mm}-${dd}`;
            const todayAR = `${dd}/${mm}/${yyyy}`;

            const myTodayFichajes = fichajes
                .filter(f => {
                    const isToday = f.date === todayISO || f.date === todayAR || f.date === 'Hoy';
                    const isNameMatch = f.name && f.name.trim().toLowerCase() === (collabName || '').trim().toLowerCase();
                    return isToday && isNameMatch;
                })
                .sort((a, b) => new Date(a.timestamp) - new Date(b.timestamp));
            if (myTodayFichajes.length === 0) return false;
            const latest = myTodayFichajes[myTodayFichajes.length - 1];
            return latest.type === 'Entrada';
        }

        // Actualizar vistas y renderizar tablas dinámicamente
        function updateTablesAndViews() {
            // Recargar datos locales antes de renderizar
            colaboradores = JSON.parse(localStorage.getItem('electrofrio_collaborators')) || [];
            fichajes = JSON.parse(localStorage.getItem('electrofrio_fichajes')) || [];
            ordenesTrabajo = JSON.parse(localStorage.getItem('electrofrio_workorders')) || [];
            clientes = JSON.parse(localStorage.getItem('electrofrio_clients')) || [];
            planillas = JSON.parse(localStorage.getItem('electrofrio_worksheets')) || [];
            tareas = JSON.parse(localStorage.getItem('electrofrio_tareas')) || [];

            // Vincular dinámicamente planillas con clientes por nombre
            linkPlanillasToClients();

            const role = localStorage.getItem('electrofrio_role');
            const currentUser = localStorage.getItem('electrofrio_user');
            const currentName = localStorage.getItem('electrofrio_name');
            const activeModule = localStorage.getItem('electrofrio_active_module') || 'dashboard';

            // Renderizar los nuevos componentes
            if (activeModule === 'tareas') {
                // Módulo Tareas en tareas.html
            }
            if (activeModule === 'clientes') {
                renderClientsTable();
            }

            // --- A. DASHBOARD ADMIN ---
            if (role === 'Administrador' && activeModule === 'dashboard') {
                // KPIs
                const activeOrders = ordenesTrabajo.filter(o => o.status && ['Pendiente', 'En Proceso', 'Presupuesto', 'Reprogramar'].includes(o.status)).length;
                const onlineCollabs = colaboradores.filter(c => isCollabOnline(c.name)).length;
                
                const now = getSyncedDate();
                const yyyy = now.getFullYear();
                const mm = String(now.getMonth() + 1).padStart(2, '0');
                const dd = String(now.getDate()).padStart(2, '0');
                const todayISO = `${yyyy}-${mm}-${dd}`;
                const todayAR = `${dd}/${mm}/${yyyy}`;

                const todaysFichajes = fichajes.filter(f => f.date === todayISO || f.date === todayAR || f.date === 'Hoy').length;

                document.getElementById('adminStatOrders').textContent = `${activeOrders} Activas`;
                document.getElementById('adminStatCollabs').textContent = `${onlineCollabs} Activos`;
                document.getElementById('adminStatFichajes').textContent = `${todaysFichajes} Registros`;

                // Calcular subtextos dinámicos verídicos
                // 1. Órdenes esta semana (últimos 7 días)
                const oneWeekAgo = new Date();
                oneWeekAgo.setDate(oneWeekAgo.getDate() - 7);
                const newOrdersThisWeek = ordenesTrabajo.filter(o => {
                    if (!o.date) return false;
                    let oDate;
                    if (o.date.includes('/')) {
                        const [d, m, y] = o.date.split('/');
                        oDate = new Date(`${y}-${m}-${d}`);
                    } else {
                        oDate = new Date(o.date);
                    }
                    return oDate >= oneWeekAgo;
                }).length;
                document.getElementById('adminStatOrdersSub').textContent = `+${newOrdersThisWeek} esta semana`;

                // 2. Colaboradores en servicio hoy (que registraron Entrada hoy)
                const uniqueCollabsToday = new Set(
                    fichajes
                        .filter(f => (f.date === todayISO || f.date === todayAR || f.date === 'Hoy') && f.type === 'Entrada')
                        .map(f => f.name || f.username)
                ).size;
                document.getElementById('adminStatCollabsSub').textContent = `${uniqueCollabsToday} en servicio hoy`;

                // 3. Fichajes de hoy: subtexto del último registro
                const todayFichajesList = fichajes.filter(f => f.date === todayISO || f.date === todayAR || f.date === 'Hoy');
                let subText = "Sin registros hoy";
                if (todayFichajesList.length > 0) {
                    const sortedToday = [...todayFichajesList].sort((a, b) => (b.time || '').localeCompare(a.time || ''));
                    subText = `Último a las ${sortedToday[0].time}HS`;
                }
                document.getElementById('adminStatFichajesSub').textContent = subText;

                // Tabla de órdenes del día + próximas (Admin Dashboard)
                const recentBody = document.getElementById('adminRecentOrdersBody');
                if (recentBody) {
                    recentBody.innerHTML = '';

                    // Helpers
                    const parseDateAdmin = (dStr) => {
                        if (!dStr) return 0;
                        let parts = dStr.split('/');
                        if (parts.length === 3) return new Date(parts[2], parts[1]-1, parts[0]).getTime();
                        parts = dStr.split('-');
                        if (parts.length === 3) return new Date(parts[0], parts[1]-1, parts[2]).getTime();
                        return new Date(dStr).getTime() || 0;
                    };
                    const parseTimeAdmin = (tStr) => {
                        if (!tStr || tStr === '') return 9999;
                        const match = tStr.match(/(\d{1,2}):(\d{2})/);
                        if (match) return parseInt(match[1]) * 60 + parseInt(match[2]);
                        return 9999;
                    };
                    const todayStartAdmin = new Date();
                    todayStartAdmin.setHours(0, 0, 0, 0);
                    const todayTsAdmin = todayStartAdmin.getTime();
                    const isTodayAdmin = (dStr) => {
                        const ts = parseDateAdmin(dStr);
                        if (!ts) return false;
                        const d = new Date(ts);
                        d.setHours(0, 0, 0, 0);
                        return d.getTime() === todayTsAdmin;
                    };

                    // Filtrar solo órdenes activas con fecha
                    const adminActiveOrders = ordenesTrabajo.filter(o => o.date && o.date !== "" && o.status !== 'Completado');
                    const adminCompletedOrders = ordenesTrabajo.filter(o => o.date && o.date !== "" && o.status === 'Completado');

                    const adminHoy = adminActiveOrders.filter(o => isTodayAdmin(o.date));
                    const adminOtros = adminActiveOrders.filter(o => !isTodayAdmin(o.date));

                    adminHoy.sort((a, b) => parseTimeAdmin(a.time) - parseTimeAdmin(b.time));
                    adminOtros.sort((a, b) => {
                        const dateDiff = parseDateAdmin(a.date) - parseDateAdmin(b.date);
                        if (dateDiff !== 0) return dateDiff;
                        return parseTimeAdmin(a.time) - parseTimeAdmin(b.time);
                    });

                    const sortedAdminOrders = [...adminHoy, ...adminOtros];
                    let adminInsertedHoy = false;
                    let adminInsertedOtros = false;
                    const countAdminHoy = adminHoy.length;

                    if (sortedAdminOrders.length === 0 && adminCompletedOrders.length === 0) {
                        recentBody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:var(--text-muted); padding:20px;">No hay órdenes activas.</td></tr>`;
                    } else {
                        sortedAdminOrders.forEach(o => {
                            const isTodayO = isTodayAdmin(o.date);

                            // Header "Hoy"
                            if (isTodayO && !adminInsertedHoy) {
                                adminInsertedHoy = true;
                                const headerTr = document.createElement('tr');
                                headerTr.innerHTML = `
                                    <td colspan="5" style="padding: 0; border: none;">
                                        <div style="display:flex; align-items:center; gap:10px; padding: 14px 12px 10px 12px;">
                                            <div style="display:flex; align-items:center; gap:8px;">
                                                <span style="font-size:18px;">📋</span>
                                                <span style="font-weight:700; font-size:15px; color:#00e676; text-transform:uppercase; letter-spacing:0.5px;">Hoy</span>
                                                <span style="background:rgba(0,230,118,0.15); color:#00e676; font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(0,230,118,0.3);">${countAdminHoy} ${countAdminHoy === 1 ? 'orden' : 'órdenes'}</span>
                                            </div>
                                            <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(0,230,118,0.4), transparent);"></div>
                                        </div>
                                    </td>
                                `;
                                recentBody.appendChild(headerTr);
                            }

                            // Header "Próximos días"
                            if (!isTodayO && !adminInsertedOtros) {
                                adminInsertedOtros = true;
                                const headerTr = document.createElement('tr');
                                headerTr.innerHTML = `
                                    <td colspan="5" style="padding: 0; border: none;">
                                        <div style="display:flex; align-items:center; gap:10px; padding: ${adminInsertedHoy ? '18px' : '14px'} 12px 10px 12px;">
                                            <div style="display:flex; align-items:center; gap:8px;">
                                                <span style="font-size:16px;">📅</span>
                                                <span style="font-weight:600; font-size:13px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px;">Próximos días</span>
                                            </div>
                                            <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(255,255,255,0.1), transparent);"></div>
                                        </div>
                                    </td>
                                `;
                                recentBody.appendChild(headerTr);
                            }

                            const tr = document.createElement('tr');
                            tr.style.cursor = 'pointer';
                            tr.onclick = () => openOrderDetailsModal(o.id);
                            if (isTodayO) {
                                tr.style.borderLeft = '3px solid #00e676';
                            }
                            const badgeData = getBadgeInfo(o.status);
                            const hoyBadgeAdmin = isTodayO ? ' <span style="background: linear-gradient(135deg, #00c853, #00e676); color: #000; font-weight: 700; font-size: 10px; padding: 2px 8px; border-radius: 10px; margin-left: 6px; letter-spacing: 0.5px; text-transform: uppercase;">Hoy</span>' : '';
                            const formattedDateAdmin = o.date ? (formatDateWithDayToAR(o.date) + hoyBadgeAdmin) : 'Sin fecha';

                            tr.innerHTML = `
                                <td data-label="ID">${o.id}</td>
                                <td data-label="Cliente">${o.client}</td>
                                <td data-label="Descripción del Trabajo">${o.type}</td>
                                <td data-label="Estado"><span class="badge ${badgeData.class}">${badgeData.text}</span></td>
                                <td data-label="Fecha">${formattedDateAdmin}</td>
                            `;
                            recentBody.appendChild(tr);
                        });

                        // Sección "Completados" al final
                        if (adminCompletedOrders.length > 0) {
                            const completedHeaderTr = document.createElement('tr');
                            completedHeaderTr.innerHTML = `
                                <td colspan="5" style="padding: 0; border: none;">
                                    <div style="display:flex; align-items:center; gap:10px; padding: 18px 12px 10px 12px;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span style="font-size:16px;">✅</span>
                                            <span style="font-weight:600; font-size:13px; color:#5ac8fa; text-transform:uppercase; letter-spacing:0.5px;">Completados</span>
                                            <span style="background:rgba(90,200,250,0.15); color:#5ac8fa; font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(90,200,250,0.3);">${adminCompletedOrders.length} ${adminCompletedOrders.length === 1 ? 'orden' : 'órdenes'}</span>
                                        </div>
                                        <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(90,200,250,0.3), transparent);"></div>
                                    </div>
                                </td>
                            `;
                            recentBody.appendChild(completedHeaderTr);

                            adminCompletedOrders.sort((a, b) => parseDateAdmin(b.date) - parseDateAdmin(a.date));

                            adminCompletedOrders.forEach(o => {
                                const tr = document.createElement('tr');
                                tr.style.cursor = 'pointer';
                                tr.style.opacity = '0.7';
                                tr.onclick = () => openOrderDetailsModal(o.id);
                                const badgeData = getBadgeInfo(o.status);
                                const formattedDateAdmin = o.date ? formatDateWithDayToAR(o.date) : 'Sin fecha';

                                tr.innerHTML = `
                                    <td data-label="ID">${o.id}</td>
                                    <td data-label="Cliente">${o.client}</td>
                                    <td data-label="Descripción del Trabajo">${o.type}</td>
                                    <td data-label="Estado"><span class="badge ${badgeData.class}">${badgeData.text}</span></td>
                                    <td data-label="Fecha">${formattedDateAdmin}</td>
                                `;
                                recentBody.appendChild(tr);
                            });
                        }
                    }
                }
            }

            // --- B. DASHBOARD COLABORADOR ---
            if (role === 'Colaborador' && (activeModule === 'dashboard' || activeModule === 'fichajes')) {
                // Verificar si tiene fichaje de entrada activo el día de hoy
                const todayStr = getTodayString();
                
                // Filtrar fichajes de hoy del colaborador actual
                const myFichajesToday = fichajes.filter(f => {
                    const matchesName = f.name && f.name.trim().toLowerCase() === (currentName || '').trim().toLowerCase();
                    if (!matchesName) return false;
                    
                    const fDate = f.date || "";
                    let cleanFDate = fDate;
                    if (fDate.includes('-')) {
                        const parts = fDate.split('-');
                        if (parts.length === 3 && parts[0].length === 4) {
                            cleanFDate = `${parts[2]}/${parts[1]}/${parts[0]}`;
                        }
                    }
                    return cleanFDate === todayStr;
                });

                // Ordenar los de hoy por timestamp descendente para obtener el estado más reciente de hoy
                myFichajesToday.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                
                const latestFichajeToday = myFichajesToday[0];
                const shiftStatusVal = document.getElementById('currentShiftStatus');
                const shiftSubtext = document.getElementById('currentShiftSubtext');

                if (shiftStatusVal && shiftSubtext) {
                    const btnUnico = document.getElementById('btnFicharUnico');
                    const entradasToday = myFichajesToday.filter(f => f.type === 'Entrada').length;
                    const salidasToday = myFichajesToday.filter(f => f.type === 'Salida').length;

                    // Validar si el último fichaje fue hace menos de 5 minutos
                    let isCooldownActive = false;
                    let remainingCooldownSec = 0;
                    if (latestFichajeToday && latestFichajeToday.timestamp) {
                        const lastTime = new Date(latestFichajeToday.timestamp).getTime();
                        const nowTime = getSyncedDate().getTime();
                        const diffMs = nowTime - lastTime;
                        const cooldownMs = 5 * 60 * 1000;
                        if (diffMs >= 0 && diffMs < cooldownMs) {
                            isCooldownActive = true;
                            remainingCooldownSec = Math.ceil((cooldownMs - diffMs) / 1000);
                        }
                    }

                    const formatCooldownText = (sec) => {
                        const m = Math.floor(sec / 60);
                        const s = sec % 60;
                        return m > 0 ? `${m}m ${String(s).padStart(2, '0')}s` : `${s}s`;
                    };

                    if (latestFichajeToday && latestFichajeToday.type === 'Entrada') {
                        shiftStatusVal.textContent = 'En Servicio';
                        shiftStatusVal.style.color = 'var(--color-green)';
                        shiftSubtext.textContent = `Entrada registrada a las ${latestFichajeToday.time}`;

                        if (btnUnico) {
                            if (salidasToday >= 2) {
                                btnUnico.textContent = 'Límite de Salidas Alcanzado (2/2)';
                                btnUnico.className = 'fichaje-btn out disabled';
                                btnUnico.disabled = true;
                                delete btnUnico.dataset.cooldownTarget;
                            } else if (isCooldownActive) {
                                btnUnico.textContent = `Espera ${formatCooldownText(remainingCooldownSec)} para Salida`;
                                btnUnico.className = 'fichaje-btn out disabled';
                                btnUnico.disabled = true;
                                btnUnico.dataset.cooldownTarget = String(new Date(latestFichajeToday.timestamp).getTime() + 5 * 60 * 1000);
                                btnUnico.dataset.nextType = 'Salida';
                            } else {
                                delete btnUnico.dataset.cooldownTarget;
                                btnUnico.textContent = 'Marcar Salida';
                                btnUnico.className = 'fichaje-btn out';
                                btnUnico.disabled = false;
                            }
                        }
                    } else {
                        shiftStatusVal.textContent = 'Fuera de Turno';
                        shiftStatusVal.style.color = 'var(--color-red)';
                        shiftSubtext.textContent = latestFichajeToday
                            ? `Salida registrada hoy a las ${latestFichajeToday.time}` : 'No has iniciado jornada hoy';

                        if (btnUnico) {
                            if (entradasToday >= 2) {
                                btnUnico.textContent = 'Límite de Entradas Alcanzado (2/2)';
                                btnUnico.className = 'fichaje-btn in disabled';
                                btnUnico.disabled = true;
                                delete btnUnico.dataset.cooldownTarget;
                            } else if (isCooldownActive) {
                                btnUnico.textContent = `Espera ${formatCooldownText(remainingCooldownSec)} para Entrada`;
                                btnUnico.className = 'fichaje-btn in disabled';
                                btnUnico.disabled = true;
                                btnUnico.dataset.cooldownTarget = String(new Date(latestFichajeToday.timestamp).getTime() + 5 * 60 * 1000);
                                btnUnico.dataset.nextType = 'Entrada';
                            } else {
                                delete btnUnico.dataset.cooldownTarget;
                                btnUnico.textContent = 'Marcar Entrada';
                                btnUnico.className = 'fichaje-btn in';
                                btnUnico.disabled = false;
                            }
                        }
                    }
                }

                // Helper para parsear fecha a timestamp
                const parseDateDash = (dStr) => {
                    if (!dStr) return 0;
                    let parts = dStr.split('/');
                    if (parts.length === 3) return new Date(parts[2], parts[1]-1, parts[0]).getTime();
                    parts = dStr.split('-');
                    if (parts.length === 3) return new Date(parts[0], parts[1]-1, parts[2]).getTime();
                    return new Date(dStr).getTime() || 0;
                };

                // Helper para parsear horario a minutos
                const parseTimeDash = (tStr) => {
                    if (!tStr || tStr === '') return 9999;
                    const match = tStr.match(/(\d{1,2}):(\d{2})/);
                    if (match) return parseInt(match[1]) * 60 + parseInt(match[2]);
                    return 9999;
                };

                // Obtener fecha de hoy normalizada
                const todayStartDash = new Date();
                todayStartDash.setHours(0, 0, 0, 0);
                const todayTsDash = todayStartDash.getTime();

                const isTodayDash = (dStr) => {
                    const ts = parseDateDash(dStr);
                    if (!ts) return false;
                    const d = new Date(ts);
                    d.setHours(0, 0, 0, 0);
                    return d.getTime() === todayTsDash;
                };

                // Filtrar órdenes de trabajo del colaborador (múltiples asignados)
                const myOrders = ordenesTrabajo.filter(o => isOrderAssignedToUser(o, currentName));
                const myActiveOrdersToday = myOrders.filter(o => o.status !== 'Completado' && isTodayDash(o.date));
                
                const countBadgeEl = document.getElementById('assignedOrdersCount');
                if (countBadgeEl) {
                    countBadgeEl.textContent = `${myActiveOrdersToday.length} Órdenes`;
                }

                const collabOrdersBody = document.getElementById('collabOrdersTableBody');
                if (collabOrdersBody) {
                    collabOrdersBody.innerHTML = '';


                    if (myOrders.length === 0) {
                        collabOrdersBody.innerHTML = `<tr><td colspan="8" style="text-align:center; color:var(--text-muted); padding:20px;">No tienes órdenes asignadas.</td></tr>`;
                    } else {
                        // Separar activas y completadas
                        const dashActivas = myOrders.filter(o => o.status !== 'Completado');
                        const dashCompletadas = myOrders.filter(o => o.status === 'Completado');

                        // Separar órdenes activas de hoy y del resto
                        const dashHoy = dashActivas.filter(o => isTodayDash(o.date));
                        const dashOtros = dashActivas.filter(o => !isTodayDash(o.date));

                        // Ordenar hoy por horario ascendente
                        dashHoy.sort((a, b) => parseTimeDash(a.time) - parseTimeDash(b.time));

                        // Ordenar otros por fecha ascendente + horario
                        dashOtros.sort((a, b) => {
                            const dateDiff = parseDateDash(a.date) - parseDateDash(b.date);
                            if (dateDiff !== 0) return dateDiff;
                            return parseTimeDash(a.time) - parseTimeDash(b.time);
                        });

                        const sortedDashOrders = [...dashHoy, ...dashOtros];
                        let dashInsertedHoy = false;
                        let dashInsertedOtros = false;
                        const countDashHoy = dashHoy.length;

                        sortedDashOrders.forEach(o => {
                            const isTodayO = isTodayDash(o.date);

                            // Header "Hoy"
                            if (isTodayO && !dashInsertedHoy) {
                                dashInsertedHoy = true;
                                const headerTr = document.createElement('tr');
                                headerTr.innerHTML = `
                                    <td colspan="8" style="padding: 0; border: none;">
                                        <div style="display:flex; align-items:center; gap:10px; padding: 14px 12px 10px 12px;">
                                            <div style="display:flex; align-items:center; gap:8px;">
                                                <span style="font-size:18px;">📋</span>
                                                <span style="font-weight:700; font-size:15px; color:#00e676; text-transform:uppercase; letter-spacing:0.5px;">Hoy</span>
                                                <span style="background:rgba(0,230,118,0.15); color:#00e676; font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(0,230,118,0.3);">${countDashHoy} ${countDashHoy === 1 ? 'orden' : 'órdenes'}</span>
                                            </div>
                                            <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(0,230,118,0.4), transparent);"></div>
                                        </div>
                                    </td>
                                `;
                                collabOrdersBody.appendChild(headerTr);
                            }

                            // Header "Próximos días"
                            if (!isTodayO && !dashInsertedOtros) {
                                dashInsertedOtros = true;
                                const headerTr = document.createElement('tr');
                                headerTr.innerHTML = `
                                    <td colspan="8" style="padding: 0; border: none;">
                                        <div style="display:flex; align-items:center; gap:10px; padding: ${dashInsertedHoy ? '18px' : '14px'} 12px 10px 12px;">
                                            <div style="display:flex; align-items:center; gap:8px;">
                                                <span style="font-size:16px;">📅</span>
                                                <span style="font-weight:600; font-size:13px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px;">Próximos días</span>
                                            </div>
                                            <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(255,255,255,0.1), transparent);"></div>
                                        </div>
                                    </td>
                                `;
                                collabOrdersBody.appendChild(headerTr);
                            }

                            const tr = document.createElement('tr');
                            if (isTodayO) {
                                tr.style.borderLeft = '3px solid #00e676';
                            }
                            const badgeData = getBadgeInfo(o.status);
                            const actionBtn = `<button class="save-btn" style="width:auto; margin:0; padding:6px 12px; font-size:11px; background-color: var(--color-blue); color: #000; font-weight:700;" onclick="openOrderDetailsModal('${o.id}')">Ver / Estado</button>`;

                            // Formatear Fecha y Horario con fallback
                            const hoyBadgeDash = isTodayO ? ' <span style="background: linear-gradient(135deg, #00c853, #00e676); color: #000; font-weight: 700; font-size: 10px; padding: 2px 8px; border-radius: 10px; margin-left: 6px; letter-spacing: 0.5px; text-transform: uppercase;">Hoy</span>' : '';
                            const formattedDate = o.date ? (formatDateWithDayToAR(o.date) + hoyBadgeDash) : '<span style="color:var(--text-muted); font-style:italic;">Pendiente de coordinación</span>';
                            const formattedTime = (o.time && o.time !== "") ? `${o.time} hs` : '<span style="color:var(--text-muted); font-style:italic;">Pendiente de coordinación</span>';

                            const cObj = clientes.find(c => c.id === o.clientId || (c.name && c.name.toLowerCase() === (o.client || '').toLowerCase()));
                            const mUrl = window.getGoogleMapsUrl(o.address, cObj);
                            const addrHtml = (mUrl && o.address && o.address !== 'Sin especificar' && o.address !== 'Sin domicilio')
                                ? `<div style="display:inline-flex; align-items:center; gap:6px; flex-wrap:wrap;"><span>${o.address}</span><a href="${mUrl}" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:2px; padding:2px 6px; background:rgba(0,180,216,0.15); border:1px solid var(--color-blue); color:var(--color-blue); border-radius:4px; font-size:11px; text-decoration:none; font-weight:600;" title="Abrir en Google Maps" onclick="event.stopPropagation();">🗺️ Maps</a></div>`
                                : (o.address || 'Sin especificar');

                            tr.innerHTML = `
                                <td data-label="ID">${o.id}</td>
                                <td data-label="Cliente">${o.client}</td>
                                <td data-label="Dirección">${addrHtml}</td>
                                <td data-label="Fecha">${formattedDate}</td>
                                <td data-label="Horario">${formattedTime}</td>
                                <td data-label="Equipo">${o.type}</td>
                                <td data-label="Estado"><span class="badge ${badgeData.class}">${badgeData.text}</span></td>
                                <td data-label="Acción">${actionBtn}</td>
                            `;
                            collabOrdersBody.appendChild(tr);
                        });

                        // Sección "Completados" al final
                        if (dashCompletadas.length > 0) {
                            const completedHeaderTr = document.createElement('tr');
                            completedHeaderTr.innerHTML = `
                                <td colspan="8" style="padding: 0; border: none;">
                                    <div style="display:flex; align-items:center; gap:10px; padding: 18px 12px 10px 12px;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span style="font-size:16px;">✅</span>
                                            <span style="font-weight:600; font-size:13px; color:#5ac8fa; text-transform:uppercase; letter-spacing:0.5px;">Completados</span>
                                            <span style="background:rgba(90,200,250,0.15); color:#5ac8fa; font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(90,200,250,0.3);">${dashCompletadas.length} ${dashCompletadas.length === 1 ? 'orden' : 'órdenes'}</span>
                                        </div>
                                        <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(90,200,250,0.3), transparent);"></div>
                                    </div>
                                </td>
                            `;
                            collabOrdersBody.appendChild(completedHeaderTr);

                            dashCompletadas.sort((a, b) => parseDateDash(b.date) - parseDateDash(a.date));

                            dashCompletadas.forEach(o => {
                                const tr = document.createElement('tr');
                                tr.style.opacity = '0.7';
                                const badgeData = getBadgeInfo(o.status);
                                const formattedDate = o.date ? formatDateWithDayToAR(o.date) : '';
                                const formattedTime = (o.time && o.time !== "") ? `${o.time} hs` : '';
                                const compCObj = clientes.find(c => c.id === o.clientId || (c.name && c.name.toLowerCase() === (o.client || '').toLowerCase()));
                                const compMUrl = window.getGoogleMapsUrl(o.address, compCObj);
                                const compAddrHtml = (compMUrl && o.address && o.address !== 'Sin especificar' && o.address !== 'Sin domicilio')
                                    ? `<div style="display:inline-flex; align-items:center; gap:6px; flex-wrap:wrap;"><span>${o.address}</span><a href="${compMUrl}" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:2px; padding:2px 6px; background:rgba(0,180,216,0.15); border:1px solid var(--color-blue); color:var(--color-blue); border-radius:4px; font-size:11px; text-decoration:none; font-weight:600;" title="Abrir en Google Maps" onclick="event.stopPropagation();">🗺️ Maps</a></div>`
                                    : (o.address || 'Sin especificar');

                                tr.innerHTML = `
                                    <td data-label="ID">${o.id}</td>
                                    <td data-label="Cliente">${o.client}</td>
                                    <td data-label="Dirección">${compAddrHtml}</td>
                                    <td data-label="Fecha">${formattedDate}</td>
                                    <td data-label="Horario">${formattedTime}</td>
                                    <td data-label="Equipo">${o.type}</td>
                                    <td data-label="Estado"><span class="badge ${badgeData.class}">${badgeData.text}</span></td>
                                    <td data-label="Acción"><span style="color:var(--color-green); font-size:12px; font-weight:600;">Listo</span></td>
                                `;
                                collabOrdersBody.appendChild(tr);
                            });
                        }
                    }
                }
            }

            // Helper para obtener insignia de estado con icono y color
            function getBadgeInfo(status) {
                if (status === 'En Proceso') return { class: 'status-en-proceso', text: '🟢 En Proceso' };
                if (status === 'Completado') return { class: 'status-completado', text: '🔵 Completado' };
                if (status === 'Reprogramar') return { class: 'status-reprogramar', text: '🟣 Reprogramar' };
                if (status === 'Presupuesto') return { class: 'status-presupuesto', text: '🟡 Presupuesto' };
                return { class: 'status-pendiente', text: '🔴 Pendiente visita' };
            }

            // --- MONITOREO EN TIEMPO REAL (ADMIN ONLY) ---
            if (role === 'Administrador' && activeModule === 'dashboard') {
                const adminSummaryContainer = document.getElementById('adminLiveWorkSummary');
                if (adminSummaryContainer) {
                    const workingNow = ordenesTrabajo.filter(o => o.status === 'En Proceso');
                    
                    // Contar total de técnicos únicos trabajando en domicilio
                    const techSet = new Set();
                    workingNow.forEach(o => {
                        if (Array.isArray(o.assignees)) {
                            o.assignees.forEach(name => {
                                if (name && name !== 'Sin Asignar') techSet.add(name);
                            });
                        } else if (typeof o.assignee === 'string' && o.assignee !== 'Sin Asignar') {
                            techSet.add(o.assignee);
                        }
                    });
                    const totalTechsCount = techSet.size > 0 ? techSet.size : workingNow.length;

                    if (workingNow.length > 0) {
                        adminSummaryContainer.innerHTML = `
                            <div class="content-card" style="background: rgba(76, 217, 100, 0.08); border: 1px solid rgba(76, 217, 100, 0.4); padding: 14px 18px; border-radius: 10px;">
                                <div style="font-weight: 700; color: #4cd964; font-size: 14px; display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
                                    <span style="display: inline-block; width: 10px; height: 10px; border-radius: 50%; background-color: #4cd964; box-shadow: 0 0 8px #4cd964; animation: pulseGreen 2s infinite;"></span>
                                    TÉCNICOS TRABAJANDO EN DOMICILIO AHORA (${totalTechsCount})
                                </div>
                                <div style="display: flex; flex-direction: column; gap: 8px;">
                                    ${workingNow.map(o => {
                                        const nowCObj = clientes.find(c => c.id === o.clientId || (c.name && c.name.toLowerCase() === (o.client || '').toLowerCase()));
                                        const nowMUrl = window.getGoogleMapsUrl(o.address, nowCObj);
                                        const nowMapsBtn = (nowMUrl && o.address && o.address !== 'Sin especificar' && o.address !== 'Sin domicilio')
                                            ? `<a href="${nowMUrl}" target="_blank" rel="noopener noreferrer" style="margin-left:6px; display:inline-flex; align-items:center; gap:3px; padding:2px 7px; background:rgba(0, 180, 216, 0.2); border:1px solid var(--color-blue); color:var(--color-blue); border-radius:4px; font-size:11px; font-weight:700; text-decoration:none;" title="Ver en Google Maps">🗺️ Maps</a>`
                                            : '';
                                        return `
                                        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; background: rgba(0,0,0,0.25); padding: 10px 14px; border-radius: 8px; font-size: 13px;">
                                            <div>
                                                <strong style="color: var(--color-blue); font-size: 14px;">${o.id}</strong> - <strong style="color:#fff;">${o.client}</strong> en 📍 <span style="color:var(--color-yellow); font-weight:600;">${o.address}</span>
                                                ${nowMapsBtn}
                                                <span style="font-size: 11px; color: var(--text-secondary); margin-left: 6px;">(🔧 ${o.type})</span>
                                            </div>
                                            <div style="font-size: 12px; color: #4cd964; font-weight: 700; background: rgba(76, 217, 100, 0.15); padding: 4px 10px; border-radius: 6px;">
                                                👥 ${Array.isArray(o.assignees) ? o.assignees.join(', ') : o.assignee || 'Sin Asignar'}
                                            </div>
                                        </div>
                                    `}).join('')}
                                </div>
                            </div>
                        `;
                    } else {
                        adminSummaryContainer.innerHTML = `
                            <div class="content-card" style="padding: 10px 16px; border-radius: 8px; font-size: 12px; color: var(--text-muted);">
                                ℹ️ Ningún técnico se encuentra trabajando en domicilio en este momento.
                            </div>
                        `;
                    }
                }
            }

            // --- C1. ÓRDENES SIN COORDINAR (PANEL DERECHO LATERAL) ---
            const uncoordinatedBadge = document.getElementById('uncoordinatedCountBadge');
            const uncoordinatedOrders = role === 'Colaborador'
                ? ordenesTrabajo.filter(o => (!o.date || o.date === "") && o.status !== 'Completado' && isOrderAssignedToUser(o, currentName))
                : ordenesTrabajo.filter(o => (!o.date || o.date === "") && o.status !== 'Completado');

            if (uncoordinatedBadge) {
                uncoordinatedBadge.textContent = uncoordinatedOrders.length;
            }

            window.openUncoordinatedModal = function() {
                const modal = document.getElementById('modalUncoordinatedOrders');
                if(modal) modal.classList.add('show');
            };

            window.closeUncoordinatedModal = function() {
                const modal = document.getElementById('modalUncoordinatedOrders');
                if(modal) modal.classList.remove('show');
            };

            const uncoordinatedList = document.getElementById('uncoordinatedOrdersList');
            if (uncoordinatedList && (activeModule === 'dashboard' || activeModule === 'ordenes')) {
                uncoordinatedList.innerHTML = '';

                    if (uncoordinatedOrders.length === 0) {
                        uncoordinatedList.innerHTML = `<div style="text-align:center; color:var(--text-muted); font-size:12px; padding:20px;">Sin órdenes sin coordinar.</div>`;
                    } else {
                        let tableHTML = `
                            <div class="table-responsive">
                                <table class="custom-table" style="font-size: 11px;">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>CLIENTE</th>
                                            <th>ACCIONES</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                        `;
                        uncoordinatedOrders.forEach(o => {
                            const adminBtns = role === 'Administrador' ? `
                                <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:10px; background-color: #24364e; color: #ffffff; border: 1px solid var(--border-color);" onclick="openOrderDetailsModal('${o.id}')">Editar</button>
                                <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:10px; background-color: #7a1a1a; color: #ffffff; border: 1px solid #992020;" onclick="handleDeleteOrder('${o.id}')">Eliminar</button>
                            ` : '';
                            tableHTML += `
                                <tr>
                                    <td data-label="ID" style="font-weight:700; color:var(--color-blue);">${o.id}</td>
                                    <td data-label="CLIENTE" style="font-weight:600; text-transform:uppercase;">${o.client}</td>
                                    <td data-label="ACCIONES">
                                        <div style="display:flex; gap:4px; align-items:center; flex-wrap:nowrap;">
                                            <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:10px; background-color: var(--color-blue); color: #000; font-weight:700;" onclick="openOrderDetailsModal('${o.id}')">Ver</button>
                                            ${adminBtns}
                                        </div>
                                    </td>
                                </tr>
                            `;
                        });
                        tableHTML += `</tbody></table></div>`;
                        uncoordinatedList.innerHTML = tableHTML;
                    }
                }

            // --- C2. ÓRDENES PENDIENTES / ACTIVAS Y COMPLETADAS ---
            if (activeModule === 'ordenes') {
                const ordersFullBody = document.getElementById('ordersFullTableBody');
                const collabCompletedBody = document.getElementById('collabCompletedOrdersBody');
                const collabCompletedBadge = document.getElementById('collabCompletedCountBadge');

                if (ordersFullBody) {
                    ordersFullBody.innerHTML = '';

                    // Sincronizar texto del botón superior si existe
                    const btnHistorialTop = document.getElementById('btnVerHistorialOrdenes');
                    if (btnHistorialTop && !btnHistorialTop.disabled) {
                        btnHistorialTop.textContent = window._mostrarHistorialCompleto ? '📂 Ocultar historial (>7d)' : '📂 Ver historial';
                    }

                    // Helper para parsear fecha a timestamp
                    const parseDateStr = (dStr) => {
                        if (!dStr) return 0;
                        let parts = dStr.split('/');
                        if (parts.length === 3) return new Date(parts[2], parts[1]-1, parts[0]).getTime();
                        parts = dStr.split('-');
                        if (parts.length === 3) return new Date(parts[0], parts[1]-1, parts[2]).getTime();
                        return new Date(dStr).getTime() || 0;
                    };

                    // Helper para parsear horario a minutos para ordenar
                    const parseTimeStr = (tStr) => {
                        if (!tStr || tStr === '') return 9999; // Sin horario va al final
                        const match = tStr.match(/(\d{1,2}):(\d{2})/);
                        if (match) return parseInt(match[1]) * 60 + parseInt(match[2]);
                        return 9999;
                    };

                    // Obtener fecha de hoy normalizada (sin hora)
                    const todayStart = new Date();
                    todayStart.setHours(0, 0, 0, 0);
                    const todayTimestamp = todayStart.getTime();

                    const isToday = (dStr) => {
                        const ts = parseDateStr(dStr);
                        if (!ts) return false;
                        const d = new Date(ts);
                        d.setHours(0, 0, 0, 0);
                        return d.getTime() === todayTimestamp;
                    };

                    // Límite de 7 días hacia atrás para completadas
                    const sevenDaysAgoTs = (() => {
                        const d = new Date();
                        d.setDate(d.getDate() - 7);
                        d.setHours(0, 0, 0, 0);
                        return d.getTime();
                    })();

                    const isWithinLast7Days = (o) => {
                        let ts = 0;
                        if (o.date) ts = parseDateStr(o.date);
                        if (!ts && o.timestamp) ts = new Date(o.timestamp).getTime();
                        if (!ts || isNaN(ts)) return true; // Si no tiene fecha registrable, mantener
                        return ts >= sevenDaysAgoTs;
                    };

                    // Obtener órdenes a mostrar según rol
                    let allActiveOrders = [];
                    let allCompletedOrders = [];

                    if (role === 'Colaborador') {
                        const myOrders = ordenesTrabajo.filter(o => isOrderAssignedToUser(o, currentName));
                        allActiveOrders = myOrders.filter(o => o.status !== 'Completado');
                        allCompletedOrders = myOrders.filter(o => o.status === 'Completado');
                    } else {
                        // Admin ve todas las órdenes activas (incluyendo las pendientes de coordinar)
                        allActiveOrders = ordenesTrabajo.filter(o => o.status !== 'Completado');
                        allCompletedOrders = ordenesTrabajo.filter(o => o.status === 'Completado');
                    }

                    // Clasificación de órdenes activas
                    const ordenesHoy = allActiveOrders.filter(o => o.date && isToday(o.date));
                    const ordenesOtros = allActiveOrders.filter(o => o.date && !isToday(o.date));
                    const ordenesSinCoordinar = allActiveOrders.filter(o => !o.date || o.date === "");

                    // Ordenar hoy por horario ascendente
                    ordenesHoy.sort((a, b) => parseTimeStr(a.time) - parseTimeStr(b.time));

                    // Ordenar próximas por fecha y luego horario
                    ordenesOtros.sort((a, b) => {
                        const dateDiff = parseDateStr(a.date) - parseDateStr(b.date);
                        if (dateDiff !== 0) return dateDiff;
                        return parseTimeStr(a.time) - parseTimeStr(b.time);
                    });

                    // Ordenar sin coordinar por timestamp descendente (más nuevas primero)
                    ordenesSinCoordinar.sort((a, b) => {
                        const tB = b.timestamp ? new Date(b.timestamp).getTime() : 0;
                        const tA = a.timestamp ? new Date(a.timestamp).getTime() : 0;
                        return tB - tA;
                    });

                    // Filtro de 7 días para completadas (si _mostrarHistorialCompleto es true, muestra todas)
                    const completedOrdersToShow = window._mostrarHistorialCompleto
                        ? allCompletedOrders
                        : allCompletedOrders.filter(isWithinLast7Days);

                    // Ordenar completadas por fecha descendente
                    completedOrdersToShow.sort((a, b) => {
                        const tB = parseDateStr(b.date) || (b.timestamp ? new Date(b.timestamp).getTime() : 0);
                        const tA = parseDateStr(a.date) || (a.timestamp ? new Date(a.timestamp).getTime() : 0);
                        return tB - tA;
                    });

                    const titleEl = document.getElementById('ordersListTitle');
                    if (titleEl) {
                        titleEl.textContent = role === 'Colaborador' ? 'Mis Órdenes Activas' : 'Órdenes Pendientes / Coordinadas';
                    }

                    const totalCols = role === 'Administrador' ? 8 : 7;

                    // Función auxiliar para renderizar fila de orden
                    const renderRow = (o, rowType) => {
                        const tr = document.createElement('tr');
                        tr.style.cursor = 'pointer';

                        if (rowType === 'hoy') {
                            tr.style.borderLeft = '3px solid #00e676';
                        } else if (rowType === 'sinCoordinar') {
                            tr.style.borderLeft = '3px solid #f59e0b';
                        } else if (rowType === 'completado') {
                            tr.style.opacity = '0.75';
                        }

                        tr.onclick = (e) => {
                            if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'A') {
                                openOrderDetailsModal(o.id);
                            }
                        };

                        const badgeData = getBadgeInfo(o.status);
                        const collaboratorsNames = o.assignees ? o.assignees.join(', ') : (o.assignee || 'Sin Asignar');
                        const collabTd = role === 'Administrador' ? `<td data-label="COLABORADORES">${collaboratorsNames}</td>` : '';

                        // Formatear Fecha y Horario
                        let formattedDate = '';
                        if (rowType === 'sinCoordinar') {
                            formattedDate = '<span style="color:#f59e0b; font-weight:600; font-size:12px;">⏳ Pendiente coord.</span>';
                        } else {
                            const hoyBadge = rowType === 'hoy' ? ' <span style="background: linear-gradient(135deg, #00c853, #00e676); color: #000; font-weight: 700; font-size: 10px; padding: 2px 8px; border-radius: 10px; margin-left: 6px; letter-spacing: 0.5px; text-transform: uppercase;">Hoy</span>' : '';
                            formattedDate = o.date ? (formatDateWithDayToAR(o.date) + hoyBadge) : '<span style="color:var(--text-muted); font-style:italic;">Pendiente de coordinación</span>';
                        }

                        let formattedTime = '';
                        if (rowType === 'sinCoordinar') {
                            formattedTime = '<span style="color:var(--text-muted); font-style:italic; font-size:12px;">Sin horario</span>';
                        } else {
                            let orderTimeStr = o.timeEnd ? `${o.time}HS-${o.timeEnd}HS` : (o.time ? `${o.time} hs` : '');
                            formattedTime = orderTimeStr || '<span style="color:var(--text-muted); font-style:italic;">Pendiente</span>';
                        }

                        const actionTd = role === 'Administrador' ? `
                            <td data-label="ACCIONES">
                                <div style="display:flex; gap:6px; align-items:center; flex-wrap:nowrap;">
                                    <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:11px; background-color: var(--color-blue); color: #000; font-weight:700;" onclick="openOrderDetailsModal('${o.id}')">Ver</button>
                                    <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:11px; background-color: #24364e; color: #ffffff; border: 1px solid var(--border-color);" onclick="openOrderDetailsModal('${o.id}')">Editar</button>
                                    <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:11px; background-color: #7a1a1a; color: #ffffff; border: 1px solid #992020;" onclick="handleDeleteOrder('${o.id}')">Eliminar</button>
                                </div>
                            </td>
                        ` : `
                            <td data-label="ACCIONES">
                                <div style="display:flex; gap:6px; align-items:center; flex-wrap:nowrap;">
                                    <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:11px; background-color: var(--color-blue); color: #000; font-weight:700;" onclick="openOrderDetailsModal('${o.id}')">${rowType === 'completado' ? 'Ver' : 'Ver / Estado'}</button>
                                </div>
                            </td>
                        `;

                        const cObj = clientes.find(c => c.id === o.clientId || (c.name && c.name.toLowerCase() === (o.client || '').toLowerCase()));
                        const mUrl = window.getGoogleMapsUrl(o.address, cObj);
                        const addrHtml = (mUrl && o.address && o.address !== 'Sin especificar' && o.address !== 'Sin domicilio')
                            ? `<div style="display:inline-flex; align-items:center; gap:6px; flex-wrap:wrap;"><span>${o.address}</span><a href="${mUrl}" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:2px; padding:2px 6px; background:rgba(0,180,216,0.15); border:1px solid var(--color-blue); color:var(--color-blue); border-radius:4px; font-size:11px; text-decoration:none; font-weight:600;" title="Abrir en Google Maps" onclick="event.stopPropagation();">🗺️ Maps</a></div>`
                            : (o.address || 'Sin especificar');

                        tr.innerHTML = `
                            <td data-label="FECHA">${formattedDate}</td>
                            <td data-label="ID" style="font-weight:700;">${o.id}</td>
                            <td data-label="CLIENTE" style="font-weight:600;">${o.client}</td>
                            <td data-label="DIRECCIÓN">${addrHtml}</td>
                            <td data-label="HORARIO">${formattedTime}</td>
                            ${collabTd}
                            <td data-label="ESTADO"><span class="badge ${badgeData.class}">${badgeData.text}</span></td>
                            ${actionTd}
                        `;
                        return tr;
                    };

                    const totalActiveOrders = ordenesHoy.length + ordenesOtros.length + ordenesSinCoordinar.length;

                    if (totalActiveOrders === 0) {
                        ordersFullBody.innerHTML = `<tr><td colspan="${totalCols}" style="text-align:center; color:var(--text-muted); padding:20px;">No hay órdenes activas.</td></tr>`;
                    } else {
                        // 1. Sección Hoy
                        if (ordenesHoy.length > 0) {
                            const headerTr = document.createElement('tr');
                            headerTr.innerHTML = `
                                <td colspan="${totalCols}" style="padding: 0; border: none;">
                                    <div style="display:flex; align-items:center; gap:10px; padding: 14px 12px 10px 12px;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span style="font-size:18px;">📋</span>
                                            <span style="font-weight:700; font-size:15px; color:#00e676; text-transform:uppercase; letter-spacing:0.5px;">Hoy</span>
                                            <span style="background:rgba(0,230,118,0.15); color:#00e676; font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(0,230,118,0.3);">${ordenesHoy.length} ${ordenesHoy.length === 1 ? 'orden' : 'órdenes'}</span>
                                        </div>
                                        <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(0,230,118,0.4), transparent);"></div>
                                    </div>
                                </td>
                            `;
                            ordersFullBody.appendChild(headerTr);
                            ordenesHoy.forEach(o => ordersFullBody.appendChild(renderRow(o, 'hoy')));
                        }

                        // 2. Sección Próximos días
                        if (ordenesOtros.length > 0) {
                            const headerTr = document.createElement('tr');
                            headerTr.innerHTML = `
                                <td colspan="${totalCols}" style="padding: 0; border: none;">
                                    <div style="display:flex; align-items:center; gap:10px; padding: ${ordenesHoy.length > 0 ? '18px' : '14px'} 12px 10px 12px;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span style="font-size:16px;">📅</span>
                                            <span style="font-weight:600; font-size:13px; color:var(--text-muted); text-transform:uppercase; letter-spacing:0.5px;">Próximos días</span>
                                            <span style="background:rgba(255,255,255,0.08); color:var(--text-muted); font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(255,255,255,0.15);">${ordenesOtros.length}</span>
                                        </div>
                                        <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(255,255,255,0.1), transparent);"></div>
                                    </div>
                                </td>
                            `;
                            ordersFullBody.appendChild(headerTr);
                            ordenesOtros.forEach(o => ordersFullBody.appendChild(renderRow(o, 'otros')));
                        }

                        // 3. Sección Sin Coordinar (Visible directamente en la tabla)
                        if (ordenesSinCoordinar.length > 0) {
                            const headerTr = document.createElement('tr');
                            headerTr.innerHTML = `
                                <td colspan="${totalCols}" style="padding: 0; border: none;">
                                    <div style="display:flex; align-items:center; gap:10px; padding: 18px 12px 10px 12px;">
                                        <div style="display:flex; align-items:center; gap:8px;">
                                            <span style="font-size:16px;">⏳</span>
                                            <span style="font-weight:700; font-size:13px; color:#f59e0b; text-transform:uppercase; letter-spacing:0.5px;">Sin Coordinar</span>
                                            <span style="background:rgba(245,158,11,0.15); color:#f59e0b; font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(245,158,11,0.3);">${ordenesSinCoordinar.length} ${ordenesSinCoordinar.length === 1 ? 'orden' : 'órdenes'}</span>
                                        </div>
                                        <div style="flex:1; height:1px; background: linear-gradient(90deg, rgba(245,158,11,0.4), transparent);"></div>
                                    </div>
                                </td>
                            `;
                            ordersFullBody.appendChild(headerTr);
                            ordenesSinCoordinar.forEach(o => ordersFullBody.appendChild(renderRow(o, 'sinCoordinar')));
                        }
                    }

                    // 4. Sección Completados (con filtro de últimos 7 días e historial bajo demanda)
                    if (completedOrdersToShow.length > 0) {
                        const isFull = !!window._mostrarHistorialCompleto;
                        const compHeaderTr = document.createElement('tr');
                        compHeaderTr.innerHTML = `
                            <td colspan="${totalCols}" style="padding: 0; border: none;">
                                <div style="display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; padding: 20px 12px 10px 12px;">
                                    <div style="display:flex; align-items:center; gap:8px;">
                                        <span style="font-size:16px;">✅</span>
                                        <span style="font-weight:600; font-size:13px; color:#5ac8fa; text-transform:uppercase; letter-spacing:0.5px;">${isFull ? 'Completados (Historial Completo)' : 'Completados (Últimos 7 días)'}</span>
                                        <span style="background:rgba(90,200,250,0.15); color:#5ac8fa; font-weight:700; font-size:12px; padding:2px 10px; border-radius:12px; border:1px solid rgba(90,200,250,0.3);">${completedOrdersToShow.length} ${completedOrdersToShow.length === 1 ? 'orden' : 'órdenes'}</span>
                                    </div>
                                    <div style="display:flex; align-items:center; gap:10px;">
                                        <button type="button" onclick="loadOrdenesHistorial()" style="background:rgba(139,92,246,0.15); border:1px solid rgba(139,92,246,0.5); color:#a78bfa; font-size:11px; font-weight:600; padding:4px 10px; border-radius:6px; cursor:pointer;">
                                            ${isFull ? 'Ocultar historial (>7d)' : '📂 Ver historial completo'}
                                        </button>
                                        <div style="width:60px; height:1px; background: linear-gradient(90deg, rgba(90,200,250,0.3), transparent);"></div>
                                    </div>
                                </div>
                            </td>
                        `;
                        ordersFullBody.appendChild(compHeaderTr);
                        completedOrdersToShow.forEach(o => ordersFullBody.appendChild(renderRow(o, 'completado')));
                    }

                    // Renderizar Historial de Completadas para Colaborador (últimos 7 días o completo)
                    if (role === 'Colaborador' && collabCompletedBody) {
                        collabCompletedBody.innerHTML = '';
                        if (collabCompletedBadge) collabCompletedBadge.textContent = completedOrdersToShow.length;

                        if (completedOrdersToShow.length === 0) {
                            collabCompletedBody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:20px;">No hay órdenes completadas recientes.</td></tr>`;
                        } else {
                            completedOrdersToShow.forEach(o => {
                                const tr = document.createElement('tr');
                                tr.style.cursor = 'pointer';
                                tr.onclick = (e) => {
                                    if (e.target.tagName !== 'BUTTON' && e.target.tagName !== 'A') {
                                        openOrderDetailsModal(o.id);
                                    }
                                };
                                const badgeData = getBadgeInfo(o.status);

                                const compCollabCObj = clientes.find(c => c.id === o.clientId || (c.name && c.name.toLowerCase() === (o.client || '').toLowerCase()));
                                const compCollabMUrl = window.getGoogleMapsUrl(o.address, compCollabCObj);
                                const compCollabAddrHtml = (compCollabMUrl && o.address && o.address !== 'Sin especificar' && o.address !== 'Sin domicilio')
                                    ? `<div style="display:inline-flex; align-items:center; gap:6px; flex-wrap:wrap;"><span>${o.address}</span><a href="${compCollabMUrl}" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; gap:2px; padding:2px 6px; background:rgba(0,180,216,0.15); border:1px solid var(--color-blue); color:var(--color-blue); border-radius:4px; font-size:11px; text-decoration:none; font-weight:600;" title="Abrir en Google Maps" onclick="event.stopPropagation();">🗺️ Maps</a></div>`
                                    : (o.address || 'Sin especificar');

                                tr.innerHTML = `
                                    <td data-label="ID" style="font-weight:700;">${o.id}</td>
                                    <td data-label="CLIENTE" style="font-weight:600;">${o.client}</td>
                                    <td data-label="DIRECCIÓN">${compCollabAddrHtml}</td>
                                    <td data-label="TAREA">${o.type}</td>
                                    <td data-label="ESTADO"><span class="badge ${badgeData.class}">${badgeData.text}</span></td>
                                    <td data-label="ACCIONES">
                                        <button class="save-btn" style="width:auto; margin:0; padding:4px 8px; font-size:11px; background-color: var(--color-blue); color: #000; font-weight:700;" onclick="openOrderDetailsModal('${o.id}')">Ver</button>
                                    </td>
                                `;
                                collabCompletedBody.appendChild(tr);
                            });
                        }
                    }
                }
            }

            // --- D. LISTADO DE COLABORADORES (ADMIN ONLY) ---
            if (role === 'Administrador' && activeModule === 'colaboradores' && collaboratorsGridContainer) {
                renderCollaboratorsGrid();
            }

            // --- E. TABLA DE FICHAJES ---
            if (role === 'Administrador' && activeModule === 'fichajes') {
                renderTodayAttendanceControl();
            }

            const fichajesTableBody = document.getElementById('fichajesTableBody');
            if (fichajesTableBody && activeModule === 'fichajes') {
                fichajesTableBody.innerHTML = '';

                let fichajesToShow = [];
                if (role === 'Colaborador') {
                    const myFichajes = fichajes.filter(f => f.name && f.name.trim().toLowerCase() === (currentName || '').trim().toLowerCase());
                    // Mostrar los fichajes del colaborador del día de hoy
                    fichajesToShow = myFichajes.filter(f => isFichajeToday(f.date, f.timestamp));
                } else {
                    fichajesToShow = fichajes.filter(f => {
                        if (filterFichajesCollabs.length > 0 && !filterFichajesCollabs.some(fc => fc.trim().toLowerCase() === (f.name || '').trim().toLowerCase())) {
                            return false;
                        }
                        if (filterFichajesDesdeVal && f.date < filterFichajesDesdeVal) {
                            return false;
                        }
                        if (filterFichajesHastaVal && f.date > filterFichajesHastaVal) {
                            return false;
                        }
                        return true;
                    });
                }

                const fichajesTitleEl = document.getElementById('fichajesTitle');
                if (fichajesTitleEl) fichajesTitleEl.textContent = role === 'Colaborador' ? 'Fichaje de hoy' : 'Historial de Asistencia y Fichajes';

                if (fichajesToShow.length === 0) {
                    const emptyMsg = role === 'Colaborador' ? 'No hay fichajes registrados el día de hoy.' : 'No hay fichajes registrados.';
                    fichajesTableBody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:var(--text-muted); padding:20px;">${emptyMsg}</td></tr>`;
                } else {
                    fichajesToShow.forEach(f => {
                        const tr = document.createElement('tr');

                        const nameTd = `<td>${f.name}</td>`;
                        const dateTd = `<td>${formatDateToShort(f.date)}</td>`;
                        const timeTd = `<td>${f.time}</td>`;

                        const typeBadge = f.type === 'Entrada'
                            ? `<span class="badge success" style="background: rgba(46, 204, 113, 0.15); color: #2ecc71; border: 1px solid rgba(46, 204, 113, 0.3); padding: 4px 8px; border-radius: 4px; font-weight:600;">Entrada</span>`
                            : `<span class="badge danger" style="background: rgba(231, 76, 60, 0.15); color: #e74c3c; border: 1px solid rgba(231, 76, 60, 0.3); padding: 4px 8px; border-radius: 4px; font-weight:600;">Salida</span>`;

                        const typeTd = `<td>${typeBadge}</td>`;

                        let gpsIcon = `<span class="gps-badge manual" title="Ingreso manual por el administrador">📌 Manual</span>`;
                        if (f.gps && f.gps.verified) {
                            gpsIcon = `<span class="gps-badge verified" title="Verificado por GPS: ${f.gps.lat}, ${f.gps.lng}">📍 Verificado</span>`;
                        }
                        const gpsTd = `<td>${gpsIcon}</td>`;

                        const actionTd = role === 'Administrador'
                            ? `<td data-label="Acciones">
                                <button class="btn-editar-fichaje" onclick="editFichaje('${f.id}')">Editar</button>
                                <button class="btn-eliminar-fichaje" style="margin-left: 5px;" onclick="deleteFichaje('${f.id}')">Eliminar</button>
                               </td>`
                            : '';

                        tr.innerHTML = `
                            ${nameTd}
                            ${dateTd}
                            ${timeTd}
                            ${typeTd}
                            ${gpsTd}
                            ${actionTd}
                        `;
                        fichajesTableBody.appendChild(tr);
                    });
                }
            }

            // --- F. LIQUIDACIÓN DE JORNALES (ADMIN ONLY) ---
            if (role === 'Administrador' && activeModule === 'jornales') {
                renderJornalesTable();
            }
            if (activeModule === 'pdt' || activeModule === 'database' || activeModule === 'dashboard') {
                populateWorksheetAddressDropdown();
                populateWorksheetWeekDropdown();
                if (typeof populateWorksheetAuthorDropdown === "function") populateWorksheetAuthorDropdown();
                renderWorksheetsTable();
            }
            
            // Refrescar calendario si ya está inicializado y visible
            if (activeModule === 'calendario' && typeof initGoogleCalendar === 'function') {
                const modCal = document.getElementById('mod-calendario');
                if (modCal && !modCal.classList.contains('hidden')) {
                    initGoogleCalendar();
                }
            }
        }

        // Renderizar cuadrícula de colaboradores en pestaña admin con botones de editar y eliminar
        function renderCollaboratorsGrid() {
            collaboratorsGridContainer.innerHTML = '';
            colaboradores.forEach(c => {
                const card = document.createElement('div');
                card.className = 'collab-card';

                const initials = c.name.split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();
                const isOnline = isCollabOnline(c.name);
                const statusClass = isOnline ? '' : 'offline';
                const statusText = isOnline ? 'Activo en Turno' : 'Fuera de Turno';

                // No permitir que el admin se elimine a sí mismo
                const isSelf = c.username === localStorage.getItem('electrofrio_user');
                const actionButtons = `
                    <div style="display:flex; gap:10px; margin-top:15px; width:100%;">
                        <button class="save-btn" style="flex:1; margin:0; padding:8px 6px; font-size:12px; background-color:var(--border-color); color:var(--text-primary); border:1px solid var(--border-color);" onclick="editCollaborator('${c.username}')">Editar</button>
                        ${!isSelf ? `<button class="save-btn" style="flex:1; margin:0; padding:8px 6px; font-size:12px; background-color:rgba(255, 59, 48, 0.1); color:var(--color-red); border:1px solid rgba(255, 59, 48, 0.3);" onclick="deleteCollaborator('${c.username}')">Eliminar</button>` : ''}
                    </div>
                `;

                const premiumBadge = c.premium ? `
                    <span style="font-size:10px; background-color:rgba(247, 208, 2, 0.15); color:var(--color-yellow); border: 1px solid rgba(247, 208, 2, 0.3); padding:2px 8px; border-radius:12px; margin-top:5px; font-weight:700; letter-spacing: 0.5px;">PREMIUM</span>
                ` : '';

                card.innerHTML = `
                    <div class="collab-avatar">${initials}</div>
                    <span class="collab-name">${c.name}</span>
                    <span class="collab-role">${c.role}</span>
                    ${premiumBadge}
                    <span class="collab-status ${statusClass}"><span class="status-dot"></span>${statusText}</span>
                    ${actionButtons}
                `;
                collaboratorsGridContainer.appendChild(card);
            });
        }

        // Editar Colaborador
        function editCollaborator(username) {
            const collab = colaboradores.find(c => c.username === username);
            if (collab) {
                editUsernameMode = username;

                // Cambiar títulos del modal
                document.querySelector('#modalNuevoColaborador .modal-title').innerHTML = `
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px;"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
                    Editar Colaborador
                `;
                document.querySelector('#modalNuevoColaborador button[type="submit"]').textContent = "Guardar Cambios";

                // Rellenar campos
                document.getElementById('collab-fullname').value = collab.name;
                document.getElementById('collab-username').value = collab.username;
                document.getElementById('collab-username').disabled = true; // No permitir cambiar username para no perder relación
                document.getElementById('collab-password').value = collab.password;
                document.getElementById('collab-hourlyrate').value = collab.hourlyRate;
                document.getElementById('collab-role').value = collab.role;
                document.getElementById('collab-premium').checked = !!collab.premium;
                document.getElementById('collab-gpslat').value = (collab.gps && collab.gps.lat) ? collab.gps.lat : '';
                document.getElementById('collab-gpslng').value = (collab.gps && collab.gps.lng) ? collab.gps.lng : '';
                document.getElementById('collab-gpsradius').value = (collab.gps && collab.gps.radius && collab.gps.radius !== 700) ? collab.gps.radius : 30;

                modalNuevoColaborador.classList.add('show');
            }
        }

        // Eliminar Colaborador
        async function deleteCollaborator(username) {
            if (confirm(`¿Estás seguro de que deseas eliminar al colaborador con usuario "${username}"?`)) {
                const collab = colaboradores.find(c => c.username === username);
                if (collab && collab.uid) {
                    try {
                        await db.collection('usuarios').doc(collab.uid).delete();
                        alert('Colaborador eliminado exitosamente de la nube.');
                    } catch (error) {
                        console.error("Error al eliminar colaborador de Firestore: ", error);
                        alert("Error al eliminar colaborador: " + error.message);
                    }
                } else {
                    // Si por alguna razón no tiene UID en la nube, lo eliminamos localmente
                    colaboradores = colaboradores.filter(c => c.username !== username);
                    localStorage.setItem('electrofrio_collaborators', JSON.stringify(colaboradores));
                    updateTablesAndViews();
                    alert('Colaborador eliminado localmente.');
                }
            }
        }

        // --- CONTROL DIARIO DE ASISTENCIA (ADMIN) ---
        let todayAttendanceFilter = 'all';
        let dailyAttendanceSelectedDate = '';

        window.toggleTodayAttendanceCard = function () {
            const card = document.getElementById('todayAttendanceCard');
            const label = document.getElementById('labelToggleTodayAttendance');
            if (!card) return;

            const isCollapsed = card.classList.toggle('is-collapsed');
            if (label) {
                label.textContent = isCollapsed ? 'Mostrar Tabla' : 'Ocultar Tabla';
            }
            localStorage.setItem('electrofrio_daily_attendance_collapsed', isCollapsed ? 'true' : 'false');
        };

        window.changeDailyAttendanceDate = function (newDateVal) {
            dailyAttendanceSelectedDate = newDateVal || getLocalISODate(getSyncedDate());
            renderTodayAttendanceControl();
        };

        window.navDailyAttendanceDate = function (delta) {
            const now = getSyncedDate();
            const nowISO = getLocalISODate(now);

            if (delta === 0) {
                dailyAttendanceSelectedDate = nowISO;
            } else {
                const baseDateStr = dailyAttendanceSelectedDate || nowISO;
                const [y, m, d] = baseDateStr.split('-').map(Number);
                const dateObj = new Date(y, m - 1, d, 12, 0, 0);
                dateObj.setDate(dateObj.getDate() + delta);
                dailyAttendanceSelectedDate = getLocalISODate(dateObj);
            }

            const inputDate = document.getElementById('inputDailyAttendanceDate');
            if (inputDate) {
                inputDate.value = dailyAttendanceSelectedDate;
            }

            renderTodayAttendanceControl();
        };

        window.filterTodayAttendance = function (filterKey) {
            todayAttendanceFilter = filterKey;

            // Actualizar clases activas en los pills
            const pills = document.querySelectorAll('.today-filter-pill');
            pills.forEach(p => p.classList.remove('active'));

            if (filterKey === 'all') document.getElementById('pillTodayAll')?.classList.add('active');
            if (filterKey === 'did_fichar') document.getElementById('pillTodayDidFichar')?.classList.add('active');
            if (filterKey === 'did_not_fichar') document.getElementById('pillTodayDidNotFichar')?.classList.add('active');
            if (filterKey === 'missing_in') document.getElementById('pillTodayMissingIn')?.classList.add('active');
            if (filterKey === 'missing_out') document.getElementById('pillTodayMissingOut')?.classList.add('active');
            if (filterKey === 'complete') document.getElementById('pillTodayComplete')?.classList.add('active');

            renderTodayAttendanceControl();
        };

        function updateFichajeGpsUI() {
            const select = document.getElementById('fichaje-gps-status');
            if (select) {
                select.value = 'manual';
            }
            const optVerified = document.getElementById('fichaje-gps-opt-verified');
            if (optVerified) {
                optVerified.remove();
            }
        }
        updateFichajeGpsUI();

        window.openModalFichajeForCollab = function (collabName, defaultType = 'Entrada', targetDate = null) {
            editFichajeId = null;
            const modalFichaje = document.getElementById('modalFichaje');
            const formFichaje = document.getElementById('formFichaje');
            if (!modalFichaje) return;

            if (formFichaje) formFichaje.reset();

            document.getElementById('modalFichajeHeaderText').textContent = "Registrar Fichaje Manual";
            const submitBtn = document.querySelector('#modalFichaje button[type="submit"]');
            if (submitBtn) submitBtn.textContent = "Registrar Fichaje";

            // Mostrar select de colaboradores y ocultar input de lectura
            const groupSelect = document.getElementById('fichajeCollabGroup');
            const groupRead = document.getElementById('fichajeCollabNameGroup');
            const collabSelect = document.getElementById('fichaje-collab');
            if (groupSelect) groupSelect.style.display = 'block';
            if (groupRead) groupRead.style.display = 'none';
            if (collabSelect) {
                collabSelect.required = true;
                populateFichajeCollabsDropdown();
                if (collabName) {
                    collabSelect.value = collabName;
                }
            }

            // Autocompletar con fecha seleccionada o actual
            const now = getSyncedDate();
            const dateToSet = targetDate || dailyAttendanceSelectedDate || getLocalISODate(now);
            const dateInput = document.getElementById('fichaje-date');
            if (dateInput) dateInput.value = dateToSet;

            const timeInput = document.getElementById('fichaje-time');
            if (timeInput) {
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                timeInput.value = `${hours}:${minutes}`;
            }

            if (typeof setFichajeType === 'function') {
                setFichajeType(defaultType || 'Entrada');
            }
            const errorEl = document.getElementById('fichajeTypeError');
            if (errorEl) errorEl.style.display = 'none';
            const selectorEl = document.getElementById('fichajeTypeSelector');
            if (selectorEl) selectorEl.classList.remove('has-error');

            updateFichajeGpsUI();

            modalFichaje.classList.add('show');
        };

        function renderTodayAttendanceControl() {
            const tableBody = document.getElementById('todayAttendanceTableBody');
            const dateLabel = document.getElementById('todayAttendanceDateLabel');
            const titleEl = document.getElementById('todayAttendanceTitle');
            const kpiChips = document.getElementById('todayAttendanceKpiChips');
            const inputDate = document.getElementById('inputDailyAttendanceDate');
            const card = document.getElementById('todayAttendanceCard');
            const labelToggle = document.getElementById('labelToggleTodayAttendance');
            if (!tableBody) return;

            // Iniciar siempre oculta/colapsada por defecto
            if (card && !card.dataset.initCollapsed) {
                card.dataset.initCollapsed = 'true';
                card.classList.add('is-collapsed');
                if (labelToggle) labelToggle.textContent = 'Mostrar Tabla';
            }

            const now = getSyncedDate();
            const nowISO = getLocalISODate(now);

            if (!dailyAttendanceSelectedDate) {
                dailyAttendanceSelectedDate = nowISO;
            }

            const selectedISO = dailyAttendanceSelectedDate;
            if (inputDate && inputDate.value !== selectedISO) {
                inputDate.value = selectedISO;
            }

            const [sY, sM, sD] = selectedISO.split('-');
            const selectedAR_full = `${sD}/${sM}/${sY}`;
            const selectedAR_short = `${parseInt(sD, 10)}/${parseInt(sM, 10)}/${sY}`;
            const isToday = selectedISO === nowISO;

            if (dateLabel) {
                try {
                    const parsedDate = new Date(parseInt(sY, 10), parseInt(sM, 10) - 1, parseInt(sD, 10), 12, 0, 0);
                    const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
                    const formattedDate = parsedDate.toLocaleDateString('es-AR', options);
                    const capDate = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1);
                    dateLabel.textContent = isToday ? `Hoy - ${capDate}` : `${capDate} (Histórico Diario)`;
                } catch (e) {
                    dateLabel.textContent = isToday ? `Hoy - ${selectedAR_full}` : `${selectedAR_full} (Histórico Diario)`;
                }
            }

            // Helper para identificar fichajes de la fecha seleccionada
            const isFichajeDateSelected = (fDate, fTimestamp) => {
                if (!fDate && !fTimestamp) return false;
                if (isToday && fDate === 'Hoy') return true;
                if (fDate === selectedISO || fDate === selectedAR_full || fDate === selectedAR_short) return true;
                if (fDate && formatDateToShort(fDate) === formatDateToShort(selectedISO)) return true;
                if (fTimestamp) {
                    try {
                        const tDate = new Date(fTimestamp);
                        if (!isNaN(tDate.getTime())) {
                            const tISO = getLocalISODate(tDate);
                            if (tISO === selectedISO) return true;
                        }
                    } catch (e) {}
                }
                return false;
            };

            // Filtrar colaboradores que deben fichar (role === 'Colaborador' o colaboradores registrados)
            let targetCollabs = colaboradores.filter(c => c.role === 'Colaborador');
            if (targetCollabs.length === 0) {
                targetCollabs = colaboradores;
            }

            let countDidFichar = 0;
            let countDidNotFichar = 0;
            let countMissingIn = 0;
            let countMissingOut = 0;
            let countComplete = 0;

            const analyzedList = targetCollabs.map(collab => {
                const myFichajesOnDate = fichajes.filter(f => {
                    const nameMatch = (f.name && f.name.trim().toLowerCase() === (collab.name || '').trim().toLowerCase()) ||
                                      (f.username && collab.username && f.username.trim().toLowerCase() === collab.username.trim().toLowerCase());
                    return nameMatch && isFichajeDateSelected(f.date, f.timestamp);
                });

                // Ordenar por hora / timestamp cronológicamente
                myFichajesOnDate.sort((a, b) => {
                    const tsA = a.timestamp ? new Date(a.timestamp).getTime() : 0;
                    const tsB = b.timestamp ? new Date(b.timestamp).getTime() : 0;
                    if (tsA !== tsB) return tsA - tsB;
                    return (a.time || '').localeCompare(b.time || '');
                });

                const entradas = myFichajesOnDate.filter(f => f.type === 'Entrada');
                const salidas = myFichajesOnDate.filter(f => f.type === 'Salida');

                const didFichar = myFichajesOnDate.length > 0;
                const hasEntrada = entradas.length > 0;
                const hasSalida = salidas.length > 0;
                const firstEntrada = hasEntrada ? entradas[0] : null;
                const lastSalida = hasSalida ? salidas[salidas.length - 1] : null;
                const latestFichaje = didFichar ? myFichajesOnDate[myFichajesOnDate.length - 1] : null;

                let category = ''; // 'did_not_fichar', 'missing_out', 'missing_in', 'complete'
                let statusBadge = '';
                let quickActionHtml = '';
                const safeName = (collab.name || '').replace(/'/g, "\\'");

                if (!didFichar) {
                    // No fichó en todo el día
                    category = 'did_not_fichar';
                    countDidNotFichar++;
                    countMissingIn++;
                    statusBadge = `<span class="today-badge-missing-in">🔴 NO Fichó (Ausente)</span>`;
                    quickActionHtml = `<button class="btn-quick-in" onclick="openModalFichajeForCollab('${safeName}', 'Entrada', '${selectedISO}')">+ Fichar Entrada</button>`;
                } else {
                    countDidFichar++;

                    if (hasEntrada && !hasSalida) {
                        // Fichó entrada pero falta salida
                        category = 'missing_out';
                        countMissingOut++;
                        statusBadge = `<span class="today-badge-missing-out">🟡 En Turno (Falta Salida)</span>`;
                        quickActionHtml = `<button class="btn-quick-out" onclick="openModalFichajeForCollab('${safeName}', 'Salida', '${selectedISO}')">+ Fichar Salida</button>`;
                    } else if (!hasEntrada && hasSalida) {
                        // Salida sin entrada registrada
                        category = 'missing_in';
                        countMissingIn++;
                        statusBadge = `<span class="today-badge-missing-in">🟠 Falta Entrada</span>`;
                        quickActionHtml = `<button class="btn-quick-in" onclick="openModalFichajeForCollab('${safeName}', 'Entrada', '${selectedISO}')">+ Fichar Entrada</button>`;
                    } else {
                        // Tiene entrada y salida
                        if (latestFichaje && latestFichaje.type === 'Entrada') {
                            // Reingresó y falta salida
                            category = 'missing_out';
                            countMissingOut++;
                            statusBadge = `<span class="today-badge-missing-out">🟡 En Turno (Falta Salida)</span>`;
                            quickActionHtml = `<button class="btn-quick-out" onclick="openModalFichajeForCollab('${safeName}', 'Salida', '${selectedISO}')">+ Fichar Salida</button>`;
                        } else {
                            // Jornada completa
                            category = 'complete';
                            countComplete++;
                            statusBadge = `<span class="today-badge-success">🟢 Jornada Completa</span>`;
                            quickActionHtml = `<button class="btn-editar-fichaje" style="font-size:11px; padding:4px 8px;" onclick="openModalFichajeForCollab('${safeName}', 'Salida', '${selectedISO}')">+ Fichaje</button>`;
                        }
                    }
                }

                return {
                    collab,
                    didFichar,
                    hasEntrada,
                    hasSalida,
                    firstEntrada,
                    lastSalida,
                    latestFichaje,
                    category,
                    statusBadge,
                    quickActionHtml
                };
            });

            // Actualizar contadores en la interfaz
            const countAllEl = document.getElementById('countTodayAll');
            const countDidFicharEl = document.getElementById('countTodayDidFichar');
            const countDidNotFicharEl = document.getElementById('countTodayDidNotFichar');
            const countMissingInEl = document.getElementById('countTodayMissingIn');
            const countMissingOutEl = document.getElementById('countTodayMissingOut');
            const countCompleteEl = document.getElementById('countTodayComplete');

            if (countAllEl) countAllEl.textContent = targetCollabs.length;
            if (countDidFicharEl) countDidFicharEl.textContent = countDidFichar;
            if (countDidNotFicharEl) countDidNotFicharEl.textContent = countDidNotFichar;
            if (countMissingInEl) countMissingInEl.textContent = countMissingIn;
            if (countMissingOutEl) countMissingOutEl.textContent = countMissingOut;
            if (countCompleteEl) countCompleteEl.textContent = countComplete;

            if (kpiChips) {
                kpiChips.innerHTML = `
                    <div class="today-kpi-chip chip-total" title="Total de colaboradores">
                        <span>👥 Total:</span> <strong>${targetCollabs.length}</strong>
                    </div>
                    <div class="today-kpi-chip chip-complete" title="Colaboradores que registraron al menos un fichaje">
                        <span>🟢 Ficharon:</span> <strong>${countDidFichar}</strong>
                    </div>
                    <div class="today-kpi-chip chip-missing-in" title="Colaboradores sin ningún fichaje en este día">
                        <span>🔴 Sin Fichar:</span> <strong>${countDidNotFichar}</strong>
                    </div>
                    <div class="today-kpi-chip chip-missing-out" title="Colaboradores con entrada pero sin salida">
                        <span>🟡 Falta Salida:</span> <strong>${countMissingOut}</strong>
                    </div>
                `;
            }

            // Filtrar lista según el filtro activo
            let filteredList = analyzedList;
            if (todayAttendanceFilter === 'did_fichar') {
                filteredList = analyzedList.filter(item => item.didFichar);
            } else if (todayAttendanceFilter === 'did_not_fichar') {
                filteredList = analyzedList.filter(item => !item.didFichar);
            } else if (todayAttendanceFilter === 'missing_in') {
                filteredList = analyzedList.filter(item => !item.hasEntrada);
            } else if (todayAttendanceFilter === 'missing_out') {
                filteredList = analyzedList.filter(item => item.hasEntrada && (!item.hasSalida || item.latestFichaje?.type === 'Entrada'));
            } else if (todayAttendanceFilter === 'complete') {
                filteredList = analyzedList.filter(item => item.category === 'complete');
            }

            tableBody.innerHTML = '';

            if (filteredList.length === 0) {
                tableBody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:var(--text-muted); padding:20px;">No hay colaboradores en este filtro para la fecha seleccionada.</td></tr>`;
                return;
            }

            filteredList.forEach(item => {
                const tr = document.createElement('tr');
                const initials = (item.collab.name || '??').split(' ').map(n => n[0]).join('').substring(0, 2).toUpperCase();

                // Colaborador TD
                const collabTd = `
                    <td>
                        <div class="today-collab-info">
                            <div class="today-collab-avatar">${initials}</div>
                            <div>
                                <strong style="color:var(--text-primary); font-size:13px;">${item.collab.name}</strong>
                                ${item.collab.username ? `<div style="color:var(--text-muted); font-size:11px;">@${item.collab.username}</div>` : ''}
                            </div>
                        </div>
                    </td>
                `;

                // Entrada TD
                let entradaTd = '';
                if (item.firstEntrada) {
                    const gpsIcon = (item.firstEntrada.gps && item.firstEntrada.gps.verified) ? '📍' : '📌';
                    entradaTd = `
                        <td>
                            <span class="today-badge-success" title="Registrado: ${item.firstEntrada.time} (${gpsIcon === '📍' ? 'GPS Verificado' : 'Manual'})">
                                ${gpsIcon} ${item.firstEntrada.time}
                            </span>
                        </td>
                    `;
                } else {
                    entradaTd = `<td><span class="today-badge-missing-in">⚠️ Falta Entrada</span></td>`;
                }

                // Salida TD
                let salidaTd = '';
                if (item.lastSalida) {
                    const gpsIcon = (item.lastSalida.gps && item.lastSalida.gps.verified) ? '📍' : '📌';
                    salidaTd = `
                        <td>
                            <span class="today-badge-success" title="Registrado: ${item.lastSalida.time} (${gpsIcon === '📍' ? 'GPS Verificado' : 'Manual'})">
                                ${gpsIcon} ${item.lastSalida.time}
                            </span>
                        </td>
                    `;
                } else if (item.hasEntrada) {
                    salidaTd = `<td><span class="today-badge-missing-out">⏳ Falta Salida</span></td>`;
                } else {
                    salidaTd = `<td><span class="today-badge-none">❌ Sin Fichar</span></td>`;
                }

                // Estado TD
                const statusTd = `<td>${item.statusBadge}</td>`;

                // Acción Rápida TD
                const actionTd = `<td style="text-align: right;">${item.quickActionHtml}</td>`;

                tr.innerHTML = `${collabTd}${entradaTd}${salidaTd}${statusTd}${actionTd}`;
                tableBody.appendChild(tr);
            });
        }

        // Renderizar lista de filtros de colaboradores en Fichajes (Admin)
        function renderFichajesFilterCollabs() {
            const container = document.getElementById('fichajesCollabFilterList');
            if (!container) return;

            const names = colaboradores.filter(c => c.role === 'Colaborador').map(c => c.name);

            if (names.length === 0) {
                container.innerHTML = '<span style="color:var(--text-muted); font-size:12px;">No hay colaboradores</span>';
                return;
            }

            let html = `
                <label>
                    <input type="checkbox" id="fichajesCollabAll" checked>
                    <i>Todos</i>
                </label>
            `;

            names.forEach(name => {
                const isChecked = filterFichajesCollabs.length === 0 || filterFichajesCollabs.includes(name);
                html += `
                    <label>
                        <input type="checkbox" class="fichajes-collab-check" value="${name}" ${isChecked ? 'checked' : ''}>
                        <span>${name}</span>
                    </label>
                `;
            });

            container.innerHTML = html;

            const checkAll = document.getElementById('fichajesCollabAll');
            const checks = container.querySelectorAll('.fichajes-collab-check');

            if (checkAll) {
                checkAll.addEventListener('change', () => {
                    checks.forEach(c => c.checked = checkAll.checked);
                });
            }

            checks.forEach(c => {
                c.addEventListener('change', () => {
                    if (!c.checked && checkAll) {
                        checkAll.checked = false;
                    } else if (Array.from(checks).every(ch => ch.checked) && checkAll) {
                        checkAll.checked = true;
                    }
                });
            });
        }

        // --- MÓDULO JORNALES: Modularizado e integrado en jornales.html vía iframe ---
        function renderJornalesFilterCollabs() {}
        function renderJornalesTable() {}

        // Formatear YYYY-MM-DD a D/M/YYYY
        function formatDateToShort(dateStr) {
            if (!dateStr || !dateStr.includes('-')) return dateStr;
            const [year, month, day] = dateStr.split('-');
            return `${parseInt(day)}/${parseInt(month)}/${year}`;
        }

        // Formatear Hora de Date a 12h AM/PM
        function formatTime12h(date) {
            let hours = date.getHours();
            let minutes = date.getMinutes();
            const ampm = hours >= 12 ? 'p. m.' : 'a. m.';
            hours = hours % 12;
            hours = hours ? hours : 12;
            minutes = minutes < 10 ? '0' + minutes : minutes;
            return `${hours}:${minutes} ${ampm}`;
        }

        // Formatear de HH:MM (24h) a 12h AM/PM
        function formatTime24hTo12h(time24) {
            if (!time24 || !time24.includes(':')) return time24;
            const [hStr, mStr] = time24.split(':');
            let hours = parseInt(hStr);
            const minutes = mStr;
            const ampm = hours >= 12 ? 'p. m.' : 'a. m.';
            hours = hours % 12;
            hours = hours ? hours : 12;
            return `${hours}:${minutes} ${ampm}`;
        }

        // Convertir de 12h AM/PM a 24h HH:MM (para rellenar los inputs al editar)
        function formatTime12hTo24h(time12) {
            if (!time12 || !time12.includes(':')) return time12;
            const [timePart, ampmPart] = time12.split(' ');
            if (!timePart) return time12;
            const [hStr, mStr] = timePart.split(':');
            let hours = parseInt(hStr);

            const isPM = ampmPart && ampmPart.toLowerCase().includes('p');
            if (isPM && hours < 12) hours += 12;
            if (!isPM && hours === 12) hours = 0;

            const hFormatted = String(hours).padStart(2, '0');
            const mFormatted = String(mStr).padStart(2, '0');
            return `${hFormatted}:${mFormatted}`;
        }

        // Formatear fecha del día en es-AR
        function getTodayString() {
            const now = getSyncedDate();
            const d = String(now.getDate()).padStart(2, '0');
            const m = String(now.getMonth() + 1).padStart(2, '0');
            const y = now.getFullYear();
            return `${d}/${m}/${y}`;
        }

        // Verificar si un fichaje es del día de hoy
        function isFichajeToday(fDate, fTimestamp) {
            const now = (typeof getSyncedDate === 'function') ? getSyncedDate() : new Date();
            const nowYear = now.getFullYear();
            const nowMonth = now.getMonth();
            const nowDate = now.getDate();

            if (fTimestamp) {
                try {
                    const tDate = new Date(fTimestamp);
                    if (!isNaN(tDate.getTime())) {
                        if (tDate.getFullYear() === nowYear && tDate.getMonth() === nowMonth && tDate.getDate() === nowDate) {
                            return true;
                        }
                    }
                } catch (e) {}
            }

            if (!fDate) return false;
            if (fDate === 'Hoy') return true;

            const yyyy = nowYear;
            const mm = String(nowMonth + 1).padStart(2, '0');
            const dd = String(nowDate).padStart(2, '0');
            const m = String(nowMonth + 1);
            const d = String(nowDate);

            const todayISO = `${yyyy}-${mm}-${dd}`;
            const todayAR = `${dd}/${mm}/${yyyy}`;
            const todayARShort = `${d}/${m}/${yyyy}`;

            if (fDate === todayISO || fDate === todayAR || fDate === todayARShort) return true;

            let clean = fDate;
            if (fDate.includes('-')) {
                const parts = fDate.split('-');
                if (parts.length === 3 && parts[0].length === 4) {
                    clean = `${parseInt(parts[2], 10)}/${parseInt(parts[1], 10)}/${parts[0]}`;
                }
            } else if (fDate.includes('/')) {
                const parts = fDate.split('/');
                if (parts.length === 3) {
                    clean = `${parseInt(parts[0], 10)}/${parseInt(parts[1], 10)}/${parts[2]}`;
                }
            }
            return clean === `${d}/${m}/${yyyy}`;
        }

        // Calcular distancia usando la fórmula de Haversine
        function calculateDistance(lat1, lon1, lat2, lon2) {
            const R = 6371e3; // Radio de la Tierra en metros
            const φ1 = lat1 * Math.PI / 180;
            const φ2 = lat2 * Math.PI / 180;
            const Δφ = (lat2 - lat1) * Math.PI / 180;
            const Δλ = (lon2 - lon1) * Math.PI / 180;

            const a = Math.sin(Δφ / 2) * Math.sin(Δφ / 2) +
                Math.cos(φ1) * Math.cos(φ2) *
                Math.sin(Δλ / 2) * Math.sin(Δλ / 2);
            const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

            return R * c; // Distancia en metros
        }

        // Fichaje entrada / salida con Geolocalización (Optimizado para iOS / Safari / Android)
        function verifyGeolocationAndExecute(callback, onRejected) {
            if (!navigator.onLine) {
                showToast("No tienes conexión a internet activa. Por favor, conéctate a la red e intenta nuevamente.", "error");
                if (onRejected) onRejected();
                return;
            }

            const restoreBtn = () => {
                if (onRejected) onRejected();
            };

            const name = localStorage.getItem('electrofrio_name') || "";
            const collab = colaboradores.find(c => c.name && c.name.trim().toLowerCase() === name.trim().toLowerCase());

            const DEFAULT_LAT = -29.418139; // 29°25'05.3"S 66°51'26.3"W
            const DEFAULT_LNG = -66.857306; // 29°25'05.3"S 66°51'26.3"W
            const DEFAULT_RADIUS = 30; // 30 metros a la redonda

            let allowedLat = DEFAULT_LAT;
            let allowedLng = DEFAULT_LNG;
            let allowedRadius = DEFAULT_RADIUS;

            if (collab && collab.gps && collab.gps.lat && collab.gps.lng) {
                const parsedLat = parseFloat(collab.gps.lat);
                const parsedLng = parseFloat(collab.gps.lng);
                allowedLat = (!isNaN(parsedLat) && parsedLat !== 0) ? parsedLat : DEFAULT_LAT;
                allowedLng = (!isNaN(parsedLng) && parsedLng !== 0) ? parsedLng : DEFAULT_LNG;
                const customRadius = parseFloat(collab.gps.radius);
                allowedRadius = (!isNaN(customRadius) && customRadius > 0 && customRadius !== 700) ? customRadius : DEFAULT_RADIUS;
            } else if (collab && collab.gps && collab.gps.radius) {
                const customRadius = parseFloat(collab.gps.radius);
                allowedRadius = (!isNaN(customRadius) && customRadius > 0 && customRadius !== 700) ? customRadius : DEFAULT_RADIUS;
            }

            if (!navigator.geolocation) {
                restoreBtn();
                const msg = "Tu navegador o dispositivo no soporta geolocalización. Por favor ponte en contacto con la administración.";
                showToast(msg, "error");
                alert(msg);
                return;
            }

            // Estrategia de geolocalización de alta precisión para radio de 30 metros (iOS / Safari y Android)
            function requestLocation(options, isRetry = false) {
                navigator.geolocation.getCurrentPosition(
                    (position) => {
                        const userLat = position.coords.latitude;
                        const userLng = position.coords.longitude;
                        const distance = calculateDistance(userLat, userLng, allowedLat, allowedLng);

                        if (distance <= allowedRadius) {
                            callback(collab, userLat, userLng);
                        } else if (!isRetry) {
                            // Si la primera lectura da fuera del rango de 30m (frecuente por triangulación celular o wifi), forzar lectura del chip GPS satelital
                            console.warn(`Distancia inicial (${Math.round(distance)}m) supera ${allowedRadius}m. Reintentando con GPS satelital de alta precisión...`);
                            requestLocation({ enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }, true);
                        } else {
                            restoreBtn();
                            const msg = `No estás en el lugar autorizado para tomar el fichaje (estás a ${Math.round(distance)}m). El rango permitido es de ${allowedRadius} metros a la redonda. Por favor ponte en contacto con la administración ya que no se registrará tu fichaje.`;
                            showToast(msg, "error");
                            alert(msg);
                        }
                    },
                    (error) => {
                        // Si el primer intento falla en iOS/Android por timeout o falta de señal inicial, reintentar
                        if (!isRetry && (error.code === 2 || error.code === 3)) {
                            console.warn("Reintentando lectura GPS para dispositivo móvil...");
                            requestLocation({ enableHighAccuracy: true, timeout: 12000, maximumAge: 0 }, true);
                            return;
                        }

                        restoreBtn();
                        console.warn("Error de geolocalización:", error);
                        
                        let msg = "No se obtuvo tu ubicación GPS. Por favor ponte en contacto con la administración.";
                        if (error.code === 1) { // PERMISSION_DENIED
                            msg = "Debes permitir el acceso a tu ubicación en tu navegador o dispositivo para poder fichar.";
                        } else if (error.code === 3) { // TIMEOUT
                            msg = "Tiempo de espera agotado para obtener GPS. Por favor verifica que la localización esté activa e intenta al aire libre.";
                        }
                        
                        showToast(msg, "error");
                        alert(msg);
                    },
                    options
                );
            }

            // Intento inicial: alta precisión activada para asegurar exactitud en 30 metros
            requestLocation({
                enableHighAccuracy: true,
                timeout: 10000,
                maximumAge: 5000
            });
        }

        let isPunchingInProgress = false;

        if (btnFicharUnico) {
            btnFicharUnico.addEventListener('click', async () => {
                if (isPunchingInProgress) {
                    console.warn("Fichaje en proceso, ignorando clic repetido.");
                    return;
                }
                isPunchingInProgress = true;

                const name = localStorage.getItem('electrofrio_name') || "";
                const username = localStorage.getItem('electrofrio_user') || "";
                
                // Show loading
                const originalText = btnFicharUnico.textContent;
                btnFicharUnico.textContent = 'Validando...';
                btnFicharUnico.disabled = true;
                btnFicharUnico.style.pointerEvents = 'none';

                try {
                    const now = getSyncedDate();
                    const todayStr = getLocalISODate(now);

                    // 1. Validar primero contra memoria local para respuesta instantánea antirrebote
                    const localToday = (fichajes || []).filter(f => {
                        const matchName = f.name && name && f.name.trim().toLowerCase() === name.trim().toLowerCase();
                        const matchUser = f.username && username && f.username.trim().toLowerCase() === username.trim().toLowerCase();
                        if (!matchName && !matchUser) return false;
                        return f.date === todayStr || isFichajeToday(f.date, f.timestamp);
                    });
                    localToday.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));

                    if (localToday.length > 0) {
                        const lastLocal = localToday[0];
                        const lastLocalTime = new Date(lastLocal.timestamp).getTime();
                        const diffMsLocal = now.getTime() - lastLocalTime;
                        const cooldownMs = 5 * 60 * 1000;

                        if (diffMsLocal >= 0 && diffMsLocal < cooldownMs) {
                            const remainingSec = Math.ceil((cooldownMs - diffMsLocal) / 1000);
                            const remMin = Math.floor(remainingSec / 60);
                            const remSec = remainingSec % 60;
                            const timeText = remMin > 0 ? `${remMin}m ${String(remSec).padStart(2, '0')}s` : `${remSec}s`;
                            const msg = `Debes esperar 5 minutos entre cada fichaje para evitar registros duplicados. Por favor espera ${timeText}.`;
                            showToast(msg, "warning");
                            alert(msg);
                            isPunchingInProgress = false;
                            btnFicharUnico.style.pointerEvents = 'auto';
                            if (typeof updateDashboardStats === 'function') {
                                updateDashboardStats();
                            } else {
                                btnFicharUnico.disabled = false;
                                btnFicharUnico.textContent = originalText;
                            }
                            return;
                        }
                    }

                    // 2. Validar con Firestore
                    const snapshot = await db.collection('fichajes')
                        .where('date', '==', todayStr)
                        .get();
                    
                    const myDocs = [];
                    snapshot.forEach(doc => {
                        const d = doc.data();
                        const matchName = d.name && name && d.name.trim().toLowerCase() === name.trim().toLowerCase();
                        const matchUser = d.username && username && d.username.trim().toLowerCase() === username.trim().toLowerCase();
                        if (matchName || matchUser) myDocs.push(d);
                    });

                    // Fusionar registros de Firebase y locales para asegurar el historial completo
                    const combinedMap = new Map();
                    myDocs.forEach(d => { if (d.timestamp) combinedMap.set(d.timestamp, d); });
                    localToday.forEach(d => { if (d.timestamp) combinedMap.set(d.timestamp, d); });
                    const allTodayPunches = Array.from(combinedMap.values());
                    allTodayPunches.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                    
                    const lastType = allTodayPunches.length > 0 ? allTodayPunches[0].type : 'Salida';
                    let intendedType = (lastType === 'Salida' || allTodayPunches.length === 0) ? 'Entrada' : 'Salida';

                    // Validar límite de máximo 2 Entradas y 2 Salidas por día
                    const entradasHoy = allTodayPunches.filter(d => d.type === 'Entrada').length;
                    const salidasHoy = allTodayPunches.filter(d => d.type === 'Salida').length;

                    // Validar tiempo mínimo de 5 minutos entre fichajes
                    if (allTodayPunches.length > 0) {
                        const lastPunch = allTodayPunches[0];
                        const lastPunchTime = new Date(lastPunch.timestamp).getTime();
                        const nowTime = getSyncedDate().getTime();
                        const diffMs = nowTime - lastPunchTime;
                        const cooldownMs = 5 * 60 * 1000;

                        if (diffMs >= 0 && diffMs < cooldownMs) {
                            const remainingSec = Math.ceil((cooldownMs - diffMs) / 1000);
                            const remMin = Math.floor(remainingSec / 60);
                            const remSec = remainingSec % 60;
                            const timeText = remMin > 0 ? `${remMin}m ${String(remSec).padStart(2, '0')}s` : `${remSec}s`;
                            const msg = `Debes esperar 5 minutos entre cada fichaje para evitar registros duplicados. Por favor espera ${timeText}.`;
                            showToast(msg, "warning");
                            alert(msg);
                            isPunchingInProgress = false;
                            btnFicharUnico.style.pointerEvents = 'auto';
                            if (typeof updateDashboardStats === 'function') {
                                updateDashboardStats();
                            } else {
                                btnFicharUnico.disabled = false;
                                btnFicharUnico.textContent = originalText;
                            }
                            return;
                        }
                    }

                    if (intendedType === 'Entrada' && entradasHoy >= 2) {
                        const msg = "Has alcanzado el límite máximo de 2 entradas registradas el día de hoy.";
                        showToast(msg, "error");
                        alert(msg);
                        isPunchingInProgress = false;
                        btnFicharUnico.style.pointerEvents = 'auto';
                        btnFicharUnico.disabled = true;
                        btnFicharUnico.textContent = 'Límite de Entradas Alcanzado (2/2)';
                        btnFicharUnico.className = 'fichaje-btn in disabled';
                        return;
                    }

                    if (intendedType === 'Salida' && salidasHoy >= 2) {
                        const msg = "Has alcanzado el límite máximo de 2 salidas registradas el día de hoy.";
                        showToast(msg, "error");
                        alert(msg);
                        isPunchingInProgress = false;
                        btnFicharUnico.style.pointerEvents = 'auto';
                        btnFicharUnico.disabled = true;
                        btnFicharUnico.textContent = 'Límite de Salidas Alcanzado (2/2)';
                        btnFicharUnico.className = 'fichaje-btn out disabled';
                        return;
                    }

                    // Check if it matches what the user thought they were clicking
                    if ((originalText === 'Marcar Entrada' && intendedType !== 'Entrada') ||
                        (originalText === 'Marcar Salida' && intendedType !== 'Salida')) {
                        showToast('Tu estado ya fue actualizado por otra vía.', 'error');
                        isPunchingInProgress = false;
                        btnFicharUnico.style.pointerEvents = 'auto';
                        btnFicharUnico.disabled = false;
                        btnFicharUnico.textContent = intendedType === 'Entrada' ? 'Marcar Entrada' : 'Marcar Salida';
                        btnFicharUnico.className = intendedType === 'Entrada' ? 'fichaje-btn in' : 'fichaje-btn out';
                        return;
                    }
                    
                    const resetBtn = () => {
                        isPunchingInProgress = false;
                        btnFicharUnico.style.pointerEvents = 'auto';
                        btnFicharUnico.disabled = false;
                        btnFicharUnico.textContent = intendedType === 'Entrada' ? 'Marcar Entrada' : 'Marcar Salida';
                        btnFicharUnico.className = intendedType === 'Entrada' ? 'fichaje-btn in' : 'fichaje-btn out';
                    };
                    
                    verifyGeolocationAndExecute(async (collab, userLat, userLng) => {
                        try {
                            btnFicharUnico.textContent = 'Guardando...';
                            const punchNow = getSyncedDate();
                            const dateVal = getLocalISODate(punchNow);
                            const timeVal = formatTime12h(punchNow);
                            const timestampStr = punchNow.toISOString();
                            const isVerified = userLat !== null && userLng !== null;

                            const nuevoFichaje = {
                                id: `fichaje-${Date.now()}`,
                                name: name,
                                username: username,
                                date: dateVal,
                                time: timeVal,
                                timestamp: timestampStr,
                                type: intendedType,
                                gps: {
                                    lat: userLat !== null ? userLat : 0,
                                    lng: userLng !== null ? userLng : 0,
                                    verified: isVerified,
                                    manual: !isVerified
                                }
                            };

                            // 1. Guardar localmente con la clave correcta 'electrofrio_fichajes'
                            fichajes.unshift(nuevoFichaje);
                            localStorage.setItem('electrofrio_fichajes', JSON.stringify(fichajes));
                            updateTablesAndViews();

                            // 2. Grabar en Firestore esperando confirmación del servidor
                            const docRef = await db.collection('fichajes').add(nuevoFichaje);
                            nuevoFichaje.id = docRef.id;

                            if (collab && collab.uid) {
                                await db.collection('usuarios').doc(collab.uid).update({ 
                                    status: intendedType === 'Entrada' ? 'online' : 'offline' 
                                }).catch(err => console.warn("Error actualizando status usuario:", err));
                            }

                            localStorage.setItem('electrofrio_fichajes', JSON.stringify(fichajes));
                            updateTablesAndViews();
                            showToast('¡Se registró con éxito!', 'success');
                        } catch (saveError) {
                            console.error("Error al guardar fichaje en Firestore: ", saveError);
                            showToast('Fichaje registrado localmente (se sincronizará).', 'warning');
                        } finally {
                            isPunchingInProgress = false;
                            btnFicharUnico.style.pointerEvents = 'auto';
                        }
                    }, resetBtn);
                } catch (e) {
                    console.error(e);
                    showToast('Error validando el fichaje.', 'error');
                    isPunchingInProgress = false;
                    btnFicharUnico.style.pointerEvents = 'auto';
                    btnFicharUnico.disabled = false;
                    btnFicharUnico.textContent = originalText;
                }
            });
        }

        // --- SISTEMA DE MÓDULOS HORARIOS Y CONTROL DE SUPERPOSICIÓN DE COLABORADORES ---

        const WORK_MODULES_DEF = [
            { id: 1, name: "Módulo 1", start: "08:00", end: "09:30", startMin: 480, endMin: 570 },
            { id: 2, name: "Módulo 2", start: "09:30", end: "11:00", startMin: 570, endMin: 660 },
            { id: 3, name: "Módulo 3", start: "11:00", end: "12:30", startMin: 660, endMin: 750 },
            { id: 4, name: "Módulo 4", start: "13:30", end: "15:00", startMin: 810, endMin: 900 },
            { id: 5, name: "Módulo 5", start: "15:00", end: "16:30", startMin: 900, endMin: 990 },
            { id: 6, name: "Módulo 6", start: "16:30", end: "18:00", startMin: 990, endMin: 1080 }
        ];

        function timeStringToMinutes(tStr) {
            if (!tStr) return 9999;
            const match = String(tStr).match(/(\d{1,2}):(\d{2})/);
            if (!match) return 9999;
            const h = parseInt(match[1], 10);
            const m = parseInt(match[2], 10);
            if (isNaN(h) || isNaN(m)) return 9999;
            return (h * 60) + m;
        }

        function normalizeDateToISO(dStr) {
            if (!dStr) return '';
            dStr = String(dStr).trim();
            if (dStr.includes('/')) {
                const parts = dStr.split('/');
                if (parts.length === 3) {
                    const day = parts[0].padStart(2, '0');
                    const month = parts[1].padStart(2, '0');
                    const year = parts[2].length === 2 ? '20' + parts[2] : parts[2];
                    return `${year}-${month}-${day}`;
                }
            }
            if (dStr.includes('-')) {
                const parts = dStr.split('-');
                if (parts.length === 3) {
                    if (parts[0].length === 4) {
                        return `${parts[0]}-${parts[1].padStart(2, '0')}-${parts[2].padStart(2, '0')}`;
                    }
                    if (parts[2].length === 4) {
                        return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                    }
                }
            }
            return dStr;
        }

        function normalizeCollabName(name) {
            if (!name) return '';
            return name
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "")
                .trim()
                .toLowerCase();
        }

        function checkCollaboratorTimeConflict(collabName, targetDateStr, targetStartStr, targetEndStr, excludeOrderId = null, excludePlanillaId = null) {
            if (!collabName || !targetDateStr || !targetStartStr) return null;

            const targetDateISO = normalizeDateToISO(targetDateStr);
            if (!targetDateISO) return null;

            const targetStartMin = timeStringToMinutes(targetStartStr);
            let targetEndMin = timeStringToMinutes(targetEndStr);
            if (targetEndMin === 9999 || targetEndMin <= targetStartMin) {
                targetEndMin = targetStartMin + 90; // Default: 90 minutos
            }

            const collabNorm = normalizeCollabName(collabName);

            // 1. Revisar en Órdenes de Trabajo activas
            for (const ord of ordenesTrabajo) {
                if (excludeOrderId && ord.id === excludeOrderId) continue;
                if (ord.status === 'Completado' || ord.status === 'Cancelado') continue;
                if (!ord.date || !ord.time) continue;

                const ordDateISO = normalizeDateToISO(ord.date);
                if (ordDateISO !== targetDateISO) continue;

                let assignees = [];
                if (Array.isArray(ord.assignees)) assignees = ord.assignees;
                else if (ord.assignee) assignees = [ord.assignee];

                const isAssigned = assignees.some(a => normalizeCollabName(a) === collabNorm);
                if (!isAssigned) continue;

                const ordStartMin = timeStringToMinutes(ord.time);
                let ordEndMin = timeStringToMinutes(ord.timeEnd || '');
                if (ordEndMin === 9999 || ordEndMin <= ordStartMin) {
                    ordEndMin = ordStartMin + 90;
                }

                // Verificación de intervalo superpuesto
                if (targetStartMin < ordEndMin && targetEndMin > ordStartMin) {
                    const startFmt = ord.time;
                    const endFmt = ord.timeEnd || (ordStartMin + 90 >= 1080 ? '18:00' : '09:30');
                    return {
                        type: 'orden',
                        sourceId: ord.id,
                        timeRange: `${startFmt} a ${endFmt}`,
                        client: ord.client || 'Cliente',
                        date: ord.date
                    };
                }
            }

            // 2. Revisar en Planillas de Trabajo
            for (const p of planillas) {
                if (excludePlanillaId && p.id === excludePlanillaId) continue;
                if (excludeOrderId && p.orderId && p.orderId === excludeOrderId) continue;
                if (p.status === 'Cancelado' || p.status === 'Eliminado') continue;
                if (!p.date) continue;

                const pDateISO = normalizeDateToISO(p.date);
                if (pDateISO !== targetDateISO) continue;

                let techs = [];
                if (Array.isArray(p.technicians)) techs = p.technicians;
                if (p.completedBy) techs = [...techs, ...p.completedBy.split(',').map(s => s.trim())];

                const isAssigned = techs.some(t => normalizeCollabName(t) === collabNorm);
                if (!isAssigned) continue;

                let pStartMin = timeStringToMinutes(p.horaEntrada || '');
                let pEndMin = timeStringToMinutes(p.horaSalida || '');
                if (pStartMin === 9999 && p.timeRange) {
                    const match = p.timeRange.match(/(\d{1,2}:\d{2})/g);
                    if (match && match.length > 0) {
                        pStartMin = timeStringToMinutes(match[0]);
                        if (match.length > 1) pEndMin = timeStringToMinutes(match[1]);
                    }
                }
                if (pStartMin === 9999) continue;
                if (pEndMin === 9999 || pEndMin <= pStartMin) {
                    pEndMin = pStartMin + 90;
                }

                if (targetStartMin < pEndMin && targetEndMin > pStartMin) {
                    const pCode = p.pdtCode || p.id || 'PDT';
                    const startFmt = p.horaEntrada || '08:00';
                    const endFmt = p.horaSalida || '09:30';
                    return {
                        type: 'planilla',
                        sourceId: pCode,
                        timeRange: `${startFmt} a ${endFmt}`,
                        client: p.client || 'Cliente',
                        date: p.date
                    };
                }
            }

            return null;
        }

        window.setOrderModulePreset = function (startTime, endTime, moduleLabel = '', context = 'order') {
            let startInput, endInput;
            if (context === 'order') {
                startInput = document.getElementById('order-time');
                endInput = document.getElementById('order-time-end');
            } else if (context === 'detail') {
                startInput = document.getElementById('detail-time');
                endInput = document.getElementById('detail-time-end');
            } else if (context === 'planilla') {
                startInput = document.getElementById('planilla-hora-entrada');
                endInput = document.getElementById('planilla-hora-salida');
            } else if (context === 'pdig') {
                startInput = document.getElementById('pdig-hora-entrada');
                endInput = document.getElementById('pdig-hora-salida');
            }

            if (startInput) startInput.value = startTime;
            if (endInput) endInput.value = endTime;

            if (context === 'order') {
                updateOrderCollabAvailability();
            } else if (context === 'detail') {
                updateDetailOrderCollabAvailability();
            }
        };

        function updateContainerCollabAvailability(containerId, dateVal, startTimeVal, endTimeVal, excludeOrderId = null, excludePlanillaId = null) {
            const container = document.getElementById(containerId);
            if (!container) return;

            const checkboxes = container.querySelectorAll('input[type="checkbox"]');
            checkboxes.forEach(cb => {
                const collabName = cb.value;
                const parentDiv = cb.closest('div');
                let busyTag = parentDiv ? parentDiv.querySelector('.collab-busy-tag') : null;

                if (!dateVal || !startTimeVal) {
                    cb.disabled = false;
                    if (busyTag) busyTag.remove();
                    return;
                }

                const conflict = checkCollaboratorTimeConflict(collabName, dateVal, startTimeVal, endTimeVal, excludeOrderId, excludePlanillaId);
                if (conflict) {
                    cb.disabled = true;
                    if (cb.checked) {
                        cb.checked = false;
                        showToast(`⚠️ ${collabName} fue desmarcado: ya está asignado el ${formatDateToAR(dateVal)} (${conflict.timeRange} en ${conflict.sourceId})`, 'warning');
                    }
                    if (!busyTag && parentDiv) {
                        const span = document.createElement('span');
                        span.className = 'collab-busy-tag';
                        span.innerHTML = `⛔ Ocupado (${conflict.timeRange})`;
                        span.title = `Asignado en ${conflict.sourceId} - ${conflict.client}`;
                        parentDiv.appendChild(span);
                    } else if (busyTag) {
                        busyTag.innerHTML = `⛔ Ocupado (${conflict.timeRange})`;
                        busyTag.title = `Asignado en ${conflict.sourceId} - ${conflict.client}`;
                    }
                } else {
                    cb.disabled = false;
                    if (busyTag) busyTag.remove();
                }
            });
        }

        function updateOrderCollabAvailability() {
            const dateVal = document.getElementById('order-date') ? document.getElementById('order-date').value : '';
            const startVal = document.getElementById('order-time') ? document.getElementById('order-time').value : '';
            const endVal = document.getElementById('order-time-end') ? document.getElementById('order-time-end').value : '';
            updateContainerCollabAvailability('order-assignees-checkboxes', dateVal, startVal, endVal, null, null);
        }

