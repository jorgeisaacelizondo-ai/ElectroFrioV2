            <!-- BANNER RECORDATORIO BACKUP SEMANAL -->
            <div id="bannerAlertaBackupSemanal" style="display: none; background: linear-gradient(90deg, #16243d 0%, #1e3656 100%); border-bottom: 2px solid var(--color-blue); padding: 12px 24px; justify-content: space-between; align-items: center; gap: 15px; position: sticky; top: 0; z-index: 999; box-shadow: 0 4px 15px rgba(0,0,0,0.35);">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <span style="font-size: 22px;">🛡️</span>
                    <div>
                        <span style="font-size: 13px; font-weight: 700; color: #ffffff;">Copia de Seguridad Semanal:</span>
                        <span id="bannerAlertaBackupTexto" style="font-size: 13px; color: var(--text-secondary); margin-left: 6px;">Han pasado más de 7 días desde tu última copia de seguridad.</span>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 10px; flex-shrink: 0;">
                    <button type="button" onclick="exportarBackupCompleto()" style="padding: 7px 16px; background: var(--color-blue); color: #000; border: none; border-radius: 8px; font-weight: 700; font-size: 12px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 2px 8px rgba(0,191,255,0.3);">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                        Descargar Backup Ahora
                    </button>
                    <button type="button" onclick="posponerAlertaBackup()" title="Recordar mañana" style="padding: 7px 12px; background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); border-radius: 8px; font-size: 12px; cursor: pointer;">
                        Posponer
                    </button>
                    <button type="button" onclick="document.getElementById('bannerAlertaBackupSemanal').style.display='none'" style="background: none; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer; padding: 0 6px; line-height: 1;">&times;</button>
                </div>
            </div>

