        // Habilitar persistencia offline con sincronización entre pestañas para evitar descargas repetidas
        db.enablePersistence({ synchronizeTabs: true }).catch(err => {
            if (err.code === 'failed-precondition') {
                console.warn("Persistencia: Otra pestaña no soporta concurrencia.");
            } else if (err.code === 'unimplemented') {
                console.warn("Persistencia: Navegador sin soporte de IndexedDB.");
            }
        });

        // Re-sincronizar Firestore de forma inmediata al volver al primer plano (wake up en celular)
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible') {
                console.log("Aplicación volvió al primer plano. Reconectando Firestore...");
                db.disableNetwork().then(() => {
                    return db.enableNetwork();
                }).then(() => {
                    console.log("Firestore reconectado e interactivo de inmediato.");
                }).catch(err => {
                    console.error("Error al forzar reconexión rápida:", err);
                });
            }
        });

        // Sincronización horaria con el servidor
        let timeOffset = 0;

        async function syncTimeWithServer() {
            try {
                const start = Date.now();
                const response = await fetch(window.location.href.split('?')[0] + '?t=' + Date.now(), { method: 'HEAD' });
                const end = Date.now();
                const latency = (end - start) / 2;

                const serverDateHeader = response.headers.get('Date');
                if (serverDateHeader) {
                    const serverTime = new Date(serverDateHeader).getTime() + latency;
                    timeOffset = serverTime - end;
                    console.log(`[Sincronización Horaria] Desfase: ${timeOffset}ms, Latencia: ${latency}ms`);
                }
            } catch (err) {
                console.error("[Sincronización Horaria] Error al sincronizar con el servidor:", err);
            }
        }
        function getSyncedDate() {
            return new Date(Date.now() + timeOffset);
        }

        // Helper para obtener fecha local en formato YYYY-MM-DD
        function getLocalISODate(dateObj) {
            const yyyy = dateObj.getFullYear();
            const mm = String(dateObj.getMonth() + 1).padStart(2, '0');
            const dd = String(dateObj.getDate()).padStart(2, '0');
            return `${yyyy}-${mm}-${dd}`;
        }


        // Ejecutar sincronización al inicio y cada 5 minutos
        syncTimeWithServer();
        setInterval(syncTimeWithServer, 300000);

