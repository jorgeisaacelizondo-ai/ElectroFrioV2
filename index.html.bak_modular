        // Funciones del Tema (Modo Claro / Oscuro)
        function updateThemeUI(isLight) {
            const body = document.body;
            const themeToggleBtn = document.getElementById('themeToggleBtn');
            const moonIcons = document.querySelectorAll('#themeToggleBtn .moon-icon');
            const sunIcons = document.querySelectorAll('#themeToggleBtn .sun-icon');
            
            if (isLight) {
                body.classList.add('light-mode');
                if (themeToggleBtn) themeToggleBtn.title = "Modo oscuro";
                moonIcons.forEach(el => el.classList.add('hidden'));
                sunIcons.forEach(el => el.classList.remove('hidden'));
            } else {
                body.classList.remove('light-mode');
                if (themeToggleBtn) themeToggleBtn.title = "Modo claro";
                moonIcons.forEach(el => el.classList.remove('hidden'));
                sunIcons.forEach(el => el.classList.add('hidden'));
            }
        }

        // Cargar tema inicial antes de renderizar
        const savedTheme = localStorage.getItem('electrofrio_theme') || 'dark';
        updateThemeUI(savedTheme === 'light');

        // Escuchar click de cambio de tema
        const themeToggleBtnEl = document.getElementById('themeToggleBtn');
        if (themeToggleBtnEl) {
            themeToggleBtnEl.addEventListener('click', () => {
                const isCurrentlyLight = document.body.classList.contains('light-mode');
                const newThemeLight = !isCurrentlyLight;
                localStorage.setItem('electrofrio_theme', newThemeLight ? 'light' : 'dark');
                updateThemeUI(newThemeLight);
            });
        }
 
        // Función debounce para optimizar búsquedas e inputs rápidos
        function debounce(func, wait) {
            let timeout;
            return function(...args) {
                clearTimeout(timeout);
                timeout = setTimeout(() => func.apply(this, args), wait);
            };
        }

        // Helper global para generar o resolver el enlace de Google Maps a partir de un domicilio o link
        window.getGoogleMapsUrl = function(address, clientOrMapsUrl) {
            if (!address && !clientOrMapsUrl) return '';

            let directUrl = '';
            if (typeof clientOrMapsUrl === 'string' && clientOrMapsUrl.trim()) {
                directUrl = clientOrMapsUrl.trim();
            } else if (clientOrMapsUrl && typeof clientOrMapsUrl === 'object') {
                const client = clientOrMapsUrl;
                if (client.addressMapsLinks && address && client.addressMapsLinks[address]) {
                    directUrl = client.addressMapsLinks[address];
                } else if (Array.isArray(client.addresses) && Array.isArray(client.addressesMaps)) {
                    const idx = client.addresses.indexOf(address);
                    if (idx !== -1 && client.addressesMaps[idx]) {
                        directUrl = client.addressesMaps[idx];
                    }
                }
                if (!directUrl && client.mapsUrl && (address === client.address || !address)) {
                    directUrl = client.mapsUrl;
                }
            }

            if (directUrl) {
                if (/^https?:\/\//i.test(directUrl)) {
                    return directUrl;
                }
                if (/^-?\d+(\.\d+)?\s*,\s*-?\d+(\.\d+)?$/.test(directUrl)) {
                    return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(directUrl)}`;
                }
                return directUrl;
            }

            const cleanAddr = (address || '').trim();
            if (/^https?:\/\//i.test(cleanAddr)) {
                return cleanAddr;
            }
            if (/^-?\d+(\.\d+)?\s*,\s*-?\d+(\.\d+)?$/.test(cleanAddr)) {
                return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(cleanAddr)}`;
            }

            if (cleanAddr && cleanAddr.toLowerCase() !== 'sin especificar' && cleanAddr.toLowerCase() !== 'sin domicilio') {
                const query = cleanAddr.toLowerCase().includes('la rioja') ? cleanAddr : `${cleanAddr}, La Rioja`;
                return `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
            }

            return '';
        };

        // Función auxiliar para agregar nuevos domicilios al cliente
        async function saveNewAddressToClient(clientId, clientName, address, mapsUrl = '') {
            if (!address || address.trim() === '' || address.trim().toLowerCase() === 'sin especificar') return;
            const formattedAddress = address.trim();

            if (clientId) {
                const clientObj = clientes.find(c => c.id === clientId);
                if (clientObj) {
                    let updated = false;
                    if (!clientObj.addresses) {
                        clientObj.addresses = [clientObj.address || 'Sin especificar'];
                    }
                    if (!clientObj.addresses.includes(formattedAddress)) {
                        clientObj.addresses.push(formattedAddress);
                        updated = true;
                    }
                    if (mapsUrl) {
                        if (!clientObj.addressMapsLinks) clientObj.addressMapsLinks = {};
                        clientObj.addressMapsLinks[formattedAddress] = mapsUrl;
                        updated = true;
                    }
                    if (updated) {
                        try {
                            const updateData = { addresses: clientObj.addresses };
                            if (clientObj.addressMapsLinks) updateData.addressMapsLinks = clientObj.addressMapsLinks;
                            await db.collection('clientes').doc(clientId).update(updateData);
                            localStorage.setItem('electrofrio_clients', JSON.stringify(clientes));
                        } catch(e) {
                            console.error("Error updating client addresses:", e);
                        }
                    }
                }
            } else if (clientName && clientName.trim() !== '' && clientName.trim().toLowerCase() !== 'cliente particular') {
                const clientObj = clientes.find(c => c.name.toLowerCase() === clientName.trim().toLowerCase());
                if (clientObj) {
                    saveNewAddressToClient(clientObj.id, clientObj.name, formattedAddress, mapsUrl);
                }
            }
        }

