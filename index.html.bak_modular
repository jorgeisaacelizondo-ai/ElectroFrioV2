    <!-- MODAL NUEVO / EDITAR FICHAJE -->
    <div id="modalFichaje" class="modal-overlay">
        <div class="modal-content" style="max-width: 500px;">
            <div class="modal-header">
                <h3 class="modal-title" id="modalFichajeTitle">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                        stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                        style="margin-right: 6px;">
                        <circle cx="12" cy="12" r="10" />
                        <polyline points="12 6 12 12 16 14" />
                    </svg>
                    <span id="modalFichajeHeaderText">Registrar Fichaje Manual</span>
                </h3>
                <button class="modal-close" id="btnCloseFichajeModal">&times;</button>
            </div>
            <form id="formFichaje">
                <div class="form-grid" style="display: flex; flex-direction: column; gap: 15px;">
                    <div class="input-group" id="fichajeCollabGroup">
                        <label for="fichaje-collab">Colaborador</label>
                        <select id="fichaje-collab" required
