        // Función para mostrar notificaciones flotantes (Toast) sin alert nativo
        window.showToast = function (msg, type = 'info') {
            const toast = document.getElementById('toastNotification');
            if (!toast) {
                console.log("Toast fallback: " + msg);
                return;
            }
            toast.innerHTML = msg;

            if (type === 'success') {
                toast.style.borderColor = 'var(--color-green)';
                toast.style.color = 'var(--color-green)';
            } else if (type === 'error') {
                toast.style.borderColor = 'var(--color-red)';
                toast.style.color = 'var(--color-red)';
            } else {
                toast.style.borderColor = 'var(--border-color)';
                toast.style.color = 'var(--text-primary)';
            }

            toast.classList.add('show');

            setTimeout(() => {
                toast.classList.remove('show');
            }, 3500);
        };

