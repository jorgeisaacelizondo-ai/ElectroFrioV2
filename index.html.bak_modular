        // Determinar si una orden de trabajo está asignada a un colaborador (insensible a mayúsculas/minúsculas y espacios)
        function isOrderAssignedToUser(o, currentName) {
            if (!o || !o.assignees || !Array.isArray(o.assignees)) return false;
            const cleanName = (currentName || '').trim().toLowerCase();
            return o.assignees.some(a => a && a.trim().toLowerCase() === cleanName);
        }

        // --- FUNCIONES HELPER Y LÓGICA DEL CÓDIGO PDT (PDT-00000) ---
        function extractCommentsFromClient(clientName, techDetails, spareParts, observations) {
            let cleanClient = (clientName || '').trim();
            if (!cleanClient) cleanClient = 'Cliente Particular';
            let extractedTechDetails = (techDetails || '').trim();
            let extractedSpareParts = (spareParts || '').trim();
            let extractedObservations = (observations || '').trim();

            const match = cleanClient.match(/[\[\(](MANO DE OBRA|MATERIALES|OBSERVACIONES):?\s*(.*?)[\]\)]/i);
            if (match) {
                const type = match[1].toUpperCase();
                const content = match[2].trim();
                cleanClient = cleanClient.replace(/[\[\(](MANO DE OBRA|MATERIALES|OBSERVACIONES):?\s*.*?[\]\)]/i, '').trim();

                if (type === 'MANO DE OBRA') {
                    extractedTechDetails = extractedTechDetails && extractedTechDetails !== 'Servicios técnicos contratados.' && extractedTechDetails !== '-'
                        ? `${extractedTechDetails} | ${content}`
                        : content;
                } else if (type === 'MATERIALES') {
                    extractedSpareParts = extractedSpareParts && extractedSpareParts !== 'Ninguno' && extractedSpareParts !== '-'
                        ? `${extractedSpareParts} | ${content}`
                        : content;
                } else if (type === 'OBSERVACIONES') {
                    extractedObservations = extractedObservations && extractedObservations !== 'Sin observaciones' && extractedObservations !== '-'
                        ? `${content} | ${extractedObservations}`
                        : content;
                }
            } else {
                const bracketMatch = cleanClient.match(/\[(.*?)\]/);
                if (bracketMatch) {
                    const content = bracketMatch[1].trim();
                    cleanClient = cleanClient.replace(/\[.*?\]/, '').trim();
                    extractedObservations = extractedObservations && extractedObservations !== 'Sin observaciones' && extractedObservations !== '-'
                        ? `[Comentario importado: ${content}] ${extractedObservations}`
                        : `[Comentario importado: ${content}]`;
                }
            }

            if (!extractedTechDetails || extractedTechDetails === '-') extractedTechDetails = 'Servicios técnicos contratados.';
            if (!extractedSpareParts || extractedSpareParts === '-') extractedSpareParts = 'Ninguno';
            if (!extractedObservations || extractedObservations === '-') extractedObservations = 'Sin observaciones';

            return {
                client: cleanClient,
                techDetails: extractedTechDetails,
                spareParts: extractedSpareParts,
                observations: extractedObservations
            };
        }

        function linkPlanillasToClients() {
            if (!clientes || clientes.length === 0 || !planillas || planillas.length === 0) return;
            
            // Helper para limpiar nombres para comparación
            const cleanNameForMatching = (name) => {
                if (!name) return "";
                let clean = name.replace(/[\[\(](MANO DE OBRA|MATERIALES|OBSERVACIONES):?\s*.*?[\]\)]/i, '').trim();
                clean = clean.replace(/\[.*?\]/, '').trim();
                return clean.toLowerCase()
                    .normalize("NFD").replace(/[\u0300-\u036f]/g, "") // remover tildes
                    .replace(/[^a-z0-9\s]/g, "") // remover caracteres especiales
                    .trim();
            };

            // Pre-calcular nombres limpios de los clientes de la base de datos
            const clientsCleaned = clientes.map(c => ({
                id: c.id,
                cleanName: cleanNameForMatching(c.name),
                sortedWordsName: cleanNameForMatching(c.name).split(/\s+/).sort().join(" ")
            }));

            // Recorrer las planillas y rellenar clientId si está vacío y hay coincidencia
            planillas.forEach(p => {
                if (!p.clientId && p.client) {
                    const cleanPClient = cleanNameForMatching(p.client);
                    if (!cleanPClient) return;

                    const sortedWordsPClient = cleanPClient.split(/\s+/).sort().join(" ");

                    // 1. Buscar coincidencia exacta o por palabras desordenadas
                    let match = clientsCleaned.find(c => 
                        c.cleanName === cleanPClient || 
                        c.sortedWordsName === sortedWordsPClient
                    );

                    // 2. Si no hay coincidencia exacta, emparejar sucursales (ej. "Colon (Sucursal Centro)" con el cliente principal "Colon")
                    if (!match) {
                        match = clientsCleaned.find(c => 
                            cleanPClient.startsWith(c.cleanName + " ") || 
                            cleanPClient === c.cleanName
                        );
                    }

                    if (match) {
                        p.clientId = match.id;
                    }
                }
            });
        }

        function formatPdtCode(yearSuffix, month, sequential) {
            const yy = String(yearSuffix).padStart(2, '0');
            const mm = String(month).padStart(2, '0');
            const nnn = String(sequential).padStart(3, '0');
            return `PDT-${yy}${mm}${nnn}`;
        }

        function getNextPdtCode(dateStr) {
            let yy, mm;
            if (dateStr && typeof dateStr === 'string') {
                if (dateStr.includes('/')) {
                    // Formato DD/MM/YYYY
                    const parts = dateStr.split('/');
                    yy = parseInt(parts[2], 10) % 100;
                    mm = parseInt(parts[1], 10);
                } else if (dateStr.includes('-')) {
                    // Formato YYYY-MM-DD
                    const parts = dateStr.split('-');
                    yy = parseInt(parts[0], 10) % 100;
                    mm = parseInt(parts[1], 10);
                }
            }
            if (!yy || !mm || isNaN(yy) || isNaN(mm)) {
                const now = new Date();
                yy = now.getFullYear() % 100;
                mm = now.getMonth() + 1;
            }
            const prefix = `PDT-${String(yy).padStart(2, '0')}${String(mm).padStart(2, '0')}`;

            let maxSeq = 0;
            planillas.forEach(p => {
                const code = p.pdtCode || (typeof p.id === 'string' && p.id.startsWith('PDT-') ? p.id : "");
                if (typeof code === 'string' && code.startsWith(prefix)) {
                    const seq = parseInt(code.substring(prefix.length), 10);
                    if (!isNaN(seq) && seq > maxSeq) maxSeq = seq;
                }
            });
            return formatPdtCode(yy, mm, maxSeq + 1);
        }

        function getPdtCodeForSheet(p, sortedIndex) {
            if (p.status === 'Borrador') return "Borrador";
            if (p.pdtCode) return p.pdtCode;
            if (typeof p.id === 'string' && p.id.startsWith('PDT-')) return p.id;
            // Fallback para planillas sin código asignado
            const now = new Date();
            const yy = now.getFullYear() % 100;
            const mm = now.getMonth() + 1;
            const codeNum = (planillas.length - (sortedIndex || 0));
            return formatPdtCode(yy, mm, Math.max(1, codeNum));
        }

        function formatDateToAR(dStr) {
            if (!dStr) return '';
            if (dStr.includes('/')) return dStr;
            const parts = dStr.split('-');
            if (parts.length === 3 && parts[0].length === 4) {
                return `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
            return dStr;
        }

        function formatDateWithDayToAR(dStr) {
            if (!dStr) return '';
            let dateObj;
            if (dStr.includes('/')) {
                const parts = dStr.split('/');
                if (parts.length === 3) {
                    dateObj = new Date(parts[2], parseInt(parts[1])-1, parts[0]);
                }
            } else {
                const parts = dStr.split('-');
                if (parts.length === 3 && parts[0].length === 4) {
                    dateObj = new Date(parts[0], parseInt(parts[1])-1, parts[2]);
                }
            }
            const dateStr = formatDateToAR(dStr);
            if (!dateObj) return dateStr;
            const days = ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'];
            const dayName = days[dateObj.getDay()];
            return `${dateStr}<br><span style="font-size: 11px; color: var(--text-muted);">${dayName}</span>`;
        }

        
        window.savePlanillaManual = async function(planillaId) {
            const pIndex = planillas.findIndex(p => p.id === planillaId);
            if (pIndex > -1) {
                const btn = document.getElementById('btn-save-' + planillaId);
                if (btn) btn.innerHTML = '⏳';
                try {
                    if (typeof db !== 'undefined') {
                        // Forzar el guardado del objeto completo en Firebase
                        await db.collection('planillas').doc(planillaId).set(planillas[pIndex]);
                    }
                    if (btn) {
                        btn.innerHTML = '✅';
                        setTimeout(() => { if(document.getElementById('btn-save-' + planillaId)) document.getElementById('btn-save-' + planillaId).innerHTML = '💾'; }, 2000);
                    }
                } catch (e) {
                    console.error('Error al guardar planilla manual', e);
                    if (btn) btn.innerHTML = '❌';
                }
            }
        };

        window._pendingPlanillaUpdates = {};
        window._planillaUpdateTimers = {};
        window.updatePlanillaInline = function(planillaId, field, value) {
            const pIndex = planillas.findIndex(p => p.id === planillaId);
            if (pIndex > -1) {
                planillas[pIndex][field] = value;
                localStorage.setItem('electrofrio_worksheets', JSON.stringify(planillas));
                
                if (!window._pendingPlanillaUpdates[planillaId]) {
                    window._pendingPlanillaUpdates[planillaId] = {};
                }
                window._pendingPlanillaUpdates[planillaId][field] = value;

                if (typeof db !== 'undefined') {
                    const timerKey = `${planillaId}_${field}`;
                    if (window._planillaUpdateTimers[timerKey]) {
                        clearTimeout(window._planillaUpdateTimers[timerKey]);
                    }
                    window._planillaUpdateTimers[timerKey] = setTimeout(async () => {
                        try {
                            const updateObj = {};
                            updateObj[field] = value;
                            await db.collection('planillas').doc(planillaId).update(updateObj);
                            if (window._pendingPlanillaUpdates[planillaId]) {
                                delete window._pendingPlanillaUpdates[planillaId][field];
                            }
                        } catch (e) {
                            console.error('Error al actualizar planilla inline en firebase:', e);
                        }
                    }, 1000);
                }
                if (field === 'estadoPDT') {
                    renderWorksheetsTable();
                }
            }
        };

        window.revertToDraft = async function(planillaId) {
            if (confirm('¿Estás seguro de que deseas devolver esta planilla a Borrador? Esto la ocultará de tu vista y se la enviará al técnico para que la corrija.')) {
                try {
                    await db.collection('planillas').doc(planillaId).update({ status: 'Borrador' });
                    showToast('Planilla devuelta a Borrador exitosamente.', 'success');
                    
                    // Update locally
                    const idx = planillas.findIndex(p => p.id === planillaId);
                    if (idx > -1) {
                        planillas[idx].status = 'Borrador';
                        localStorage.setItem('electrofrio_worksheets', JSON.stringify(planillas));
                        renderWorksheetsTable();
                    }
                } catch (e) {
                    console.error('Error al devolver a borrador:', e);
                    showToast('Error al devolver a borrador: ' + e.message, 'error');
                }
            }
        };

        
        function populateWorksheetAuthorDropdown(searchVal = '') {
            const select = document.getElementById('filterWorksheetAuthor');
            if (!select) return;
            const currentValue = select.value;
            select.innerHTML = '<option value="">-- Todos los autores --</option>';
            
            const authors = new Set();
            planillas.forEach(p => {
                const author = (p.cargado_por || '-').trim();
                authors.add(author);
            });
            
            Array.from(authors).sort().forEach(author => {
                const option = document.createElement('option');
                option.value = author.toLowerCase();
                option.textContent = author;
                select.appendChild(option);
            });
            
            if (currentValue) {
                select.value = currentValue;
            }
        }

        function renderWorksheetsTable() {
            const tbody = document.getElementById('worksheetsTableBody');
            if (!tbody) return;

            const activeId = document.activeElement ? document.activeElement.id : null;
            const activeStart = document.activeElement && document.activeElement.tagName === 'INPUT' ? document.activeElement.selectionStart : null;
            const activeEnd = document.activeElement && document.activeElement.tagName === 'INPUT' ? document.activeElement.selectionEnd : null;

            tbody.innerHTML = '';

            const searchVal = document.getElementById('searchWorksheetInput')
                ? document.getElementById('searchWorksheetInput').value.trim().toLowerCase()
                : '';

            const weekFilterVal = document.getElementById('filterWorksheetWeek')
                ? document.getElementById('filterWorksheetWeek').value
                : '';
                
            if (searchVal !== window.lastWorksheetSearchVal) {
                populateWorksheetAddressDropdown(searchVal);
                populateWorksheetAuthorDropdown(searchVal);
            }
            const addressFilterVal = document.getElementById('filterWorksheetAddress')
                ? document.getElementById('filterWorksheetAddress').value
                : '';

            // Reiniciar el límite si cambia el valor de búsqueda o el de semana para optimizar
            if (searchVal !== window.lastWorksheetSearchVal || weekFilterVal !== window.lastWorksheetWeekFilterVal) {
                window.lastWorksheetSearchVal = searchVal;
                window.lastWorksheetWeekFilterVal = weekFilterVal;
                window.worksheetsRenderLimit = 100;
            }
            if (!window.worksheetsRenderLimit) {
                window.worksheetsRenderLimit = 100;
            }

            // Crear Maps para búsquedas O(1) ultra rápidas
            const clientesMap = new Map(clientes.map(c => [c.id, c.name]));
            const ordenesMap = new Map(ordenesTrabajo.map(o => [o.id, o]));

            // Ordenar planillas por fecha descendente, luego por horario de inicio descendente (17:00/18:00 arriba, 08:00 abajo) y por código PDT descendente
            const sortedSheets = [...planillas].sort((a, b) => {
                const parseDate = (dStr) => {
                    if (!dStr) return '';
                    const parts = dStr.split('/');
                    if (parts.length === 3) {
                        return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                    }
                    return dStr;
                };
                const dA = parseDate(a.date) || a.timestamp || "";
                const dB = parseDate(b.date) || b.timestamp || "";
                
                const dateComp = dB.localeCompare(dA);
                if (dateComp !== 0) return dateComp;

                // Ante igual fecha, ordenar cronológicamente con las horas de la tarde arriba (17hs arriba, 8hs abajo)
                const getSheetStartMin = (sheet) => {
                    if (sheet.horaEntrada) return timeStringToMinutes(sheet.horaEntrada);
                    if (sheet.timeRange) {
                        const m = sheet.timeRange.match(/(\d{1,2}:\d{2})/);
                        if (m) return timeStringToMinutes(m[1]);
                    }
                    const ord = sheet.orderId ? ordenesMap.get(sheet.orderId) : null;
                    if (ord && ord.time) return timeStringToMinutes(ord.time);
                    return 0;
                };

                const timeA = getSheetStartMin(a);
                const timeB = getSheetStartMin(b);
                if (timeA !== timeB) {
                    return timeB - timeA; // Mayor hora primero (17:00 arriba, 08:00 abajo)
                }

                const codeA = a.pdtCode || a.id || "";
                const codeB = b.pdtCode || b.id || "";
                return codeB.localeCompare(codeA);
            });

            const role = localStorage.getItem('electrofrio_role') || 'Colaborador';
            const myName = localStorage.getItem('electrofrio_name') || '';
            const myNameLower = myName.trim().toLowerCase();

            const filteredSheets = sortedSheets.filter((p, idx) => {
                // Filtro por domicilio
                if (addressFilterVal) {
                    const addr = (p.address || p.domicilio || '').trim();
                    if (addr !== addressFilterVal) {
                        return false;
                    }
                }

                // Filtro por semana
                if (weekFilterVal) {
                    const info = getSheetWeekKey(p);
                    if (!info || info.key !== weekFilterVal) {
                        return false;
                    }
                }

                // Si es colaborador, solo puede ver sus propios borradores activos
                if (role !== 'Administrador') {
                    if (p.status !== 'Borrador') return false;

                    let techListArray = [];
                    if (Array.isArray(p.technicians)) {
                        techListArray = p.technicians.map(t => (t || '').toLowerCase());
                    }
                    if (p.completedBy) {
                        const cbList = p.completedBy.split(',').map(s => s.trim().toLowerCase());
                        techListArray = [...techListArray, ...cbList];
                    }
                    const isMySheet = techListArray.some(t => t.includes(myNameLower) || myNameLower.includes(t));
                    if (!isMySheet) return false;
                }

                const ord = p.orderId ? ordenesMap.get(p.orderId) : null;
                const clientName = p.clientId ? clientesMap.get(p.clientId) : (p.client || (ord ? ord.client : ""));
                const pdtCode = getPdtCodeForSheet(p, idx);

                const techList = Array.isArray(p.technicians) ? p.technicians.join(' ') : (p.completedBy || '');

                const searchStr = `${pdtCode} ${p.orderId || ''} ${p.date || ''} ${clientName || ''} ${techList} ${p.address || ''} ${p.domicilio || ''} ${p.techDetails || ''} ${p.spareParts || ''} ${p.observations || ''} ${p.cargado_por || ''} ${p.area || ''} ${p.status || ''} ${p.manoObra || ''} ${p.materiales || ''} ${p.estadoPDT || ''} ${p.timeRange || ''} ${p.horaEntrada || ''} ${p.horaSalida || ''}`.toLowerCase();
                const searchTerms = searchVal.split(' ').filter(t => t);
                return searchTerms.length === 0 || searchTerms.every(term => searchStr.includes(term));
            });

            if (filteredSheets.length === 0) {
                tbody.innerHTML = `<tr><td colspan="11" style="text-align:center; color:var(--text-muted); padding:20px;">No se encontraron planillas de trabajo registradas.</td></tr>`;
                return;
            }

            // Update Select All checkbox and counter
            window.currentFilteredWorksheetIds = filteredSheets.map(p => p.id);
            if (window.updateWorksheetSelectionUI) {
                window.updateWorksheetSelectionUI();
            }
            
            // Limitar las planillas dibujadas en el DOM para evitar congelamiento
            const displayedSheets = filteredSheets.slice(0, window.worksheetsRenderLimit);

            displayedSheets.forEach((p, idx) => {
                const ord = p.orderId ? ordenesMap.get(p.orderId) : null;
                const clientName = p.clientId ? clientesMap.get(p.clientId) : (p.client || (ord ? ord.client : "Cliente Particular"));
                const pdtCode = getPdtCodeForSheet(p, idx);
                const fechaAR = formatDateWithDayToAR(p.date);

                // Formatear Horario limpio
                let horarioStr = "08:00HS-17:00HS";
                if (p.horaEntrada && p.horaSalida) {
                    horarioStr = `${p.horaEntrada}HS-${p.horaSalida}HS`;
                } else if (p.horaEntrada) {
                    horarioStr = `${p.horaEntrada}HS`;
                } else if (p.timeRange) {
                    horarioStr = p.timeRange;
                } else if (ord && ord.time) {
                    if (ord.timeEnd) {
                        horarioStr = `${ord.time}HS-${ord.timeEnd}HS`;
                    } else {
                        horarioStr = `${ord.time}HS`;
                    }
                }

                // Formatear Colaboradores
                let collabsStr = "Sin Asignar";
                if (Array.isArray(p.technicians) && p.technicians.length > 0) {
                    collabsStr = p.technicians.join(', ');
                } else if (p.completedBy) {
                    collabsStr = p.completedBy;
                } else if (ord && ord.assignees && ord.assignees.length > 0) {
                    collabsStr = ord.assignees.join(', ');
                } else if (ord && ord.assignee) {
                    collabsStr = ord.assignee;
                }

                const moValue = p.manoObra || '';
                const matValue = p.materiales || '';
                const estValue = p.estadoPDT || 'NO REALIZADO';
                
                let estColor = 'background-color: var(--bg-input); font-weight: 700; border: 1px solid var(--border-color);';
                switch (estValue) {
                    case 'NO REALIZADO': estColor += ' color: #ff5252;'; break; 
                    case 'COBRADO': 
                    case 'FACTURADO': estColor += ' color: #4caf50;'; break; 
                    case 'ENVIAR':
                    case 'ENVIADO': estColor += ' color: #448aff;'; break; 
                    case 'REVISAR':
                    case 'NO ENVIADO': estColor += ' color: #ffb300;'; break; 
                    case 'PRESUPUESTO': estColor += ' color: #ff9800;'; break; 
                    case 'GARANTIA': estColor += ' color: #e040fb;'; break; 
                    case 'OBRA': estColor += ' color: #00e5ff;'; break;
                    case 'DELIVERY': estColor += ' color: #b388ff;'; break;
                    case 'SUMA!': estColor += ' color: #f06292;'; break;
                    default: estColor += ' color: var(--text-primary);'; break;
                }

                const isSelected = window.selectedWorksheets && window.selectedWorksheets.has(p.id);
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td style="text-align: center;">
                        <input type="checkbox" class="worksheet-checkbox" value="${p.id}" ${isSelected ? 'checked' : ''} onchange="toggleWorksheetSelection('${p.id}', this.checked)" style="cursor: pointer;">
                    </td>
                    <td data-label="FECHA">${fechaAR}</td>
                    <td data-label="AUTOR"><span style="color: #4caf50; font-weight: bold; background: rgba(76,175,80,0.1); padding: 4px 8px; border-radius: 4px; font-size: 11px; display: inline-block;">${p.cargado_por || '-'}</span></td>
                    <td data-label="ID / CÓDIGO PDT" style="font-weight:700; color:var(--color-blue);">
                        ${p.status === 'Borrador' ? '<span class="badge status-presupuesto" style="display: inline-block; font-size: 11px; padding: 4px 8px; font-weight: 700; border-radius: 4px; vertical-align: middle;">Borrador</span>' : pdtCode}
                    </td>
                    <td data-label="CLIENTE" style="font-weight:600;">${clientName}</td>
                    <td data-label="DOMICILIO" style="font-size:12px; color:var(--text-secondary); text-align: left;">${p.address || p.domicilio || 'Sin especificar'}</td>
                    <td data-label="HORARIO">${horarioStr}</td>
                    <td data-label="COLABORADORES">${collabsStr}</td>
                    <td data-label="MANO DE OBRA" class="role-admin-only"><input type="text" id="mo-${p.id}" class="inline-input" value="${moValue}" oninput="window.updatePlanillaInline('${p.id}', 'manoObra', this.value)" style="width: 100%; min-width: 150px; padding: 4px; font-size: 11px; text-transform: uppercase; background: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 4px;"></td>
                    <td data-label="MATERIALES" class="role-admin-only"><input type="text" id="mat-${p.id}" class="inline-input" value="${matValue}" oninput="window.updatePlanillaInline('${p.id}', 'materiales', this.value)" style="width: 100%; min-width: 150px; padding: 4px; font-size: 11px; text-transform: uppercase; background: var(--bg-input); border: 1px solid var(--border-color); color: var(--text-primary); border-radius: 4px;"></td>
                    <td data-label="ESTADO" class="role-admin-only">
                        <select class="inline-select" onchange="window.updatePlanillaInline('${p.id}', 'estadoPDT', this.value)" style="width: 100%; min-width: 115px; padding: 4px 22px 4px 4px; font-size: 11px; border-radius: 4px; outline: none; cursor: pointer; ${estColor}">
                            <option value="NO REALIZADO" ${estValue === 'NO REALIZADO' ? 'selected' : ''} style="color: #ff5252; background: var(--bg-input);">NO REALIZADO</option>
                            <option value="NO ENVIADO" ${estValue === 'NO ENVIADO' ? 'selected' : ''} style="color: #ffb300; background: var(--bg-input);">NO ENVIADO</option>
                            <option value="REVISAR" ${estValue === 'REVISAR' ? 'selected' : ''} style="color: #ffb300; background: var(--bg-input);">REVISAR</option>
                            <option value="ENVIAR" ${estValue === 'ENVIAR' ? 'selected' : ''} style="color: #448aff; background: var(--bg-input);">ENVIAR</option>
                            <option value="ENVIADO" ${estValue === 'ENVIADO' ? 'selected' : ''} style="color: #448aff; background: var(--bg-input);">ENVIADO</option>
                            <option value="COBRADO" ${estValue === 'COBRADO' ? 'selected' : ''} style="color: #4caf50; background: var(--bg-input);">COBRADO</option>
                            <option value="FACTURADO" ${estValue === 'FACTURADO' ? 'selected' : ''} style="color: #4caf50; background: var(--bg-input);">FACTURADO</option>
                            <option value="GARANTIA" ${estValue === 'GARANTIA' ? 'selected' : ''} style="color: #e040fb; background: var(--bg-input);">GARANTIA</option>
                            <option value="PRESUPUESTO" ${estValue === 'PRESUPUESTO' ? 'selected' : ''} style="color: #ff9800; background: var(--bg-input);">PRESUPUESTO</option>
                            <option value="OBRA" ${estValue === 'OBRA' ? 'selected' : ''} style="color: #00e5ff; background: var(--bg-input);">OBRA</option>
                            <option value="DELIVERY" ${estValue === 'DELIVERY' ? 'selected' : ''} style="color: #b388ff; background: var(--bg-input);">DELIVERY</option>
                            <option value="SUMA!" ${estValue === 'SUMA!' ? 'selected' : ''} style="color: #f06292; background: var(--bg-input);">SUMA!</option>
                        </select>
                    </td>
                    <td data-label="🖨️" class="role-admin-only" style="text-align: center;">
                        <select class="inline-select" onchange="window.updatePlanillaInline('${p.id}', 'impreso', this.value)" style="width: 100%; min-width: 60px; padding: 4px; font-size: 11px; border-radius: 4px; outline: none; cursor: pointer; text-align: center; font-weight: bold; background-color: ${p.impreso === 'SI' ? 'rgba(76, 175, 80, 0.1)' : 'var(--bg-input)'}; color: ${p.impreso === 'SI' ? '#4caf50' : 'var(--text-primary)'}; border: 1px solid ${p.impreso === 'SI' ? 'rgba(76, 175, 80, 0.4)' : 'var(--border-color)'};">
                            <option value="NO" ${p.impreso !== 'SI' ? 'selected' : ''} style="color: var(--text-primary); background: var(--bg-input);">NO</option>
                            <option value="SI" ${p.impreso === 'SI' ? 'selected' : ''} style="color: #4caf50; background: var(--bg-input);">SI</option>
                        </select>
                    </td>
                    <td data-label="ACCIONES" style="text-align:center;">
                        <div style="display:flex; gap:6px; justify-content:center; align-items:center;">
                            ${role === 'Administrador' ? `<button id="btn-save-${p.id}" class="action-icon-btn" onclick="savePlanillaManual('${p.id}')" title="Guardar Cambios" style="background-color: #2e7d32; border: 1px solid #1b5e20; border-radius: 6px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; cursor: pointer; transition: all 0.2s ease;">💾</button>` : ''}
                              <button class="action-icon-btn" onclick="printPlanilla('${p.id}')" title="Imprimir o Exportar PDF" style="background-color: var(--color-blue); border: none; border-radius: 6px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; cursor: pointer; transition: all 0.2s ease;">🖨️</button>
                            <button class="action-icon-btn" onclick="editPlanilla('${p.id}')" title="Editar Planilla" style="background-color: #24364e; border: 1px solid var(--border-color); border-radius: 6px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; cursor: pointer; transition: all 0.2s ease;">✏️</button>
                            ${role === 'Administrador' ? `<button class="action-icon-btn" onclick="window.revertToDraft('${p.id}')" title="Devolver a Borrador" style="background-color: #f57c00; border: 1px solid #e65100; border-radius: 6px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; cursor: pointer; transition: all 0.2s ease;">🔙</button>` : ''}
                            ${role === 'Administrador' ? `<button class="action-icon-btn" onclick="openDeletePdtModal('${p.id}', '${pdtCode}')" title="Eliminar Planilla" style="background-color: #7a1a1a; border: 1px solid #992020; border-radius: 6px; width: 32px; height: 32px; display: inline-flex; align-items: center; justify-content: center; font-size: 15px; cursor: pointer; transition: all 0.2s ease;">🗑️</button>` : ''}
                        </div>
                    </td>
                `;
                tbody.appendChild(tr);
            });

            // Si hay más planillas que el límite, agregar fila de 'Cargar más'
            if (filteredSheets.length > window.worksheetsRenderLimit) {
                const trLoadMore = document.createElement('tr');
                trLoadMore.innerHTML = `
                    <td colspan="7" style="text-align: center; padding: 15px;">
                        <button type="button" class="save-btn" onclick="window.worksheetsRenderLimit += 200; renderWorksheetsTable();" style="width: auto; margin: 0 auto; padding: 8px 16px; font-size: 13px; background-color: var(--color-blue); color: #000; font-weight: 700; display: inline-flex; align-items: center; gap: 8px; cursor: pointer; border-radius: 6px;">
                            ➕ Cargar más planillas (Mostrando ${window.worksheetsRenderLimit} de ${filteredSheets.length})
                        </button>
                    </td>
                `;
                tbody.appendChild(trLoadMore);
            }

            if (activeId && activeId !== 'searchWorksheetInput' && activeId !== 'filterWorksheetWeek' && activeId !== 'filterWorksheetAddress') {
                setTimeout(() => {
                    const el = document.getElementById(activeId);
                    if (el) {
                        el.focus();
                        if (activeStart !== null) {
                            try { el.setSelectionRange(activeStart, activeEnd); } catch(e){}
                        }
                    }
                }, 0);
            }
        }

        // --- FUNCIONES DE CONFIGURACIÓN Y BACKUP (MIGRADAS A modulos/configuracion.html) ---
        window.savePdtPricingConfig = function () {
            const iframe = document.querySelector('#mod-configuracion iframe');
            if (iframe && iframe.contentWindow && typeof iframe.contentWindow.savePdtPricingConfig === 'function') {
                iframe.contentWindow.savePdtPricingConfig();
            }
        };

        window.exportarBackupCompleto = function () {
            switchPage('configuracion');
            const iframe = document.querySelector('#mod-configuracion iframe');
            if (iframe && iframe.contentWindow && typeof iframe.contentWindow.exportarBackupCompleto === 'function') {
                iframe.contentWindow.exportarBackupCompleto();
            }
        };

        window.actualizarEstadoUIBackup = function () {
            const iframe = document.querySelector('#mod-configuracion iframe');
            if (iframe && iframe.contentWindow && typeof iframe.contentWindow.actualizarEstadoUIBackup === 'function') {
                iframe.contentWindow.actualizarEstadoUIBackup();
            }
        };

        function calculateHoursFromTimeRangeString(str) {
            if (!str) return 9;
            const s = str.toUpperCase().trim();
            const matches = [...s.matchAll(/(\d{1,2})(?::(\d{2}))?/g)];
            if (matches.length >= 2) {
                const h1 = parseInt(matches[0][1], 10);
                const m1 = matches[0][2] ? parseInt(matches[0][2], 10) : 0;
                const h2 = parseInt(matches[1][1], 10);
                const m2 = matches[1][2] ? parseInt(matches[1][2], 10) : 0;

                if (!isNaN(h1) && !isNaN(h2) && h1 >= 0 && h1 <= 24 && h2 >= 0 && h2 <= 24) {
                    let diffMins = (h2 * 60 + m2) - (h1 * 60 + m1);
                    if (diffMins <= 0) diffMins += 24 * 60;
                    return diffMins / 60;
                }
            }
            return 9;
        }

        // --- FUNCIONALIDAD DE BOTONES DE ACCIÓN PDT (IMPRIMIR, EDITAR, ELIMINAR CON CLAVE 123) ---

        // 1. IMPRIMIR / FORMATO EXPORTABLE PDF
        window.printPlanilla = function (pId) {
            const p = planillas.find(sheet => sheet.id === pId);
            if (!p) return;

            const ord = ordenesTrabajo.find(o => o.id === p.orderId);
            const clientObj = clientes.find(c => c.id === p.clientId);
            const clientName = clientObj ? clientObj.name : (p.client || (ord ? ord.client : "Cliente Particular"));
            const clientAddress = p.address || p.domicilio || (clientObj ? clientObj.address : (ord ? ord.address : ""));
            const clientPhone = clientObj ? clientObj.phone : "";
            const pdtCode = p.pdtCode || getPdtCodeForSheet(p);
            const dateFormatted = formatDateToAR(p.date);

            const rawTimeStr = p.horaEntrada && p.horaSalida ? `${p.horaEntrada}HS - ${p.horaSalida}HS` : (p.timeRange || (ord && ord.time ? (ord.time.includes('-') || ord.time.toLowerCase().includes('a') ? ord.time : `${ord.time}HS - 17:00HS`) : "08:00HS - 17:00HS"));
            const timeRange = rawTimeStr;
            const techs = Array.isArray(p.technicians) && p.technicians.length > 0 ? p.technicians.join(', ') : (p.completedBy || (ord && ord.assignees ? ord.assignees.join(', ') : 'Técnico'));

            // Configuración del cálculo de precio sugerido
            const basePriceConfig = parseFloat(localStorage.getItem('electrofrio_pdt_base_price')) || 6000;
            const multiplierConfig = parseFloat(localStorage.getItem('electrofrio_pdt_multiplier')) || 2.5;

            // Nº de Colaboradores
            let numCollabs = 1;
            if (Array.isArray(p.technicians) && p.technicians.length > 0) {
                numCollabs = p.technicians.length;
            } else if (p.completedBy) {
                const collabsArray = p.completedBy.split(',').filter(s => s.trim() !== '');
                if (collabsArray.length > 0) {
                    numCollabs = collabsArray.length;
                }
            } else if (ord && ord.assignees && ord.assignees.length > 0) {
                numCollabs = ord.assignees.length;
            }

            // Horas Trabajadas (Calculado de forma inteligente desde el rango horario)
            const hoursWorked = calculateHoursFromTimeRangeString(rawTimeStr);

            const calculatedPrice = basePriceConfig * numCollabs * hoursWorked * multiplierConfig;
            const formattedPrice = Math.round(calculatedPrice).toLocaleString('es-AR');
            const formattedHours = hoursWorked % 1 === 0 ? hoursWorked.toFixed(0) : hoursWorked.toFixed(1);

            // Formatear detalles técnicos para impresión: si contiene múltiples áreas (delimitadas por ||), separarlas en bloques visuales independientes (con enter y línea punteada).
            // Si contiene elementos separados por |, separarlos en nuevas líneas (enter) para facilitar la lectura.
            let formattedTechDetailsHtml = 'Sin detalles técnicos registrados.';
            if (p.techDetails) {
                const blocks = p.techDetails.split('||').map(b => b.trim()).filter(Boolean);
                if (blocks.length > 0) {
                    formattedTechDetailsHtml = blocks.map((b, idx) => {
                        const lines = b.split('|').map(s => s.trim()).filter(Boolean);
                        const blockContent = lines.map((line, lIdx) => {
                            let lineHtml = line;
                            if (/^(Área:|Area:)/i.test(lineHtml)) {
                                lineHtml = `<strong style="color: #0b192c; font-size: 13.5px;">${lineHtml}</strong>`;
                            } else if (/^(Trabajos:)/i.test(lineHtml)) {
                                let trabajosText = lineHtml.replace(/^(Trabajos:)\s*/i, '');
                                // Mantener la acción y su zona juntas, pero después de cada zona saltar de línea con un enter
                                trabajosText = trabajosText.replace(/([(\[](?:Zona|Ubicación|Ubicacion|Sector):\s*[^)\]]+[)\]])\s*[,;.]?\s*(?=[^\s])/gi, '$1\n');
                                lineHtml = `<strong style="color: #0b192c; font-size: 13px;">Trabajos:</strong> ${trabajosText}`;
                            } else {
                                lineHtml = lineHtml.replace(/([(\[](?:Zona|Ubicación|Ubicacion|Sector):\s*[^)\]]+[)\]])\s*[,;.]?\s*(?=[^\s])/gi, '$1\n');
                            }
                            return `<div style="${lIdx > 0 ? 'margin-top: 5px;' : ''} line-height: 1.5; white-space: pre-wrap;">${lineHtml}</div>`;
                        }).join('');

                        return `<div style="${idx > 0 ? 'margin-top: 14px; padding-top: 12px; border-top: 1.5px dashed #bbb;' : ''}">${blockContent}</div>`;
                    }).join('');
                }
            }

            // Formatear repuestos y materiales para impresión (si están separados por |, hacer un enter)
            let formattedSparePartsHtml = 'Ninguno';
            if (p.spareParts && p.spareParts.trim()) {
                const spParts = p.spareParts.split('|').map(s => s.trim()).filter(Boolean);
                if (spParts.length > 0) {
                    formattedSparePartsHtml = spParts.map((sp, sIdx) => 
                        `<div style="${sIdx > 0 ? 'margin-top: 4px;' : ''} line-height: 1.5; white-space: pre-wrap;">${sp}</div>`
                    ).join('');
                }
            }

            // Formatear observaciones para impresión (si están separadas por |, hacer un enter)
            let formattedObservationsHtml = 'Sin observaciones adicionales.';
            if (p.observations && p.observations.trim()) {
                const obsParts = p.observations.split('|').map(s => s.trim()).filter(Boolean);
                if (obsParts.length > 0) {
                    formattedObservationsHtml = obsParts.map((obs, oIdx) => 
                        `<div style="${oIdx > 0 ? 'margin-top: 4px;' : ''} line-height: 1.5; white-space: pre-wrap;">${obs}</div>`
                    ).join('');
                }
            }

            const printWindow = window.open('', '_blank', 'width=900,height=800');
            printWindow.document.write(`
                <!DOCTYPE html>
                <html>
                <head>
                    <title>Planilla de Trabajo ${pdtCode}</title>
                    <style>
                        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; color: #111; padding: 30px; line-height: 1.5; background: #fff; }
                        .header { display: flex; justify-content: space-between; align-items: center; border-bottom: 3px solid #00c0ff; padding-bottom: 15px; margin-bottom: 20px; }
                        .title { font-size: 20px; font-weight: bold; color: #0b192c; }
                        .pdt-code { font-size: 20px; font-weight: bold; color: #0088cc; border: 2px solid #0088cc; padding: 4px 12px; border-radius: 6px; }
                        .section { margin-bottom: 18px; border: 1px solid #ccc; padding: 14px 18px; border-radius: 8px; background: #fafafa; }
                        .section-title { font-size: 12px; font-weight: bold; text-transform: uppercase; color: #0088cc; border-bottom: 1px solid #ddd; padding-bottom: 6px; margin-bottom: 12px; }
                        .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
                        .label { font-size: 10px; text-transform: uppercase; color: #666; font-weight: bold; }
                        .val { font-size: 13px; font-weight: 600; color: #111; margin-top: 2px; }
                        @media print {
                            body { padding: 0; background: #fff; }
                            .no-print { display: none !important; }
                            .section { background: #fff; border: 1px solid #aaa; }
                        }
                    </style>
                </head>
                <body>
                    <div class="no-print" style="margin-bottom: 20px; text-align: right;">
                        <button onclick="window.print()" style="padding: 10px 20px; background: #0088cc; color: white; border: none; border-radius: 6px; font-weight: bold; cursor: pointer; font-size: 14px;">🖨️ Imprimir / Guardar en PDF</button>
                    </div>
                    <div class="header">
                        <div style="display: flex; align-items: center; gap: 15px;">
                            <img src="assets/logo.png" alt="ElectroFrío Logo" style="height: 55px; max-width: 180px; object-fit: contain;">
                            <div class="title" style="font-size: 20px; font-weight: 800; color: #0b192c; letter-spacing: 0.5px;">PLANILLA DE TRABAJO TECNICO</div>
                        </div>
                        <div class="pdt-code">${pdtCode}</div>
                    </div>

                    <!-- SECCIÓN COMPROBANTE PARA LLENADO MANUAL POST-FACTURACIÓN O VISUALIZACIÓN DE COMPROBANTE CARGADO -->
                    <div style="margin-bottom: 20px; padding: 12px 16px; border: 1.5px dashed #555; border-radius: 6px; background: #fafafa; font-size: 11px; font-weight: 700; color: #111; text-transform: uppercase;">
                        <div style="margin-bottom: 10px; display: flex; align-items: baseline; gap: 6px;">
                            <span style="white-space: nowrap;">MANO DE OBRA REALIZADA - COMPROBANTE:</span>
                            <span style="flex: 1; border-bottom: 1px dotted #333; min-height: 14px; padding-left: 8px; font-size: 13px; font-weight: 800; color: #d32f2f; letter-spacing: 0.5px; display: inline-block;">${p.manoObra ? p.manoObra : '&nbsp;'}</span>
                        </div>
                        <div style="display: flex; align-items: baseline; gap: 6px;">
                            <span style="white-space: nowrap;">MATERIALES UTILIZADOS - COMPROBANTE:</span>
                            <span style="flex: 1; border-bottom: 1px dotted #333; min-height: 14px; padding-left: 8px; font-size: 13px; font-weight: 800; color: #d32f2f; letter-spacing: 0.5px; display: inline-block;">${p.materiales ? p.materiales : '&nbsp;'}</span>
                        </div>
                        <!-- PRECIO SUGERIDO: nota discreta debajo del comprobante -->
                        <div style="margin-top: 10px; padding-top: 8px; border-top: 1px dotted #bbb; display: flex; justify-content: space-between; align-items: center; font-size: 10px; font-weight: 400; color: #666; text-transform: none; letter-spacing: 0;">
                            <span style="font-style: italic;">Precio de referencia sugerido: ${basePriceConfig.toLocaleString('es-AR')} × ${numCollabs} ${numCollabs === 1 ? 'colaborador' : 'colaboradores'} × ${formattedHours}hs × ${multiplierConfig}</span>
                            <span style="font-weight: 600; color: #555; font-size: 11px; white-space: nowrap; margin-left: 12px;">$${formattedPrice} ARS</span>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">Información General del Servicio - ${p.cargado_por || '-'}</div>
                        <div class="grid-2">
                            <div><div class="label">Fecha de Registro</div><div class="val">${dateFormatted}</div></div>
                            <div><div class="label">Rango Horario de Trabajo</div><div class="val">${timeRange}</div></div>
                            <div><div class="label">Cliente / Razón Social</div><div class="val">${clientName}</div></div>
                            <div><div class="label">Domicilio del Servicio</div><div class="val">${clientAddress}</div></div>
                            <div><div class="label">Teléfono de Contacto</div><div class="val">${clientPhone || 'No registrado'}</div></div>
                            <div><div class="label">Técnicos / Colaboradores Intervinientes</div><div class="val">${techs} (${numCollabs})</div></div>
                        </div>
                    </div>

                    <div class="section">
                        <div class="section-title">Detalles Técnicos y Trabajos Realizados</div>
                        <div class="val" style="font-weight: normal; font-size: 13px;">${formattedTechDetailsHtml}</div>
                    </div>

                    <div class="section">
                        <div class="section-title">Repuestos y Materiales Utilizados</div>
                        <div class="val" style="font-weight: normal; font-size: 13px;">${formattedSparePartsHtml}</div>
                    </div>

                    <div class="section">
                        <div class="section-title">Observaciones y Recomendaciones</div>
                        <div class="val" style="font-weight: normal; font-size: 13px;">${formattedObservationsHtml}</div>
                    </div>

                </body>
                </html>
            `);
            printWindow.document.close();
        };

        // Cargar dinámicamente los selectores editables de Admin en el modal de planilla de trabajo
        function populateAdminPlanillaSelects(selectedClientId, selectedAddress, selectedCompletedBy) {
            const clientSearchInput = document.getElementById('planilla-client-search');
            const clientIdInput = document.getElementById('planilla-client-id');
            const completedByContainer = document.getElementById('planilla-completed-by-checkboxes');
            
            if (!clientSearchInput || !completedByContainer) return;

            // Asegurar inicialización de autocompletado si no se hizo
            populateClientSelects();

            // 1. POPULATE COMPLETED BY CHECKBOXES (TECNICOS)
            completedByContainer.innerHTML = '';
            
            const selectedNames = (selectedCompletedBy || "")
                .split(',')
                .map(name => name.trim())
                .filter(name => name !== "");

            const selectedNamesLower = selectedNames.map(n => n.toLowerCase());

            colaboradores.forEach(col => {
                if (col.role !== 'Colaborador') return;
                const isChecked = selectedNamesLower.includes(col.name.trim().toLowerCase());
                const div = document.createElement('div');
                div.style.display = 'flex';
                div.style.alignItems = 'center';
                div.style.gap = '6px';
                div.style.marginBottom = '2px';
                div.innerHTML = `
                    <input type="checkbox" name="planilla-completed-by-checkbox" id="cb-planilla-collab-${col.username}" value="${col.name}" ${isChecked ? 'checked' : ''}>
                    <label for="cb-planilla-collab-${col.username}" style="margin: 0; font-size: 13px; font-weight: normal; cursor: pointer; color: var(--text-primary);">${col.name}</label>
                `;
                completedByContainer.appendChild(div);
            });

            selectedNames.forEach(name => {
                const exists = colaboradores.some(col => col.name.trim().toLowerCase() === name.toLowerCase());
                if (!exists) {
                    const div = document.createElement('div');
                    div.style.display = 'flex';
                    div.style.alignItems = 'center';
                    div.style.gap = '6px';
                    div.style.marginBottom = '2px';
                    const safeId = name.replace(/\s+/g, '-').toLowerCase();
                    div.innerHTML = `
                        <input type="checkbox" name="planilla-completed-by-checkbox" id="cb-planilla-collab-unreg-${safeId}" value="${name}" checked>
                        <label for="cb-planilla-collab-unreg-${safeId}" style="margin: 0; font-size: 13px; font-weight: normal; cursor: pointer; color: var(--text-muted);">${name} (No registrado)</label>
                    `;
                    completedByContainer.appendChild(div);
                }
            });

            // 2. POPULATE CLIENTS IN AUTOCOMPLETE
            let isId = clientes.some(c => c.id === selectedClientId);
            let selectedClientObj = isId ? clientes.find(c => c.id === selectedClientId) : clientes.find(c => c.name.trim().toLowerCase() === (selectedClientId || "").trim().toLowerCase());

            if (selectedClientObj) {
                clientSearchInput.value = selectedClientObj.name;
                clientIdInput.value = selectedClientObj.id;
                renderAddressChoices(selectedClientObj, 'planilla-address-choices', 'planilla-address-value', selectedAddress, 'planilla');
            } else if (selectedClientId) {
                clientSearchInput.value = selectedClientId;
                clientIdInput.value = "";
                renderAddressChoices({ name: selectedClientId, addresses: ['Sin especificar'] }, 'planilla-address-choices', 'planilla-address-value', selectedAddress, 'planilla');
            } else {
                clientSearchInput.value = "";
                clientIdInput.value = "";
                renderAddressChoices(null, 'planilla-address-choices', 'planilla-address-value', '', 'planilla');
            }
        }

        window.editClient = function (id) {
            const c = clientes.find(client => client.id === id);
            if (!c) return;

            document.getElementById('client-id-edit').value = c.id;
            document.getElementById('client-name').value = c.name;
            document.getElementById('client-address-input').value = c.address;
            document.getElementById('client-phone').value = c.phone;

            document.getElementById('clientFormTitle').textContent = "Editar Cliente";
            document.getElementById('btnSaveClient').textContent = "Guardar Cambios";
            document.getElementById('btnCancelClientEdit').style.display = "block";
        };

        const btnCancelClientEdit = document.getElementById('btnCancelClientEdit');
        if (btnCancelClientEdit) {
            btnCancelClientEdit.addEventListener('click', () => {
                document.getElementById('client-id-edit').value = '';
                formNuevoCliente.reset();
                document.getElementById('clientFormTitle').textContent = "Nuevo Cliente";
                document.getElementById('btnSaveClient').textContent = "Guardar Cliente";
                btnCancelClientEdit.style.display = "none";
            });
        }

        window.deleteClient = async function (id) {
            if (confirm("¿Estás seguro de que deseas eliminar este cliente? Esto no borrará sus planillas de trabajo.")) {
                try {
                    await db.collection('clientes').doc(id).delete();
                    showToast("Cliente eliminado exitosamente", "success");
                } catch (error) {
                    console.error("Error al eliminar cliente:", error);
                    showToast("Error al eliminar cliente", "error");
                }
            }
        };

        window.viewClientHistory = function (id) {
            const client = clientes.find(c => c.id === id);
            if (!client) return;

            historyClientName.textContent = client.name;
            clientHistoryContainer.innerHTML = '';

            const clientSheets = planillas.filter(p => p.clientId === id);

            if (clientSheets.length === 0) {
                clientHistoryContainer.innerHTML = `<div style="text-align:center; color:var(--text-muted); padding:20px;">Este cliente aún no registra trabajos realizados.</div>`;
            } else {
                const parseDate = (dStr) => {
                    const parts = dStr.split('/');
                    if (parts.length === 3) {
                        return new Date(`${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`);
                    }
                    return new Date(dStr);
                };
                clientSheets.sort((a, b) => parseDate(b.date) - parseDate(a.date));

                clientSheets.forEach(p => {
                    const ord = ordenesTrabajo.find(o => o.id === p.orderId);
                    const equipment = ord ? ord.type : "Equipo no especificado";

                    const techHtml = (p.techDetails || 'Sin detalles')
                        .split('||')
                        .map(b => b.trim())
                        .filter(Boolean)
                        .map((b, idx) => `<div style="${idx > 0 ? 'margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--border-color, #e2e8f0);' : ''}">${b}</div>`)
                        .join('') || 'Sin detalles';

                    const div = document.createElement('div');
                    div.className = 'client-history-item';
                    div.innerHTML = `
                        <div class="client-history-item-header">
                            <span>OT: ${p.orderId}</span>
                            <span>${p.date}</span>
                        </div>
                        <div style="margin-bottom:6px;"><strong>Equipo:</strong> ${equipment}</div>
                        <div style="margin-bottom:6px;"><strong>Trabajo Realizado:</strong><div style="margin-top:4px; line-height:1.4;">${techHtml}</div></div>
                        <div style="margin-bottom:6px;"><strong>Repuestos Utilizados:</strong> ${p.spareParts || 'Ninguno'}</div>
                        <div><strong>Observaciones:</strong> ${p.observations || 'Sin observaciones'}</div>
                        <div style="text-align:right; font-size:11px; color:var(--text-muted); margin-top:8px;">Realizado por: ${p.completedBy || 'Técnico'}</div>
                    `;
                    clientHistoryContainer.appendChild(div);
                });
            }

            modalHistorialCliente.classList.add('show');
        };

        if (btnCloseHistoryModal) {
            btnCloseHistoryModal.addEventListener('click', () => {
                modalHistorialCliente.classList.remove('show');
            });
        }

        if (formNuevoCliente) {
            formNuevoCliente.addEventListener('submit', async (e) => {
                e.preventDefault();

                const id = document.getElementById('client-id-edit').value.trim();
                const name = document.getElementById('client-name').value.trim();
                const address = document.getElementById('client-address-input').value.trim();
                const phone = document.getElementById('client-phone').value.trim();

                const clientData = {
                    name: name,
                    address: address,
                    phone: phone,
                    history: []
                };

                try {
                    if (id) {
                        await db.collection('clientes').doc(id).update({
                            name: name,
                            address: address,
                            phone: phone
                        });
                        showToast("Cliente actualizado exitosamente", "success");
                    } else {
                        const newDocRef = db.collection('clientes').doc();
                        await newDocRef.set({
                            id: newDocRef.id,
                            ...clientData
                        });
                        showToast("Cliente creado exitosamente", "success");
                    }

                    formNuevoCliente.reset();
                    document.getElementById('client-id-edit').value = '';
                    document.getElementById('clientFormTitle').textContent = "Nuevo Cliente";
                    document.getElementById('btnSaveClient').textContent = "Guardar Cliente";
                    if (btnCancelClientEdit) btnCancelClientEdit.style.display = "none";
                } catch (error) {
                    console.error("Error al guardar cliente:", error);
                    showToast("Error al guardar cliente: " + error.message, "error");
                }
            });
        }

        if (searchClientInput) {
            searchClientInput.addEventListener('input', renderClientsTable);
        }

        const searchWorksheetInput = document.getElementById('searchWorksheetInput');
        if (searchWorksheetInput) {
            searchWorksheetInput.addEventListener('input', debounce(renderWorksheetsTable, 250));
        }

        const filterWorksheetWeek = document.getElementById('filterWorksheetWeek');
        if (filterWorksheetWeek) {
            filterWorksheetWeek.addEventListener('change', renderWorksheetsTable);
        }
        
        const filterWorksheetAuthor = document.getElementById('filterWorksheetAuthor');
        if (filterWorksheetAuthor) {
            filterWorksheetAuthor.addEventListener('change', renderWorksheetsTable);
        }
        
        const filterWorksheetAddress = document.getElementById('filterWorksheetAddress');
        if (filterWorksheetAddress) {
            filterWorksheetAddress.addEventListener('change', renderWorksheetsTable);
        }



        window.handleDeleteOrder = async function (orderId) {
            if (confirm(`¿Estás seguro de que deseas eliminar la orden ${orderId}?`)) {
                try {
                    await db.collection('ordenes').doc(orderId).delete();
                    showToast("Orden de trabajo eliminada", "success");
                } catch (error) {
                    console.error("Error al eliminar orden:", error);
                    showToast("Error al eliminar orden", "error");
                }
            }
        };



        function formatDateToISO(d) {
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        // --- LOGICA DE DETALLES Y EDICION DE ORDEN ---
        function updateDetailOrderCollabAvailability() {
            const orderId = document.getElementById('detail-order-id') ? document.getElementById('detail-order-id').textContent.trim() : null;
            const dateVal = document.getElementById('detail-date') ? document.getElementById('detail-date').value : '';
            const startVal = document.getElementById('detail-time') ? document.getElementById('detail-time').value : '';
            const endVal = document.getElementById('detail-time-end') ? document.getElementById('detail-time-end').value : '';
            updateContainerCollabAvailability('detail-assignees-checkboxes', dateVal, startVal, endVal, orderId, null);
        }

        function populateEditAssigneesCheckboxes(assignedList = [], currentOrderId = null) {
            const container = document.getElementById('detail-assignees-checkboxes');
            if (container) {
                container.innerHTML = '';
                colaboradores.forEach(c => {
                    if (c.role === 'Colaborador') {
                        const isChecked = assignedList.includes(c.name) ? 'checked' : '';
                        const div = document.createElement('div');
                        div.style.display = 'flex';
                        div.style.alignItems = 'center';
                        div.style.gap = '8px';
                        div.style.marginBottom = '6px';
                        div.innerHTML = `
                            <input type="checkbox" name="edit-order-assignees" id="cb-edit-collab-${c.username}" value="${c.name}" ${isChecked}>
                            <label for="cb-edit-collab-${c.username}" style="margin-bottom:0; font-weight:normal; color:var(--text-primary); cursor:pointer;">${c.name}</label>
                        `;
                        container.appendChild(div);
                    }
                });
                updateDetailOrderCollabAvailability();
            }
        }

        // Listeners para actualizar disponibilidad en tiempo real en modal detalle
        ['detail-date', 'detail-time', 'detail-time-end'].forEach(id => {
            const el = document.getElementById(id);
            if (el) {
                el.addEventListener('input', updateDetailOrderCollabAvailability);
                el.addEventListener('change', updateDetailOrderCollabAvailability);
            }
        });

        window.openOrderDetailsModal = function (orderId) {
            switchTab('ordenes');
            const iframe = document.querySelector('#mod-ordenes iframe');
            if (iframe) {
                if (!iframe.src) iframe.src = iframe.getAttribute('data-src');
                const trigger = () => {
                    if (iframe.contentWindow && typeof iframe.contentWindow.openOrderDetailsModal === 'function') {
                        iframe.contentWindow.openOrderDetailsModal(orderId);
                    } else {
                        setTimeout(trigger, 100);
                    }
                };
                setTimeout(trigger, 50);
            }
        };

        window.openUncoordinatedModal = function () {
            switchTab('ordenes');
            const iframe = document.querySelector('#mod-ordenes iframe');
            if (iframe) {
                if (!iframe.src) iframe.src = iframe.getAttribute('data-src');
                const trigger = () => {
                    if (iframe.contentWindow && typeof iframe.contentWindow.openUncoordinatedModal === 'function') {
                        iframe.contentWindow.openUncoordinatedModal();
                    } else {
                        setTimeout(trigger, 100);
                    }
                };
                setTimeout(trigger, 50);
            }
        };

        window.closeUncoordinatedModal = function () {
            const iframe = document.querySelector('#mod-ordenes iframe');
            if (iframe && iframe.contentWindow && typeof iframe.contentWindow.closeUncoordinatedModal === 'function') {
                iframe.contentWindow.closeUncoordinatedModal();
            }
        };



        // --- MÓDULO JORNALES: Eventos y cálculo modularizados en jornales.html ---

        // Configuración de Filtros de Fichaje (Admin)
        if (btnBuscarFichajes) {
            btnBuscarFichajes.addEventListener('click', () => {
                const checks = document.querySelectorAll('.fichajes-collab-check:checked');
                filterFichajesCollabs = Array.from(checks).map(c => c.value);

                const checkAll = document.getElementById('fichajesCollabAll');
                if (checkAll && checkAll.checked) {
                    filterFichajesCollabs = [];
                }

                filterFichajesDesdeVal = document.getElementById('filterFichajesDesde').value;
                filterFichajesHastaVal = document.getElementById('filterFichajesHasta').value;

                updateTablesAndViews();
            });
        }

        // Lógica del Modal Fichaje (Crear / Editar Fichaje Manual)
        function populateFichajeCollabsDropdown() {
            const selectEl = document.getElementById('fichaje-collab');
            if (selectEl) {
                selectEl.innerHTML = '';
                colaboradores.forEach(c => {
                    if (c.role === 'Colaborador') {
                        const opt = document.createElement('option');
                        opt.value = c.name;
                        opt.textContent = c.name;
                        selectEl.appendChild(opt);
                    }
                });
            }
        }

        // Lógica del Selector de Tipo de Fichaje (Botones Entrada Rojo / Salida Verde)
        window.setFichajeType = function (type) {
            const input = document.getElementById('fichaje-type');
            const btnEntrada = document.getElementById('btnTypeEntrada');
            const btnSalida = document.getElementById('btnTypeSalida');
            const errorEl = document.getElementById('fichajeTypeError');
            const selectorEl = document.getElementById('fichajeTypeSelector');

            if (input) input.value = type || '';

            if (btnEntrada) {
                if (type === 'Entrada') {
                    btnEntrada.classList.add('active');
                } else {
                    btnEntrada.classList.remove('active');
                }
            }

            if (btnSalida) {
                if (type === 'Salida') {
                    btnSalida.classList.add('active');
                } else {
                    btnSalida.classList.remove('active');
                }
            }

            if (type) {
                if (errorEl) errorEl.style.display = 'none';
                if (selectorEl) selectorEl.classList.remove('has-error');
            }
        };

        if (btnOpenAddFichajeModal) {
            btnOpenAddFichajeModal.addEventListener('click', () => {
                editFichajeId = null;
                document.getElementById('modalFichajeHeaderText').textContent = "Registrar Fichaje Manual";
                document.querySelector('#modalFichaje button[type="submit"]').textContent = "Registrar Fichaje";

                // Mostrar select de colaboradores y ocultar input de lectura
                document.getElementById('fichajeCollabGroup').style.display = 'block';
                document.getElementById('fichajeCollabNameGroup').style.display = 'none';
                document.getElementById('fichaje-collab').required = true;

                populateFichajeCollabsDropdown();

                // Autocompletar con fecha y hora actuales
                const now = getSyncedDate();
                document.getElementById('fichaje-date').value = getLocalISODate(now);

                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                document.getElementById('fichaje-time').value = `${hours}:${minutes}`;

                // Requerir selección explícita de Entrada o Salida
                setFichajeType('');
                const errorEl = document.getElementById('fichajeTypeError');
                if (errorEl) errorEl.style.display = 'none';
                const selectorEl = document.getElementById('fichajeTypeSelector');
                if (selectorEl) selectorEl.classList.remove('has-error');

                updateFichajeGpsUI();

                modalFichaje.classList.add('show');
            });
        }

        if (btnCloseFichajeModal) {
            btnCloseFichajeModal.addEventListener('click', () => {
                modalFichaje.classList.remove('show');
                formFichaje.reset();
                setFichajeType('');
                const errorEl = document.getElementById('fichajeTypeError');
                if (errorEl) errorEl.style.display = 'none';
                const selectorEl = document.getElementById('fichajeTypeSelector');
                if (selectorEl) selectorEl.classList.remove('has-error');
                editFichajeId = null;
                updateFichajeGpsUI();
            });
        }

        // Editar Fichaje (abrir modal en modo edición)
        window.editFichaje = function (id) {
            const f = fichajes.find(item => item.id === id);
            if (f) {
                editFichajeId = id;
                document.getElementById('modalFichajeHeaderText').textContent = "Editar Fichaje";
                document.querySelector('#modalFichaje button[type="submit"]').textContent = "Guardar Cambios";

                // Ocultar select de colaboradores y mostrar input de lectura
                document.getElementById('fichajeCollabGroup').style.display = 'none';
                document.getElementById('fichajeCollabNameGroup').style.display = 'block';
                document.getElementById('fichaje-collab-name-read').value = f.name;
                document.getElementById('fichaje-collab').required = false;

                // Cargar valores existentes
                document.getElementById('fichaje-date').value = f.date;
                document.getElementById('fichaje-time').value = formatTime12hTo24h(f.time);
                setFichajeType(f.type || 'Entrada');

                // Al editar desde la compu, siempre pasa a ser Manual (Sin GPS)
                updateFichajeGpsUI();

                modalFichaje.classList.add('show');
            }
        };

        // Eliminar Fichaje
        window.deleteFichaje = async function (id) {
            if (confirm("¿Estás seguro de que deseas eliminar este registro de fichaje?")) {
                try {
                    await db.collection('fichajes').doc(id).delete();
                    alert("Fichaje eliminado exitosamente.");
                } catch (error) {
                    console.error("Error al eliminar fichaje de Firestore: ", error);
                    alert("Error al eliminar fichaje: " + error.message);
                }
            }
        };

        // Formulario Fichaje Submit (Crear / Actualizar)
        if (formFichaje) {
            formFichaje.addEventListener('submit', async (event) => {
                event.preventDefault();

                const dateVal = document.getElementById('fichaje-date').value;
                const timeVal = document.getElementById('fichaje-time').value;
                const typeVal = document.getElementById('fichaje-type') ? document.getElementById('fichaje-type').value : '';
                const gpsVal = document.getElementById('fichaje-gps-status').value;

                // Validación obligatoria de tipo de fichaje
                if (!typeVal) {
                    const errorEl = document.getElementById('fichajeTypeError');
                    const selectorEl = document.getElementById('fichajeTypeSelector');
                    if (errorEl) errorEl.style.display = 'block';
                    if (selectorEl) {
                        selectorEl.classList.remove('has-error');
                        void selectorEl.offsetWidth; // Forzar reflow para reiniciar animación
                        selectorEl.classList.add('has-error');
                    }
                    alert("Por favor selecciona si el registro es de ENTRADA (Rojo) o SALIDA (Verde).");
                    return;
                }

                // Formatear hora
                const formattedTime = formatTime24hTo12h(timeVal);

                // Parseo de fecha y hora robusto compatible con todos los navegadores (incluso iOS/Safari)
                let timestampStr = "";
                try {
                    const dateParts = dateVal.split('-'); // ["YYYY", "MM", "DD"]
                    const timeParts = timeVal.split(':'); // ["HH", "MM"]
                    const yr = parseInt(dateParts[0], 10);
                    const mo = parseInt(dateParts[1], 10) - 1; // 0-indexed en JS
                    const dy = parseInt(dateParts[2], 10);
                    const hr = parseInt(timeParts[0], 10);
                    const mn = parseInt(timeParts[1], 10) || 0;
                    
                    const localDate = new Date(yr, mo, dy, hr, mn, 0);
                    timestampStr = localDate.toISOString();
                } catch (e) {
                    console.error("Error al parsear fecha/hora, usando fallback:", e);
                    timestampStr = new Date().toISOString();
                }

                // Configurar objeto GPS: cualquier fichaje registrado o editado desde la compu es estrictamente manual
                const gpsObj = { manual: true, verified: false };

                const submitBtn = formFichaje.querySelector('button[type="submit"]');
                if (submitBtn) {
                    if (submitBtn.disabled) return;
                    submitBtn.disabled = true;
                    submitBtn.textContent = 'Guardando...';
                }

                try {
                    const collabName = editFichajeId 
                        ? document.getElementById('fichaje-collab-name-read').value
                        : document.getElementById('fichaje-collab').value;
                    const selectedCollab = colaboradores.find(c => c.name === collabName);
                    const username = selectedCollab ? selectedCollab.username : "";
                    const targetUid = selectedCollab ? (selectedCollab.uid || selectedCollab.id) : null;

                    // Validar duplicados manuales a menos de 5 minutos
                    if (!editFichajeId) {
                        const existingRecent = fichajes.find(f => {
                            const matchName = f.name && f.name.trim().toLowerCase() === collabName.trim().toLowerCase();
                            if (!matchName) return false;
                            if (f.date !== dateVal) return false;
                            const diff = Math.abs(new Date(f.timestamp).getTime() - new Date(timestampStr).getTime());
                            return diff < 5 * 60 * 1000;
                        });
                        if (existingRecent) {
                            if (!confirm(`Atención: ${collabName} ya tiene un fichaje de ${existingRecent.type} registrado a las ${existingRecent.time} (menos de 5 minutos de diferencia).\n\n¿Deseas registrar este fichaje de todas formas?`)) {
                                if (submitBtn) {
                                    submitBtn.disabled = false;
                                    submitBtn.textContent = 'Registrar Fichaje';
                                }
                                return;
                            }
                        }
                    }

                    if (editFichajeId) {
                        // Actualizar fichaje existente
                        await db.collection('fichajes').doc(editFichajeId).update({
                            date: dateVal,
                            time: formattedTime,
                            timestamp: timestampStr,
                            type: typeVal,
                            gps: gpsObj
                        });

                        // Actualización inmediata en memoria local
                        const localIdx = fichajes.findIndex(item => item.id === editFichajeId);
                        if (localIdx !== -1) {
                            fichajes[localIdx] = {
                                ...fichajes[localIdx],
                                date: dateVal,
                                time: formattedTime,
                                timestamp: timestampStr,
                                type: typeVal,
                                gps: gpsObj
                            };
                            localStorage.setItem('electrofrio_fichajes', JSON.stringify(fichajes));
                            updateTablesAndViews();
                        }

                        alert("¡Fichaje actualizado exitosamente!");
                    } else {
                        // Crear nuevo fichaje manual
                        await db.collection('fichajes').add({
                            name: collabName,
                            username: username,
                            date: dateVal,
                            time: formattedTime,
                            timestamp: timestampStr,
                            type: typeVal,
                            gps: gpsObj
                        });
                        alert("¡Fichaje manual registrado exitosamente!");
                    }

                    // Sincronizar el estado de servicio (online/offline) en Firestore
                    if (targetUid) {
                        await db.collection('usuarios').doc(targetUid).update({
                            status: typeVal === 'Entrada' ? 'online' : 'offline'
                        });
                    }

                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = 'Registrar Fichaje';
                    }
                    modalFichaje.classList.remove('show');
                    formFichaje.reset();
                    editFichajeId = null;
                    updateFichajeGpsUI();
                } catch (error) {
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.textContent = editFichajeId ? 'Guardar Cambios' : 'Registrar Fichaje';
                    }
                    console.error("Error al guardar fichaje en Firestore: ", error);
                    alert("Error al guardar fichaje: " + error.message);
                }
            });
        }

        // Alternar vista de Login / Aplicación
        function showApp() {
            loginSection.classList.add('hidden');
            appSection.classList.remove('hidden');
            document.body.style.alignItems = 'stretch';
            document.body.style.justifyContent = 'flex-start';
            configureRoleUI();

            // Pedir permisos de notificaciones de sistema para el colaborador
            const userRole = localStorage.getItem('electrofrio_role');
            if (userRole === 'Colaborador') {
                requestNotificationPermission();
            }

            // Cargar datos locales de inicio para visualización rápida (offline-first / file://)
            const cachedCollabs = localStorage.getItem('electrofrio_collaborators');
            if (cachedCollabs) colaboradores = JSON.parse(cachedCollabs);

            const cachedClients = localStorage.getItem('electrofrio_clients');
            if (cachedClients) clientes = JSON.parse(cachedClients);
            populateClientSelects();

            const cachedOrders = localStorage.getItem('electrofrio_workorders');
            if (cachedOrders) ordenesTrabajo = JSON.parse(cachedOrders);

            const cachedFichajes = localStorage.getItem('electrofrio_fichajes');
            if (cachedFichajes) fichajes = JSON.parse(cachedFichajes);

            if (window.localHistoricalPlanillas && Array.isArray(window.localHistoricalPlanillas)) {
                const cachedSheets = localStorage.getItem('electrofrio_worksheets');
                const parsedCached = cachedSheets ? JSON.parse(cachedSheets) : [];
                const existingPdtCodes = new Set(parsedCached.map(s => s.pdtCode));
                const filteredHistory = window.localHistoricalPlanillas.filter(h => !existingPdtCodes.has(h.pdtCode));
                planillas = [...parsedCached, ...filteredHistory];
                localStorage.setItem('electrofrio_worksheets', JSON.stringify(planillas));
            } else {
                const cachedSheets = localStorage.getItem('electrofrio_worksheets');
                if (cachedSheets) planillas = JSON.parse(cachedSheets);
            }

            updateTablesAndViews();

            // Seed Firestore if needed
            checkAndSeedFirestore();

            // Activar sincronización de colaboradores en tiempo real desde Firestore
            if (!unsubscribeCollabs) {
                unsubscribeCollabs = db.collection('usuarios').onSnapshot((querySnapshot) => {
                    const updatedCollabs = [];
                    let currentUserUpdated = null;
                    const myUid = localStorage.getItem('electrofrio_uid');

                    querySnapshot.forEach((doc) => {
                        const data = doc.data();
                        updatedCollabs.push(data);
                        if (data.uid === myUid) {
                            currentUserUpdated = data;
                        }
                    });
                    colaboradores = updatedCollabs;
                    localStorage.setItem('electrofrio_collaborators', JSON.stringify(colaboradores));

                    if (currentUserUpdated) {
                        localStorage.setItem('electrofrio_role', currentUserUpdated.role);
                        localStorage.setItem('electrofrio_name', currentUserUpdated.name);
                        localStorage.setItem('electrofrio_premium', currentUserUpdated.premium ? 'true' : 'false');
                        configureRoleUI();
                    }

                    // Re-renderizar filtros de colaboradores en Fichajes y Jornales
                    renderFichajesFilterCollabs();
                    renderJornalesFilterCollabs();

                    updateTablesAndViews();
                }, (error) => {
                    console.error("Error al sincronizar usuarios de Firestore:", error);
                });
            }

            // Activar sincronización de fichajes en tiempo real desde Firestore
            // OPTIMIZACIÓN: Solo escucha el mes actual para reducir lecturas.
            // El historial anterior se carga bajo demanda desde renderFichajesHistorial().
            if (!unsubscribeFichajes) {
                const inicio5DiasFichajes = (() => {
                    const now = new Date();
                    const d = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 4, 0, 0, 0, 0);
                    return d.toISOString();
                })();
                unsubscribeFichajes = db.collection('fichajes')
                    .where('timestamp', '>=', inicio5DiasFichajes)
                    .onSnapshot((querySnapshot) => {
                    const updatedFichajes = [];
                    querySnapshot.forEach((doc) => {
                        const data = doc.data();
                        data.id = doc.id;
                        updatedFichajes.push(data);
                    });
                    // Ordenar por timestamp descendente
                    updatedFichajes.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                    // Fusionar con historial previamente cargado bajo demanda
                    const historical = window._fichajesHistorial || [];
                    const currentIds = new Set(updatedFichajes.map(f => f.id));
                    const merged = [...updatedFichajes, ...historical.filter(f => !currentIds.has(f.id))];
                    merged.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                    fichajes = merged;
                    localStorage.setItem('electrofrio_fichajes', JSON.stringify(fichajes));
                    updateTablesAndViews();
                }, (error) => {
                    console.error("Error al sincronizar fichajes de Firestore:", error);
                });
            }

            // Activar sincronización de clientes en tiempo real desde Firestore
            if (!unsubscribeClientes) {
                unsubscribeClientes = db.collection('clientes').onSnapshot((querySnapshot) => {
                    const updatedClients = [];
                    querySnapshot.forEach((doc) => {
                        const data = doc.data();
                        data.id = doc.id;
                        
                        if (!Array.isArray(data.addresses)) {
                            data.addresses = [];
                        }
                        if (data.address && !data.addresses.includes(data.address)) {
                            data.addresses.unshift(data.address);
                        }
                        if (!data.addresses.includes("Sin especificar")) {
                            data.addresses.push("Sin especificar");
                        }
                        if (!data.address) {
                            data.address = data.addresses[0] || "Sin especificar";
                        }

                        updatedClients.push(data);
                    });
                    updatedClients.sort((a, b) => a.name.localeCompare(b.name));

                    // Garantizar código inalterable permanente a cada cliente
                    updatedClients.forEach((c, idx) => {
                        if (!c.clientCode) {
                            if (c.id && (c.id.startsWith('CLI-') || c.id.startsWith('cli-'))) {
                                c.clientCode = c.id.toUpperCase();
                            } else {
                                c.clientCode = `CLI-${String(idx + 1).padStart(4, '0')}`;
                            }
                            db.collection('clientes').doc(c.id).update({ clientCode: c.clientCode }).catch(() => {});
                        }
                    });

                    clientes = updatedClients;
                    localStorage.setItem('electrofrio_clients', JSON.stringify(clientes));

                    populateClientSelects();
                    renderClientsTable();
                }, (error) => {
                    console.error("Error al sincronizar clientes de Firestore:", error);
                });
            }

            // Función para fusionar órdenes de tiempo real, órdenes sin coordinar e historial bajo demanda
            function mergeOrdenesTrabajo() {
                const currentMonth = window._ordenesMesActual || [];
                const uncoordinated = window._ordenesSinCoordinar || [];
                const historical = window._ordenesHistorial || [];

                const map = new Map();
                // 1. Histórico bajo demanda (si el usuario hizo clic en "Ver historial")
                historical.forEach(o => map.set(o.id, o));
                // 2. Órdenes sin coordinar (siempre visibles sin cargar todo el historial)
                uncoordinated.forEach(o => map.set(o.id, o));
                // 3. Órdenes recientes en tiempo real (máxima prioridad)
                currentMonth.forEach(o => map.set(o.id, o));

                const merged = Array.from(map.values());
                merged.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                ordenesTrabajo = merged;
                localStorage.setItem('electrofrio_workorders', JSON.stringify(ordenesTrabajo));
                updateTablesAndViews();
            }
            window.mergeOrdenesTrabajo = mergeOrdenesTrabajo;

            if (!unsubscribeOrdenes) {
                // OPTIMIZACIÓN: Sincronización en tiempo real de los últimos 20 días (en lugar de solo el mes actual)
                const inicioOrdenes20Dias = (() => {
                    const d = new Date();
                    d.setDate(d.getDate() - 20);
                    return d.toISOString();
                })();
                unsubscribeOrdenes = db.collection('ordenes')
                    .where('timestamp', '>=', inicioOrdenes20Dias)
                    .onSnapshot((querySnapshot) => {
                    const updatedOrders = [];
                    querySnapshot.forEach((doc) => {
                        const data = doc.data();
                        data.id = doc.id;
                        updatedOrders.push(data);
                    });
                    updatedOrders.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                    window._ordenesMesActual = updatedOrders;

                    // Notificación en tiempo real de nuevas órdenes para el colaborador
                    const role = localStorage.getItem('electrofrio_role');
                    if (role === 'Colaborador') {
                        const currentName = localStorage.getItem('electrofrio_name');
                        if (currentName) {
                            const myNewOrders = updatedOrders.filter(o => isOrderAssignedToUser(o, currentName) && o.status !== 'Completado');
                            const myNewIds = myNewOrders.map(o => o.id);
                            
                            if (window.lastAssignedOrderIds) {
                                const newAssigned = myNewIds.filter(id => !window.lastAssignedOrderIds.has(id));
                                if (newAssigned.length > 0) {
                                    newAssigned.forEach(id => {
                                        const o = myNewOrders.find(order => order.id === id);
                                        showToast(`🔔 ¡Nueva orden de trabajo asignada! ${o.id} - ${o.client}`, "success");
                                        try {
                                            const audioCtx = new (window.AudioContext || window.webkitAudioContext)();
                                            const oscillator = audioCtx.createOscillator();
                                            const gainNode = audioCtx.createGain();
                                            oscillator.connect(gainNode);
                                            gainNode.connect(audioCtx.destination);
                                            oscillator.type = 'sine';
                                            oscillator.frequency.setValueAtTime(880, audioCtx.currentTime);
                                            gainNode.gain.setValueAtTime(0.05, audioCtx.currentTime);
                                            oscillator.start();
                                            oscillator.stop(audioCtx.currentTime + 0.15);
                                        } catch (e) {}
                                    });
                                }
                            }
                            window.lastAssignedOrderIds = new Set(myNewIds);
                        }
                    }

                    mergeOrdenesTrabajo();
                }, (error) => {
                    console.error("Error al sincronizar ordenes de Firestore:", error);
                });
            }

            // Sincronización en tiempo real de órdenes SIN COORDINAR (date == '')
            // Permite ver el contador y la lista de tareas sin coordinar al instante sin cargar todo el historial histórico
            if (!unsubscribeOrdenesSinCoordinar) {
                unsubscribeOrdenesSinCoordinar = db.collection('ordenes')
                    .where('date', '==', '')
                    .onSnapshot((querySnapshot) => {
                    const uncoordinatedOrders = [];
                    querySnapshot.forEach((doc) => {
                        const data = doc.data();
                        data.id = doc.id;
                        if (data.status !== 'Completado') {
                            uncoordinatedOrders.push(data);
                        }
                    });
                    uncoordinatedOrders.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                    window._ordenesSinCoordinar = uncoordinatedOrders;
                    mergeOrdenesTrabajo();
                }, (error) => {
                    console.error("Error al sincronizar órdenes sin coordinar de Firestore:", error);
                });
            }

            // Activar sincronización de planillas en tiempo real desde Firestore
            
            // Activar sincronización de tareas en tiempo real desde Firestore
            if (!unsubscribeTareas) {
                unsubscribeTareas = db.collection('tareas').onSnapshot((querySnapshot) => {
                    const updatedTareas = [];
                    querySnapshot.forEach((doc) => {
                        const data = doc.data();
                        data.id = doc.id;
                        updatedTareas.push(data);
                    });
                    tareas = updatedTareas;
                    localStorage.setItem('electrofrio_tareas', JSON.stringify(tareas));
                    updateTablesAndViews(); // Refresh view
                });
            }

            if (!unsubscribePlanillas) {
                unsubscribePlanillas = db.collection('planillas')
                    .onSnapshot((querySnapshot) => {
                    const updatedSheets = [];
                    querySnapshot.forEach((doc) => {
                        const data = doc.data();
                        data.id = doc.id;
                        if (window._pendingPlanillaUpdates && window._pendingPlanillaUpdates[doc.id]) {
                            Object.assign(data, window._pendingPlanillaUpdates[doc.id]);
                        }
                        updatedSheets.push(data);
                    });

                    // Mergear con el historial local (historial_parsed.js) si existe
                    if (window.localHistoricalPlanillas && Array.isArray(window.localHistoricalPlanillas)) {
                        const existingPdtCodes = new Set(updatedSheets.map(s => s.pdtCode));
                        const filteredHistory = window.localHistoricalPlanillas.filter(h => !existingPdtCodes.has(h.pdtCode));
                        planillas = [...updatedSheets, ...filteredHistory];
                        localStorage.setItem('electrofrio_worksheets', JSON.stringify(planillas));
                        updateTablesAndViews();
                    } else {
                        // Solo Firestore
                        planillas = updatedSheets;
                        localStorage.setItem('electrofrio_worksheets', JSON.stringify(planillas));
                        updateTablesAndViews();
                    }
                }, (error) => {
                    console.error("Error al sincronizar planillas de Firestore:", error);
                });
            }
        }

        // ─── HISTORIAL BAJO DEMANDA ──────────────────────────────────────────────
        // Helper global para mergear órdenes si se invoca desde el historial
        function mergeOrdenesTrabajo() {
            if (typeof window.mergeOrdenesTrabajo === 'function') {
                window.mergeOrdenesTrabajo();
                return;
            }
            const currentOrders = window._ordenesMesActual || [];
            const uncoordinated = window._ordenesSinCoordinar || [];
            const historical = window._ordenesHistorial || [];

            const map = new Map();
            historical.forEach(o => map.set(o.id, o));
            uncoordinated.forEach(o => map.set(o.id, o));
            currentOrders.forEach(o => map.set(o.id, o));

            const merged = Array.from(map.values());
            merged.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
            ordenesTrabajo = merged;
            localStorage.setItem('electrofrio_workorders', JSON.stringify(ordenesTrabajo));
            if (typeof updateTablesAndViews === 'function') {
                updateTablesAndViews();
            }
        }
        window.mergeOrdenesTrabajo = window.mergeOrdenesTrabajo || mergeOrdenesTrabajo;

        // Carga órdenes de los últimos 20 días como lectura única (getDocs).
        // Se cachea en window._ordenesHistorial para no releer Firestore en la sesión.
        window.loadOrdenesHistorial = async function() {
            const btn = document.getElementById('btnVerHistorialOrdenes');
            if (!window._ordenesHistorialCargado) {
                if (btn) { btn.disabled = true; btn.textContent = '⏳ Cargando...'; }
                try {
                    const hace20Dias = new Date(Date.now() - 20 * 24 * 60 * 60 * 1000).toISOString();
                    const snap = await db.collection('ordenes')
                        .where('timestamp', '<', hace20Dias)
                        .get();
                    const hist = [];
                    snap.forEach(doc => {
                        const data = doc.data();
                        data.id = doc.id;
                        hist.push(data);
                    });
                    window._ordenesHistorial = hist;
                    window._ordenesHistorialCargado = true;
                    window._mostrarHistorialCompleto = true;
                    if (typeof window.mergeOrdenesTrabajo === 'function') {
                        window.mergeOrdenesTrabajo();
                    } else {
                        mergeOrdenesTrabajo();
                    }
                    if (btn) { btn.disabled = false; btn.textContent = '📂 Ocultar historial (>7d)'; }
                    showToast(`📂 Historial completo cargado (${hist.length} órdenes históricas)`, 'success');
                } catch(e) {
                    console.error('Error cargando historial de órdenes:', e);
                    if (btn) { btn.disabled = false; btn.textContent = '📂 Ver historial'; }
                    showToast('Error al cargar historial de órdenes', 'error');
                }
            } else {
                // Ya descargado: alternar vista entre historial completo y últimos 7 días
                window._mostrarHistorialCompleto = !window._mostrarHistorialCompleto;
                if (btn) {
                    btn.textContent = window._mostrarHistorialCompleto ? '📂 Ocultar historial (>7d)' : '📂 Ver historial';
                }
                updateTablesAndViews();
            }
        };

        // Carga fichajes anteriores al mes actual como lectura única (getDocs).
        window.loadFichajesHistorial = async function() {
            if (window._fichajesHistorialCargado) return;
            const btn = document.getElementById('btnVerHistorialFichajes');
            if (btn) { btn.disabled = true; btn.textContent = '⏳ Cargando...'; }
            try {
                const finMes = new Date(new Date().getFullYear(), new Date().getMonth(), 1).toISOString();
                const snap = await db.collection('fichajes')
                    .where('timestamp', '<', finMes)
                    .get();
                const hist = [];
                snap.forEach(doc => {
                    const data = doc.data();
                    data.id = doc.id;
                    hist.push(data);
                });
                window._fichajesHistorial = hist;
                window._fichajesHistorialCargado = true;
                const currentIds = new Set(fichajes.map(f => f.id));
                const merged = [...fichajes, ...hist.filter(f => !currentIds.has(f.id))];
                merged.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
                fichajes = merged;
                localStorage.setItem('electrofrio_fichajes', JSON.stringify(fichajes));
                updateTablesAndViews();
                if (btn) { btn.textContent = '✅ Historial cargado'; btn.disabled = true; }
                showToast(`📂 ${hist.length} fichajes históricos cargados`, 'success');
            } catch(e) {
                console.error('Error cargando historial de fichajes:', e);
                if (btn) { btn.disabled = false; btn.textContent = '📂 Ver historial'; }
                showToast('Error al cargar historial de fichajes', 'error');
            }
        };
        // ────────────────────────────────────────────────────────────────────────

        async function checkAndSeedFirestore() {
            try {
                // Seed Clientes
                const clientsSnap = await db.collection('clientes').limit(1).get();
                if (clientsSnap.empty) {
                    const defaultClients = JSON.parse(localStorage.getItem('electrofrio_clients')) || [];
                    for (const c of defaultClients) {
                        await db.collection('clientes').doc(c.id).set(c);
                    }
                    console.log("Seeding clientes in Firestore...");
                }

                // Seed Ordenes
                const ordersSnap = await db.collection('ordenes').limit(1).get();
                if (ordersSnap.empty) {
                    const defaultOrders = JSON.parse(localStorage.getItem('electrofrio_workorders')) || [];
                    for (const o of defaultOrders) {
                        await db.collection('ordenes').doc(o.id).set(o);
                    }
                    console.log("Seeding ordenes in Firestore...");
                }

                // Seed Planillas
                const planillasSnap = await db.collection('planillas').limit(1).get();
                if (planillasSnap.empty) {
                    const defaultWorksheets = JSON.parse(localStorage.getItem('electrofrio_worksheets')) || [];
                    for (const w of defaultWorksheets) {
                        await db.collection('planillas').doc(w.id).set(w);
                    }
                    console.log("Seeding planillas in Firestore...");
                }
            } catch (err) {
                console.error("Error seeding Firestore: ", err);
            }
        }

        function hideApp() {
            appSection.classList.add('hidden');
            loginSection.classList.remove('hidden');
            document.body.style.alignItems = 'center';
            document.body.style.justifyContent = 'center';
            document.body.className = ''; // Limpiar clases del body

            // Cerrar sidebar y backdrop por las dudas
            sidebar.classList.remove('open');
            sidebarBackdrop.classList.remove('show');

            // Desactivar sincronizaciones
            if (unsubscribeCollabs) {
                unsubscribeCollabs();
                unsubscribeCollabs = null;
            }
            if (unsubscribeFichajes) {
                unsubscribeFichajes();
                unsubscribeFichajes = null;
            }
            if (unsubscribeClientes) {
                unsubscribeClientes();
                unsubscribeClientes = null;
            }
            if (unsubscribeOrdenes) {
                unsubscribeOrdenes();
                unsubscribeOrdenes = null;
            }
            if (unsubscribeOrdenesSinCoordinar) {
                unsubscribeOrdenesSinCoordinar();
                unsubscribeOrdenesSinCoordinar = null;
            }
            
            if (unsubscribeTareas) {
                unsubscribeTareas();
                unsubscribeTareas = null;
            }

            if (unsubscribePlanillas) {
                unsubscribePlanillas();
                unsubscribePlanillas = null;
            }
        }

        // Navegación entre pestañas
        window.switchTab = function switchTab(moduleName) {
            const role = localStorage.getItem('electrofrio_role') || 'Colaborador';
            const isPremium = localStorage.getItem('electrofrio_premium') === 'true';

            let allowedModules = [];
            if (role === 'Administrador') {
                allowedModules = ['dashboard', 'ordenes', 'tareas', 'calendario', 'mapa', 'fichajes', 'jornales', 'database', 'colaboradores', 'clientes', 'importaciones', 'materiales', 'manodeobra', 'presupuesto', 'proveedores', 'crm', 'cobros', 'configuracion'];
            } else if (isPremium) {
                allowedModules = ['dashboard', 'ordenes', 'tareas', 'calendario', 'database', 'fichajes', 'presupuesto', 'proveedores', 'crm', 'cobros'];
            } else {
                allowedModules = ['dashboard', 'ordenes', 'tareas', 'calendario', 'database', 'fichajes'];
            }

            if (!allowedModules.includes(moduleName)) {
                moduleName = 'dashboard';
            }

            navItems.forEach(item => {
                if (item.getAttribute('data-module') === moduleName) {
                    item.classList.add('active');
                } else {
                    item.classList.remove('active');
                }
            });

            let hasActiveIframe = false;
            pages.forEach(page => {
                if (page.id === `mod-${moduleName}`) {
                    page.classList.remove('hidden');
                    // Carga perezosa (Lazy Load) de módulos en iframe solo al ser visitados por el usuario
                    const iframe = page.querySelector('iframe[data-src]');
                    if (iframe) {
                        hasActiveIframe = true;
                        if (!iframe.getAttribute('src')) {
                            iframe.src = iframe.getAttribute('data-src');
                        }
                    }
                } else {
                    page.classList.add('hidden');
                }
            });

            const contentArea = document.getElementById('contentArea');
            if (contentArea) {
                if (hasActiveIframe) {
                    contentArea.classList.add('iframe-active');
                } else {
                    contentArea.classList.remove('iframe-active');
                }
            }

            if (moduleName === 'calendario') {
                setTimeout(() => {
                    initGoogleCalendar();
                }, 100);
            }
            
            if (moduleName === 'mapa' && role === 'Administrador') {
                setTimeout(() => {
                    if (typeof initTechMap === 'function') {
                        initTechMap();
                    }
                }, 100);
            }

            if (moduleName === 'configuracion') {
                setTimeout(() => {
                    if (typeof actualizarEstadoUIBackup === 'function') {
                        actualizarEstadoUIBackup();
                    }
                }, 100);
            }

            // Expandir submenú si se activa un submódulo, colapsar si es otro
            const submenu = document.getElementById('submenuDatabase');
            const parentGroup = document.getElementById('btnGroupDatabase')?.closest('.nav-group');
            if (['colaboradores', 'clientes', 'importaciones', 'materiales', 'manodeobra'].includes(moduleName)) {
                if (submenu) submenu.classList.add('open');
                if (parentGroup) parentGroup.classList.add('open');
            } else {
                if (submenu) submenu.classList.remove('open');
                if (parentGroup) parentGroup.classList.remove('open');
            }

            // Expandir/colapsar submenú Utilidades
            const submenuUtil = document.getElementById('submenuUtilidades');
            const parentGroupUtil = document.getElementById('btnGroupUtilidades')?.closest('.nav-group');
            if (['presupuesto', 'proveedores', 'crm', 'cobros'].includes(moduleName)) {
                if (submenuUtil) submenuUtil.classList.add('open');
                if (parentGroupUtil) parentGroupUtil.classList.add('open');
            } else {
                if (submenuUtil) submenuUtil.classList.remove('open');
                if (parentGroupUtil) parentGroupUtil.classList.remove('open');
            }

            if (moduleName === 'calendario') {
                setTimeout(() => {
                    initGoogleCalendar();
                }, 100);
            }

            const activeNavItem = document.querySelector(`.nav-item[data-module="${moduleName}"]`);
            if (activeNavItem) {
                const spanText = activeNavItem.querySelector('span').textContent;
                moduleTitle.textContent = moduleName === 'dashboard' ? 'Dashboard' : spanText;
            }

            localStorage.setItem('electrofrio_active_module', moduleName);
            updateTablesAndViews();
        }

        // Toggle submenú Base de Datos
        const btnGroupDatabase = document.getElementById('btnGroupDatabase');
        const submenuDatabase = document.getElementById('submenuDatabase');
        if (btnGroupDatabase && submenuDatabase) {
            btnGroupDatabase.addEventListener('click', () => {
                const parentGroup = btnGroupDatabase.closest('.nav-group');
                parentGroup.classList.toggle('open');
                submenuDatabase.classList.toggle('open');
            });
        }

        // Toggle submenú Utilidades
        const btnGroupUtilidades = document.getElementById('btnGroupUtilidades');
        const submenuUtilidades = document.getElementById('submenuUtilidades');
        if (btnGroupUtilidades && submenuUtilidades) {
            btnGroupUtilidades.addEventListener('click', () => {
                const parentGroup = btnGroupUtilidades.closest('.nav-group');
                parentGroup.classList.toggle('open');
                submenuUtilidades.classList.toggle('open');
            });
        }

        // Configuración de eventos para cada opción del menú lateral
        navItems.forEach(item => {
            item.addEventListener('click', () => {
                const targetModule = item.getAttribute('data-module');
                switchTab(targetModule);

                // En móvil, cerrar la barra al hacer click en una opción
                if (window.innerWidth <= 768) {
                    sidebar.classList.remove('open');
                    sidebarBackdrop.classList.remove('show');
                }
            });
        });

        // Alternar barra lateral (colapso / apertura de drawer en móvil)
        const collapseBtn = document.querySelector('.collapse-btn');
        const sidebar = document.querySelector('.sidebar');
        collapseBtn.addEventListener('click', () => {
            if (window.innerWidth <= 768) {
                // Modo móvil: alternar la clase open y mostrar/ocultar el backdrop
                sidebar.classList.toggle('open');
                document.getElementById('sidebarBackdrop').classList.toggle('show');
            } else {
                // Modo escritorio: alternar colapso normal
                if (sidebar.style.width === '0px' || sidebar.classList.contains('collapsed')) {
                    sidebar.style.width = '270px';
                    sidebar.classList.remove('collapsed');
                    collapseBtn.querySelector('svg').style.transform = 'rotate(0deg)';
                } else {
                    sidebar.style.width = '0px';
                    sidebar.classList.add('collapsed');
                    collapseBtn.querySelector('svg').style.transform = 'rotate(180deg)';
                }
            }
        });
        collapseBtn.querySelector('svg').style.transition = 'transform 0.2s';

        // Cerrar barra lateral al hacer click en el fondo oscuro (backdrop)
        const sidebarBackdrop = document.getElementById('sidebarBackdrop');
        if (sidebarBackdrop) {
            sidebarBackdrop.addEventListener('click', () => {
                sidebar.classList.remove('open');
                sidebarBackdrop.classList.remove('show');
            });
        }

        // --- LÓGICA DEL MODAL DE CREACIÓN DE COLABORADORES ---
        if (btnQuickAddCollab) {
            btnQuickAddCollab.addEventListener('click', () => {
                switchTab('colaboradores');
                const iframe = document.querySelector('#mod-colaboradores iframe');
                if (iframe) {
                    if (!iframe.src) iframe.src = iframe.getAttribute('data-src');
                    const trigger = () => {
                        if (iframe.contentWindow && typeof iframe.contentWindow.openAddCollabModal === 'function') {
                            iframe.contentWindow.openAddCollabModal();
                        } else {
                            setTimeout(trigger, 100);
                        }
                    };
                    setTimeout(trigger, 50);
                }
            });
        }

        // ------------------ MÓDULO CALENDARIO (Extraído a calendario.html) ------------------
        let googleAccessToken = localStorage.getItem('electrofrio_gcal_token') || null;

        function initGoogleCalendar() {
            const calIframe = document.querySelector('#mod-calendario iframe');
            if (calIframe && calIframe.contentWindow && typeof calIframe.contentWindow.renderCalendarEvents === 'function') {
                try { calIframe.contentWindow.renderCalendarEvents(); } catch (e) {}
            }
        }

        window.syncOrderToGoogleCalendar = async function(ord) {
            if (!googleAccessToken || !ord.date || !ord.time) return;

            const startDateTime = `${ord.date}T${ord.time}:00-03:00`; // Asumiendo zona horaria GMT-3 (Argentina)
            
            // Calculamos una duración por defecto de 1 hora
            const startObj = new Date(startDateTime);
            const endObj = new Date(startObj.getTime() + 60 * 60 * 1000);
            const endDateTime = endObj.toISOString();

            const event = {
                summary: `ElectroFrío: ${ord.id} - ${ord.client}`,
                location: ord.address,
                description: `Descripción del trabajo: ${ord.type}\nEstado: ${ord.status}\nAsignados: ${ord.assignees ? ord.assignees.join(', ') : ''}`,
                start: {
                    dateTime: startDateTime,
                    timeZone: 'America/Argentina/Buenos_Aires'
                },
                end: {
                    dateTime: endDateTime,
                    timeZone: 'America/Argentina/Buenos_Aires'
                }
            };

            try {
                // Para simplificar, siempre creamos el evento en vez de buscar si ya existe y actualizarlo
                // En una versión más avanzada se guardaría el eventId de Google dentro de ord.gcalId
                const res = await fetch("https://www.googleapis.com/calendar/v3/calendars/primary/events", {
                    method: "POST",
                    headers: {
                        "Authorization": `Bearer ${googleAccessToken}`,
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify(event)
                });
                
                if (res.status === 401) {
                    // Token expirado
                    googleAccessToken = null;
                    localStorage.removeItem('electrofrio_gcal_token');
                    updateGoogleAuthUI();
                    console.log("Token de Google expirado");
                }
            } catch (err) {
                console.error("Error sync to gcal", err);
            }
        };
        // --- MAPA DE TÉCNICOS (MIGRADO A modulos/mapa.html) ---
        window.initTechMap = function() {
            const iframe = document.querySelector('#mod-mapa iframe');
            if (iframe && iframe.contentWindow && typeof iframe.contentWindow.refreshTechMap === 'function') {
                iframe.contentWindow.refreshTechMap();
            }
        };
        window.refreshTechMap = function() {
            const iframe = document.querySelector('#mod-mapa iframe');
            if (iframe && iframe.contentWindow && typeof iframe.contentWindow.refreshTechMap === 'function') {
                iframe.contentWindow.refreshTechMap();
            }
        };

        // RASTREO GPS CONTINUO PARA COLABORADORES
        // RASTREO GPS CONTINUO (DESHABILITADO: Geolocalización únicamente al presionar el botón de fichar)
        let watchId = null;
        window.startLocationTracking = function(role) {
            return;
        };

        window.fixCapitalizationMigration = async function() {
            if (!confirm("Esto capitalizará la primera letra de todos los nombres y usuarios en la base de datos y actualizará todas las planillas, órdenes y fichajes vinculados. ¿Continuar?")) return;
            try {
                const btn = document.getElementById('btn-migrar-nombres');
                if (btn) btn.textContent = 'Migrando... (no cierres la página)';
                
                const usersSnap = await db.collection('usuarios').get();
                let nameMap = {};
                let usernameMap = {};
                
                const capitalize = (str) => str.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
                
                let batch = db.batch();
                let opCount = 0;
                
                usersSnap.docs.forEach(doc => {
                    const data = doc.data();
                    let updates = {};
                    
                    if (data.name) {
                        const newName = capitalize(data.name);
                        if (data.name !== newName) {
                            nameMap[data.name] = newName;
                            updates.name = newName;
                        }
                    }
                    
                    if (data.username) {
                        const newUsername = capitalize(data.username);
                        if (data.username !== newUsername) {
                            usernameMap[data.username] = newUsername;
                            updates.username = newUsername;
                        }
                    }
                    
                    if (Object.keys(updates).length > 0) {
                        batch.update(doc.ref, updates);
                        opCount++;
                    }
                });
                
                const fichajesSnap = await db.collection('fichajes').get();
                fichajesSnap.docs.forEach(doc => {
                    const data = doc.data();
                    let updates = {};
                    if (nameMap[data.colaborador]) updates.colaborador = nameMap[data.colaborador];
                    if (usernameMap[data.username]) updates.username = usernameMap[data.username];
                    if (Object.keys(updates).length > 0) {
                        batch.update(doc.ref, updates);
                        opCount++;
                        if (opCount >= 490) {
                            // Firestore batch limit is 500
                            batch.commit();
                            batch = db.batch();
                            opCount = 0;
                        }
                    }
                });
                
                const ordenesSnap = await db.collection('ordenesTrabajo').get();
                ordenesSnap.docs.forEach(doc => {
                    const data = doc.data();
                    if (data.assignees && data.assignees.length > 0) {
                        let changed = false;
                        const newAssignees = data.assignees.map(a => {
                            if (nameMap[a]) { changed = true; return nameMap[a]; }
                            return a;
                        });
                        if (changed) {
                            batch.update(doc.ref, { assignees: newAssignees });
                            opCount++;
                            if (opCount >= 490) {
                                batch.commit();
                                batch = db.batch();
                                opCount = 0;
                            }
                        }
                    }
                });
                
                const planillasSnap = await db.collection('planillasDigitales').get();
                planillasSnap.docs.forEach(doc => {
                    const data = doc.data();
                    if (nameMap[data.tecnico]) {
                        batch.update(doc.ref, { tecnico: nameMap[data.tecnico] });
                        opCount++;
                        if (opCount >= 490) {
                            batch.commit();
                            batch = db.batch();
                            opCount = 0;
                        }
                    }
                });
                
                await batch.commit();
                
                // Actualizar localStorage con el username capitalizado
                const currentUser = localStorage.getItem('electrofrio_user');
                if (currentUser && usernameMap[currentUser]) {
                    localStorage.setItem('electrofrio_user', usernameMap[currentUser]);
                }
                const currentName = localStorage.getItem('electrofrio_name');
                if (currentName && nameMap[currentName]) {
                    localStorage.setItem('electrofrio_name', nameMap[currentName]);
                }
                
                localStorage.removeItem('electrofrio_collaborators');
                localStorage.removeItem('electrofrio_fichajes');
                localStorage.removeItem('electrofrio_workorders');
                localStorage.removeItem('electrofrio_worksheets');
                
                if (btn) btn.style.display = 'none';
                alert("¡Migración completada con éxito! Presiona OK y la página se recargará.");
                window.location.reload(true);
                
            } catch (err) {
                console.error(err);
                alert("Error durante la migración: " + err.message);
                const btn = document.getElementById('btn-migrar-nombres');
                if (btn) btn.textContent = 'Error (Reintentar)';
            }
        };
    </script>

    <!-- Desregistro del Service Worker para forzar funcionamiento online -->
    <script>
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.getRegistrations().then(function(registrations) {
                for(let registration of registrations) {
                    registration.unregister();
                }
            });
        }
    </script>
</body>

</html>
