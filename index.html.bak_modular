                        <small style="display: block; color: var(--text-muted, #94a3b8); font-size: 11px; margin-top: 4px;">
                            ℹ Los fichajes registrados o editados desde la computadora se guardan siempre como manuales.
                        </small>
                    </div>
                </div>
                <button type="submit" class="save-btn" style="width: 100%; margin-top: 20px;">
                    Guardar Fichaje
                </button>
            </form>
