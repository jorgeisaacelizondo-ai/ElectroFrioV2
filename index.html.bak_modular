        // Escuchar eventos desde el iframe de planillas (ej. orden completada)
        window.addEventListener('message', (event) => {
            if (event.data && event.data.type === 'FICHAJE_UPDATED') {
                const cached = localStorage.getItem('electrofrio_fichajes');
                if (cached) {
                    try { fichajes = JSON.parse(cached); } catch(e) {}
                }
                if (typeof updateDashboardStats === 'function') updateDashboardStats();
                if (typeof updateTablesAndViews === 'function') updateTablesAndViews();
            }
            if (event.data && event.data.type === 'COLLABORATOR_UPDATED') {
                const cached = localStorage.getItem('electrofrio_collaborators');
                if (cached) {
                    try { colaboradores = JSON.parse(cached); } catch(e) {}
                }
                if (typeof updateDashboardStats === 'function') updateDashboardStats();
                if (typeof updateTablesAndViews === 'function') updateTablesAndViews();
            }
            if (event.data && event.data.type === 'ORDER_UPDATED') {
                const cached = localStorage.getItem('electrofrio_workorders');
                if (cached) {
                    try { ordenesTrabajo = JSON.parse(cached); } catch(e) {}
                }
                if (typeof updateDashboardStats === 'function') updateDashboardStats();
                if (typeof updateTablesAndViews === 'function') updateTablesAndViews();
            }
            if (event.data && event.data.type === 'CLIENT_UPDATED') {
                const cached = localStorage.getItem('electrofrio_clients');
                if (cached) {
                    try { clientes = JSON.parse(cached); } catch(e) {}
                }
                if (typeof updateDashboardStats === 'function') updateDashboardStats();
                if (typeof updateTablesAndViews === 'function') updateTablesAndViews();
            }
            if (event.data && event.data.type === 'OPEN_PLANILLA_FOR_ORDER') {
                const orderId = event.data.orderId;
                if (typeof window.openPlanillaModalForOrder === 'function') {
                    window.openPlanillaModalForOrder(orderId);
                }
            }
            if (event.data && event.data.type === 'ORDER_COMPLETED') {
                const orderId = event.data.orderId;
                if (orderId && Array.isArray(window.ordenesTrabajo)) {
                    const ordIdx = window.ordenesTrabajo.findIndex(o => o.id === orderId);
                    if (ordIdx > -1) {
                        window.ordenesTrabajo[ordIdx].status = 'Completado';
                        localStorage.setItem('electrofrio_workorders', JSON.stringify(window.ordenesTrabajo));
                        if (typeof updateTablesAndViews === 'function') {
                            updateTablesAndViews();
                        }
                    }
                }
            }
        });

