{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "electrofriov2",
      "redirects": [
        {
          "source": "/**",
          "destination": "https://electrofriolr.web.app",
          "type": 301
        }
      ]
    },
    {
      "site": "electrofriolr",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "historial.csv",
        "historial_parsed.json",
        "backups/**",
        "scratch/**",
        "resguardo gigs/**",
        "reverted_backup/**",
        "package.json",
        "package-lock.json",
        "respaldar.ps1"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/historial_parsed.js",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|svg|webp|ico)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=3600" }
          ]
        }
      ],
      "predeploy": [
        "powershell -ExecutionPolicy Bypass -File respaldar.ps1"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
