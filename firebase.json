{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "site": "electrofriov2",
      "public": ".",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/.venv/**",
        "**/*.ps1",
        "**/*.bat",
        "**/*.cmd",
        "**/*.sh",
        "**/*.exe",
        "**/*.py",
        "historial.csv",
        "historial_parsed.json",
        "datos/historial.csv",
        "datos/historial_parsed.json",
        "index.html.bak_modular",
        "docs/**",
        "scripts/**",
        "backups/**",
        "scratch/**",
        "resguardo gigs/**",
        "reverted_backup/**",
        "package.json",
        "package-lock.json",
        "backup_firestore.js",
        "backup_credentials.json",
        "serviceAccountKey.json"
      ],
      "headers": [
        {
          "source": "/sw.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
            { "key": "Service-Worker-Allowed", "value": "/" }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "**/*.@(js|css)",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/datos/historial_parsed.js",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|svg|webp|ico)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=604800, immutable" }
          ]
        }
      ],
      "predeploy": [
        "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/respaldar.ps1"
      ],
      "rewrites": [
        {
          "source": "**",
          "destination": "/index.html"
        }
      ]
    }
  ]
}
